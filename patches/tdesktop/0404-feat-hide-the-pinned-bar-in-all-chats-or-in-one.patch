@@ -0,0 +1,47 @@
+#include "tele/tele_pinned_bar_rules.h"
+
+#include <QtCore/QStringList>
+
+namespace Tele {
+namespace {
+
+const auto kHide = QStringLiteral("hide");
+const auto kShow = QStringLiteral("show");
+
+} // namespace
+
+std::optional<bool> PinnedBarRule(const QString &rules, const QString &key) {
+	for (const auto &part : rules.split(QChar(','), Qt::SkipEmptyParts)) {
+		const auto pair = part.trimmed().split(QChar('='));
+		if (pair.size() != 2 || pair[0].trimmed() != key) {
+			continue;
+		}
+		const auto value = pair[1].trimmed();
+		if (value == kHide) {
+			return true;
+		} else if (value == kShow) {
+			return false;
+		}
+	}
+	return std::nullopt;
+}
+
+QString WithPinnedBarRule(
+		const QString &rules,
+		const QString &key,
+		std::optional<bool> hidden) {
+	auto result = QStringList();
+	for (const auto &part : rules.split(QChar(','), Qt::SkipEmptyParts)) {
+		const auto entry = part.trimmed();
+		const auto pair = entry.split(QChar('='));
+		if (pair.size() == 2 && pair[0].trimmed() != key) {
+			result.push_back(entry);
+		}
+	}
+	if (hidden && !key.isEmpty()) {
+		result.push_back(key + QChar('=') + (*hidden ? kHide : kShow));
+	}
+	return result.join(QChar(','));
+}
+
+} // namespace Tele
