+void TestPinnedBarRules() {
+	using Tele::PinnedBarRule;
+	using Tele::WithPinnedBarRule;
+	const auto a = QStringLiteral("1");
+	const auto b = QStringLiteral("test:2");
+	Require(!PinnedBarRule(QString(), a).has_value(), "empty rules");
+	auto rules = WithPinnedBarRule(QString(), a, true);
+	Require(PinnedBarRule(rules, a) == std::optional<bool>(true), "hide rule");
+	rules = WithPinnedBarRule(rules, b, false);
+	Require(PinnedBarRule(rules, b) == std::optional<bool>(false), "show rule");
+	Require(PinnedBarRule(rules, a) == std::optional<bool>(true), "other rule kept");
+	rules = WithPinnedBarRule(rules, a, std::nullopt);
+	Require(!PinnedBarRule(rules, a).has_value(), "rule removed");
+	Require(rules == QStringLiteral("test:2=show"), "serialized");
+	Require(!PinnedBarRule(QStringLiteral("1=maybe,=hide"), a).has_value(), "broken rules");
+	Require(!PinnedBarRule(rules, QStringLiteral("2")).has_value(), "test key differs");
+}
+
 } // namespace
 
 int main() {
 	TestSinglePaths();
 	TestWavFiles();
+	TestPinnedBarRules();
 	return 0;
 }
