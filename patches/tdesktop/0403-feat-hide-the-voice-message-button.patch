@@ -292,6 +292,7 @@ struct Spec {
 		Toggle(kOptionIndentSelectedLines),
 		Choice(kOptionComposerIndentation, { u"2"_q, u"4"_q, u"tab"_q }),
 		Toggle(kOptionHideGiftButton),
+		Toggle(kOptionHideRecordButton),
 		Toggle(kOptionHideBirthdays),
 		Toggle(kOptionSilentByDefault),
 		Toggle(kOptionSilentPerChat),
