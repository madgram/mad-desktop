From: yar2slav <191513735+yar2slav@users.noreply.github.com>
Date: Thu, 19 Nov 2026 03:11:42 +0200
Subject: [PATCH] feat: hide the voice message button

---
 Telegram/Resources/langs/mad_ru.json             |  4 +++-
 Telegram/SourceFiles/history/history_widget.cpp  |  6 +++++-
 .../controls/history_view_compose_controls.cpp   |  6 +++++-
 Telegram/SourceFiles/settings/settings_tele.cpp  |  4 ++++
 Telegram/SourceFiles/tele/tele_options.cpp       | 16 ++++++++++++++++
 Telegram/SourceFiles/tele/tele_options.h         |  3 +++
 Telegram/SourceFiles/tele/tele_settings_io.cpp   |  1 +
 7 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/Telegram/Resources/langs/mad_ru.json b/Telegram/Resources/langs/mad_ru.json
index a83ea3a1ca959e79e32686fcef28802570907391..e38c4497106b75cd619389c3a3b9d02aeb03ddbb 100644
--- a/Telegram/Resources/langs/mad_ru.json
+++ b/Telegram/Resources/langs/mad_ru.json
@@ -2150,5 +2150,7 @@
   "In groups": "В группах",
   "In channels": "В каналах",
   "WAV files as music": "WAV как музыка",
-  "WAV files are sent and shown as tracks in the player. Files already loaded change after a restart.": "WAV-файлы отправляются и показываются треками в плеере. Уже загруженные файлы поменяются после перезапуска."
+  "WAV files are sent and shown as tracks in the player. Files already loaded change after a restart.": "WAV-файлы отправляются и показываются треками в плеере. Уже загруженные файлы поменяются после перезапуска.",
+  "Hide the voice message button": "Скрыть кнопку голосовых",
+  "The send button stays in its place, voice and video messages can't be recorded from the message field.": "На её месте остаётся кнопка отправки, записать голосовое или кружок из поля ввода не получится."
 }
diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index 723abef74ed4a816c296bed38d5b266d4244009b..add584d185a15cab61f4f60bbe7d2dd11d09e588 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -510,6 +510,9 @@ HistoryWidget::HistoryWidget(
 		updateControlsVisibility();
 		updateControlsGeometry();
 	}, lifetime());
+	Tele::HideRecordButtonChanges() | rpl::on_next([=] {
+		updateSendButtonType();
+	}, lifetime());
 	_reportMessages->addClickHandler([=] { reportSelectedMessages(); });
 	_field->submits(
 	) | rpl::on_next([=](Qt::KeyboardModifiers modifiers) {
@@ -7254,7 +7257,8 @@ bool HistoryWidget::isSearching() const {
 }
 
 bool HistoryWidget::showRecordButton() const {
-	return (_recordAvailability != Webrtc::RecordAvailability::None)
+	return !Tele::HideRecordButton()
+		&& (_recordAvailability != Webrtc::RecordAvailability::None)
 		&& !_voiceRecordBar->isListenState()
 		&& !_voiceRecordBar->isRecordingByAnotherBar()
 		&& !hasSendableContent()
diff --git a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
index cace17cbe2b4d8ca9a20ed4c0300539017e74858..467b460c0da520c9a7363e7d132bc57822640260 100644
--- a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
+++ b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
@@ -3012,6 +3012,9 @@ void ComposeControls::init() {
 	Tele::HideGiftButtonChanges() | rpl::on_next([=] {
 		refreshSendGiftToggle();
 	}, _wrap->lifetime());
+	Tele::HideRecordButtonChanges() | rpl::on_next([=] {
+		updateSendButtonType();
+	}, _wrap->lifetime());
 
 	_hidden.changes(
 	) | rpl::on_next([=] {
@@ -3212,7 +3215,8 @@ void ComposeControls::orderControls() {
 }
 
 bool ComposeControls::showRecordButton() const {
-	return _features.recordMediaMessage
+	return !Tele::HideRecordButton()
+		&& _features.recordMediaMessage
 		&& (_recordAvailability != Webrtc::RecordAvailability::None)
 		&& !_voiceRecordBar->isListenState()
 		&& !_voiceRecordBar->isRecordingByAnotherBar()
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 01dbee7961d2c660ecf64f6d50d9fcef2264f295..b75f17163285ee60f29fbe72d63c460813b1a6a7 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -3456,6 +3456,10 @@ void FillSending(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionHideGiftButton,
 		{ u"gift"_q, u"premium"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionHideRecordButton,
+		{ u"voice"_q, u"microphone"_q, u"record"_q, u"round"_q });
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionVoiceNoFade,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index e3b3abaad0e46089b4156bb4bc0be1fe7b433bdc..87ed3a07615851fc9d79ecc2a03ca70ff4445431 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -205,6 +205,7 @@ const char kOptionKeepIndentation[] = "tele-keep-indentation";
 const char kOptionIndentSelectedLines[] = "tele-indent-selected-lines";
 const char kOptionComposerIndentation[] = "tele-composer-indentation";
 const char kOptionHideGiftButton[] = "tele-hide-gift-button";
+const char kOptionHideRecordButton[] = "tele-hide-record-button";
 const char kOptionHideBirthdays[] = "tele-hide-birthdays";
 const char kOptionSilentByDefault[] = "tele-silent-by-default";
 const char kOptionSilentPerChat[] = "tele-silent-per-chat";
@@ -1498,6 +1499,13 @@ base::options::toggle HideGiftButtonOption({
 	.name = "Hide the gift button in the message field",
 });
 
+base::options::toggle HideRecordButtonOption({
+	.id = kOptionHideRecordButton,
+	.name = "Hide the voice message button",
+	.description = "The send button stays in its place, voice and video "
+		"messages can't be recorded from the message field.",
+});
+
 base::options::toggle HideBirthdaysOption({
 	.id = kOptionHideBirthdays,
 	.name = "Hide birthday banners and effects",
@@ -3616,6 +3624,14 @@ rpl::producer<> HideGiftButtonChanges() {
 	return HideGiftButtonOption.changes();
 }
 
+bool HideRecordButton() {
+	return HideRecordButtonOption.value();
+}
+
+rpl::producer<> HideRecordButtonChanges() {
+	return HideRecordButtonOption.changes();
+}
+
 bool HideBirthdays() {
 	return HideBirthdaysOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 35e11e86d2ec8268d4107d93e5b6af63cfeea54f..bf230c7780150dc9e6c2dae8a206709753abddce 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -200,6 +200,7 @@ extern const char kOptionKeepIndentation[];
 extern const char kOptionIndentSelectedLines[];
 extern const char kOptionComposerIndentation[];
 extern const char kOptionHideGiftButton[];
+extern const char kOptionHideRecordButton[];
 extern const char kOptionHideBirthdays[];
 extern const char kOptionSilentByDefault[];
 extern const char kOptionSilentPerChat[];
@@ -587,6 +588,8 @@ void SetComposerIndentation(const QString &value);
 [[nodiscard]] rpl::producer<QString> ComposerIndentationValue();
 [[nodiscard]] bool HideGiftButton();
 [[nodiscard]] rpl::producer<> HideGiftButtonChanges();
+[[nodiscard]] bool HideRecordButton();
+[[nodiscard]] rpl::producer<> HideRecordButtonChanges();
 [[nodiscard]] bool HideBirthdays();
 [[nodiscard]] rpl::producer<> HideBirthdaysChanges();
 [[nodiscard]] bool SilentByDefault();
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index 5cce48a85dee6614da3e80bd072577002c1f5d17..0131b9348b4b3b08f9e193715e0d69bc3d362c13 100644
