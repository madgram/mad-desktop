diff --git a/Telegram/SourceFiles/tele/tele_crossfade.cpp b/Telegram/SourceFiles/tele/tele_crossfade.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..903e5bc6ea4db12f3c94e762054deb1522fe63ef
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_crossfade.cpp
@@ -0,0 +1,50 @@
+#include "tele/tele_crossfade.h"
+
+#include "ui/effects/animations.h"
+#include "ui/rp_widget.h"
+#include "ui/ui_utility.h"
+
+#include <QtGui/QPainter>
+
+namespace Tele {
+namespace {
+
+constexpr auto kDuration = crl::time(220);
+
+} // namespace
+
+void StartCrossfade(not_null<QWidget*> widget) {
+	const auto parent = widget->parentWidget();
+	if (!parent || widget->isHidden() || widget->size().isEmpty()) {
+		return;
+	}
+	auto cache = Ui::GrabWidget(widget);
+	if (cache.isNull()) {
+		return;
+	}
+	const auto overlay = Ui::CreateChild<Ui::RpWidget>(parent);
+	overlay->setAttribute(Qt::WA_TransparentForMouseEvents);
+	overlay->setGeometry(widget->geometry());
+	struct State {
+		QPixmap cache;
+		Ui::Animations::Simple animation;
+	};
+	const auto state = overlay->lifetime().make_state<State>();
+	state->cache = std::move(cache);
+	overlay->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(overlay);
+		p.setOpacity(state->animation.value(0.));
+		p.drawPixmap(0, 0, state->cache);
+	}, overlay->lifetime());
+	state->animation.start([=] {
+		overlay->update();
+		if (!state->animation.animating()) {
+			overlay->hide();
+			overlay->deleteLater();
+		}
+	}, 1., 0., kDuration, anim::easeOutCubic);
+	overlay->show();
+	overlay->raise();
+}
+
+} // namespace Tele
