diff --git a/Telegram/SourceFiles/tele/tele_foreign_agent.cpp b/Telegram/SourceFiles/tele/tele_foreign_agent.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0a9cdfe114c5c9cdab0a42c83cd39593a7cb574d
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_foreign_agent.cpp
@@ -0,0 +1,65 @@
+#include "tele/tele_foreign_agent.h"
+
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "tele/tele_foreign_agent_ranges.h"
+#include "tele/tele_ignored.h"
+#include "tele/tele_options.h"
+#include "tele/tele_spoilers.h"
+#include "ui/text/text_utilities.h"
+
+namespace Tele {
+namespace {
+
+struct State {
+	State();
+
+	rpl::lifetime lifetime;
+};
+
+State::State() {
+	HideForeignAgentChanges() | rpl::on_next([] {
+		auto items = base::flat_set<not_null<HistoryItem*>>();
+		EnumerateViews([&](not_null<HistoryView::Element*> view) {
+			items.emplace(view->data());
+		});
+		for (const auto item : items) {
+			item->history()->owner().requestItemTextRefresh(item);
+		}
+		InvalidateAllPreviews();
+	}, lifetime);
+}
+
+void EnsureState() {
+	static State state;
+}
+
+} // namespace
+
+TextWithEntities WithoutForeignAgentLabel(TextWithEntities text) {
+	EnsureState();
+	if (!HideForeignAgent()) {
+		return text;
+	}
+	const auto ranges = ForeignAgentRanges(text.text);
+	if (ranges.empty()
+		|| WithoutRanges(text.text, ranges).trimmed().isEmpty()) {
+		return text;
+	}
+	auto result = TextWithEntities();
+	auto from = 0;
+	for (const auto &range : ranges) {
+		if (range.from > from) {
+			result.append(Ui::Text::Mid(text, from, range.from - from));
+		}
+		from = range.till;
+	}
+	if (from < text.text.size()) {
+		result.append(Ui::Text::Mid(text, from));
+	}
+	return result;
+}
+
+} // namespace Tele
