+[[nodiscard]] QString Stripped(const QString &text) {
+	return Tele::WithoutRanges(text, Tele::ForeignAgentRanges(text));
+}
+
+void TestForeignAgent() {
+	Require(Stripped(QString::fromUtf8("НАСТОЯЩИЙ МАТЕРИАЛ (ИНФОРМАЦИЯ) ПРОИЗВЕДЕН И (ИЛИ) РАСПРОСТРАНЕН ИНОСТРАННЫМ АГЕНТОМ ИВАНОВЫМ ИВАНОМ ЛИБО КАСАЕТСЯ ДЕЯТЕЛЬНОСТИ ИНОСТРАННОГО АГЕНТА ИВАНОВА ИВАНА. 18+\n\nНовости дня"))
+		== QString::fromUtf8("Новости дня"), "foreign agent disclaimer");
+	Require(Stripped(QString::fromUtf8("Пост про что-то\n* номер в списке Минюста 777"))
+		== QString::fromUtf8("Пост про что-то"), "ministry footnote");
+	Require(Stripped(QString::fromUtf8("ДАННОЕ СООБЩЕНИЕ (МАТЕРИАЛ) СОЗДАНО И (ИЛИ) РАСПРОСТРАНЕНО ИНОСТРАННЫМ СРЕДСТВОМ МАССОВОЙ ИНФОРМАЦИИ.\nжир"))
+		== QString::fromUtf8("жир"), "foreign media disclaimer");
+	Require(Stripped(QString::fromUtf8("Настоящий материал произведён иностранным агентом. Текст"))
+		== QString::fromUtf8("Текст"), "lowercase and yo");
+	Require(Tele::ForeignAgentRanges(QString::fromUtf8("обычный текст про агентов")).empty(), "plain text");
+	Require(Stripped(QStringLiteral("18+")).trimmed().isEmpty(), "only the age mark");
+}
