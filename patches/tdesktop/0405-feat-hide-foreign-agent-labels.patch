diff --git a/Telegram/SourceFiles/tele/tele_foreign_agent_ranges.cpp b/Telegram/SourceFiles/tele/tele_foreign_agent_ranges.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a6861d18b9de2832f35a51bacef77f54a7d44acd
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_foreign_agent_ranges.cpp
@@ -0,0 +1,113 @@
+#include "tele/tele_foreign_agent_ranges.h"
+
+#include <QtCore/QRegularExpression>
+
+#include <algorithm>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] const std::vector<QRegularExpression> &Expressions() {
+	static const auto result = [] {
+		const auto options = QRegularExpression::CaseInsensitiveOption
+			| QRegularExpression::MultilineOption
+			| QRegularExpression::UseUnicodePropertiesOption;
+		static const char *const patterns[] = {
+			R"re((?:НАСТОЯЩИЙ|ДАННЫЙ)\s+МАТЕРИАЛ[\s\S]{0,80}?ПРОИЗВЕД[ЕЁ]Н[\s\S]{0,600}?ИНОСТРАНН\w*\s+(?:АГЕНТ|СРЕДСТВ)\w*[^.\n]*(?:\.|$)(?:\s*18\s*\+)?)re",
+			R"re((?:ДАННОЕ|НАСТОЯЩЕЕ)\s+СООБЩЕНИЕ[\s\S]{0,80}?(?:СОЗДАНО|РАСПРОСТРАНЕНО)[\s\S]{0,600}?ИНОСТРАНН\w*\s+(?:АГЕНТ|СРЕДСТВ)\w*[^.\n]*(?:\.|$)(?:\s*18\s*\+)?)re",
+			R"re(^[ \t]*\*+[^\n]*(?:Минюст|иноагент|иностранн\w*\s+агент|экстремист|террорист|нежелательн)[^\n]*$)re",
+			R"re(^[ \t]*18\s*\+[ \t]*$)re",
+		};
+		auto list = std::vector<QRegularExpression>();
+		for (const auto pattern : patterns) {
+			list.emplace_back(QString::fromUtf8(pattern), options);
+		}
+		return list;
+	}();
+	return result;
+}
+
+[[nodiscard]] bool IsSpace(QChar ch) {
+	const auto code = ch.unicode();
+	return (code == 0x20)
+		|| (code == 0x0a)
+		|| (code == 0x09)
+		|| (code == 0x0d)
+		|| (code == 0xa0);
+}
+
+[[nodiscard]] bool MayContain(const QString &text) {
+	return text.contains(QStringLiteral("18"))
+		|| text.contains(QChar('*'))
+		|| text.contains(QStringLiteral("агент"), Qt::CaseInsensitive)
+		|| text.contains(QStringLiteral("средств"), Qt::CaseInsensitive);
+}
+
+[[nodiscard]] std::vector<TextRange> Merged(std::vector<TextRange> list) {
+	std::sort(begin(list), end(list), [](TextRange a, TextRange b) {
+		return a.from < b.from;
+	});
+	auto result = std::vector<TextRange>();
+	for (const auto &range : list) {
+		if (!result.empty() && range.from <= result.back().till) {
+			result.back().till = std::max(result.back().till, range.till);
+		} else {
+			result.push_back(range);
+		}
+	}
+	return result;
+}
+
+} // namespace
+
+std::vector<TextRange> ForeignAgentRanges(const QString &text) {
+	if (!MayContain(text)) {
+		return {};
+	}
+	auto found = std::vector<TextRange>();
+	for (const auto &expression : Expressions()) {
+		auto i = expression.globalMatch(text);
+		while (i.hasNext()) {
+			const auto match = i.next();
+			if (match.capturedLength() > 0) {
+				found.push_back({
+					int(match.capturedStart()),
+					int(match.capturedEnd()),
+				});
+			}
+		}
+	}
+	if (found.empty()) {
+		return {};
+	}
+	const auto size = int(text.size());
+	auto expanded = std::vector<TextRange>();
+	for (auto range : Merged(std::move(found))) {
+		while (range.till < size && IsSpace(text[range.till])) {
+			++range.till;
+		}
+		if (range.till == size) {
+			while (range.from > 0 && IsSpace(text[range.from - 1])) {
+				--range.from;
+			}
+		}
+		expanded.push_back(range);
+	}
+	return Merged(std::move(expanded));
+}
+
+QString WithoutRanges(
+		const QString &text,
+		const std::vector<TextRange> &ranges) {
+	auto result = QString();
+	result.reserve(text.size());
+	auto from = 0;
+	for (const auto &range : ranges) {
+		result.append(text.mid(from, range.from - from));
+		from = range.till;
+	}
+	result.append(text.mid(from));
+	return result;
+}
+
+} // namespace Tele
