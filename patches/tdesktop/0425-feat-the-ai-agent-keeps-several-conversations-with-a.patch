+[[nodiscard]] QString NewConversationId() {
+	return QUuid::createUuid().toString(QUuid::Id128).left(16);
+}
+
+[[nodiscard]] bool GoodConversationId(const QString &id) {
+	if (id.isEmpty() || id.size() > 32) {
+		return false;
+	}
+	for (const auto ch : id) {
+		if (!ch.isLetterOrNumber() || ch.unicode() > 127) {
+			return false;
+		}
+	}
+	return true;
+}
