+QString Runner::currentConversation() const {
+	return _store->currentConversation();
+}
+
+bool Runner::startConversation() {
+	if (_running) {
+		return false;
+	}
+	_store->startConversation();
+	_messages = _store->messages();
+	_lastError = QString();
+	notify();
+	return true;
+}
+
+bool Runner::switchConversation(const QString &id) {
+	if (_running) {
+		return false;
+	}
+	_store->switchConversation(id);
+	_messages = _store->messages();
+	RepairDanglingToolCalls(_messages, Cancelled());
+	_lastError = QString();
+	notify();
+	return true;
+}
+
+bool Runner::removeConversation(const QString &id) {
+	if (_running && (id == _store->currentConversation())) {
+		return false;
+	}
+	_store->removeConversation(id);
+	_messages = _store->messages();
+	RepairDanglingToolCalls(_messages, Cancelled());
+	_lastError = QString();
+	notify();
+	return true;
+}
