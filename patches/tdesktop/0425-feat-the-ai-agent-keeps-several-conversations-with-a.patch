+void ShowHistoryBox(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Tr(u"Chat history"_q)));
+		box->setWidth(st::boxWideWidth);
+		const auto list = box->addRow(
+			object_ptr<Ui::VerticalLayout>(box),
+			QMargins());
+		const auto rebuild = [=] {
+			list->clear();
+			const auto &runner = Runner::For(session);
+			const auto current = runner.currentConversation();
+			const auto &conversations = runner.conversations();
+			if (conversations.empty()) {
+				list->add(
+					object_ptr<Ui::FlatLabel>(
+						list,
+						Tr(u"No saved chats yet"_q),
+						st::boxDividerLabel),
+					st::boxRowPadding + QMargins(
+						0,
+						st::boxLittleSkip,
+						0,
+						st::boxLittleSkip));
+			}
+			for (const auto &conversation : conversations) {
+				const auto id = conversation.id;
+				const auto row = list->add(object_ptr<HistoryRow>(
+					list,
+					conversation,
+					(id == current)));
+				row->setClickedCallback([=] {
+					if (Runner::For(session).switchConversation(id)) {
+						box->closeBox();
+					} else {
+						controller->showToast(
+							Tr(u"Wait until the agent answers."_q));
+					}
+				});
+				row->removeRequests() | rpl::on_next([=] {
+					controller->show(Ui::MakeConfirmBox({
+						.text = Tr(u"Delete this chat with the agent?"_q),
+						.confirmed = [=](Fn<void()> close) {
+							if (!Runner::For(session).removeConversation(id)) {
+								controller->showToast(
+									Tr(u"Wait until the agent answers."_q));
+							}
+							close();
+						},
+						.confirmText = Tr(u"Delete"_q),
+						.confirmStyle = &st::attentionBoxButton,
+					}));
+				}, row->lifetime());
+			}
+			list->resizeToWidth(st::boxWideWidth);
+		};
+		rebuild();
+		Runner::For(
+			session
+		).store().conversationsChanges() | rpl::on_next([=] {
+			crl::on_main(box, rebuild);
+		}, box->lifetime());
+		box->addButton(rpl::single(Tr(u"Close"_q)), [=] {
+			box->closeBox();
+		});
+		box->addLeftButton(rpl::single(Tr(u"New chat"_q)), [=] {
+			StartNewChat(controller);
+			box->closeBox();
+		});
+	}));
+}
