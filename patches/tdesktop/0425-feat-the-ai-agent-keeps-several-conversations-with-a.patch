+QString ConversationTitle(const std::vector<Message> &messages) {
+	constexpr auto kTitleLimit = 60;
+	for (const auto &message : messages) {
+		if (message.role != Role::User) {
+			continue;
+		}
+		const auto text = message.text.simplified();
+		if (text.isEmpty()) {
+			continue;
+		}
+		return (text.size() > kTitleLimit)
+			? (text.left(kTitleLimit).trimmed() + QChar(0x2026))
+			: text;
+	}
+	return QString();
+}
