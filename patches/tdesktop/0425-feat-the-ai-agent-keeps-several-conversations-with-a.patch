+const std::vector<Conversation> &Store::conversations() const {
+	return _conversations;
+}
+
+QString Store::currentConversation() const {
+	return _current;
+}
+
+void Store::startConversation() {
+	if (_messages.empty() && !_current.isEmpty()) {
+		return;
+	}
+	_current = NewConversationId();
+	_messages.clear();
+	write();
+	_conversationsChanges.fire({});
+}
+
+void Store::switchConversation(const QString &id) {
+	if (id == _current || !GoodConversationId(id)) {
+		return;
+	}
+	_current = id;
+	_messages.clear();
+	readConversation();
+	write();
+	_conversationsChanges.fire({});
+}
+
+void Store::removeConversation(const QString &id) {
+	const auto i = ranges::find(_conversations, id, &Conversation::id);
+	if (i != end(_conversations)) {
+		_conversations.erase(i);
+	}
+	deleteConversationFile(id);
+	if (id == _current) {
+		_messages.clear();
+		if (!_conversations.empty()) {
+			_current = _conversations.front().id;
+			readConversation();
+		} else {
+			_current = NewConversationId();
+		}
+	}
+	write();
+	_conversationsChanges.fire({});
+}
+
+rpl::producer<> Store::conversationsChanges() const {
+	return _conversationsChanges.events();
+}
+
+void Store::updateIndex() {
+	const auto i = ranges::find(_conversations, _current, &Conversation::id);
+	if (_messages.empty()) {
+		if (i != end(_conversations)) {
+			_conversations.erase(i);
+		}
+		deleteConversationFile(_current);
+		return;
+	}
+	auto title = ConversationTitle(_messages);
+	const auto updated = TimeId(_messages.back().date);
+	if (i != end(_conversations)) {
+		i->title = std::move(title);
+		i->updated = updated;
+	} else {
+		_conversations.push_back({
+			.id = _current,
+			.title = std::move(title),
+			.updated = updated,
+		});
+	}
+	ranges::stable_sort(
+		_conversations,
+		std::greater<>(),
+		&Conversation::updated);
+	if (int(_conversations.size()) > kMaxConversations) {
+		for (auto j = kMaxConversations; j != int(_conversations.size()); ++j) {
+			deleteConversationFile(_conversations[j].id);
+		}
+		_conversations.resize(kMaxConversations);
+	}
+}
