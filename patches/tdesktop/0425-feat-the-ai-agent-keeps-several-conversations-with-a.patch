+void HistoryRow::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), isOver() ? st::windowBgOver : st::windowBg);
+	paintRipple(p, 0, 0);
+	const auto left = st::boxRowPadding.left();
+	const auto check = CardScaled(18);
+	const auto right = width()
+		- CardScaled(12)
+		- _remove->width()
+		- (_current ? (check + CardScaled(8)) : 0);
+	const auto available = std::max(right - left - CardScaled(8), 0);
+	const auto titleFont = CardFont(15, false);
+	const auto dateFont = CardFont(13, false);
+	const auto skip = CardScaled(3);
+	const auto top = (height() - titleFont->height - skip - dateFont->height)
+		/ 2;
+	const auto title = _conversation.title.isEmpty()
+		? Tr(u"Untitled"_q)
+		: _conversation.title;
+	p.setFont(titleFont);
+	p.setPen(st::windowBoldFg);
+	p.drawText(left, top + titleFont->ascent, titleFont->elided(title, available));
+	p.setFont(dateFont);
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		left,
+		top + titleFont->height + skip + dateFont->ascent,
+		_conversation.updated
+			? Ui::FormatDialogsDate(base::unixtime::parse(_conversation.updated))
+			: QString());
+	if (_current) {
+		auto hq = PainterHighQualityEnabler(p);
+		const auto x = right + CardScaled(4);
+		const auto y = (height() - check) / 2.;
+		auto pen = QPen(st::windowActiveTextFg);
+		pen.setWidthF(CardScaled(2) * 1.);
+		pen.setCapStyle(Qt::RoundCap);
+		pen.setJoinStyle(Qt::RoundJoin);
+		p.setPen(pen);
+		p.setBrush(Qt::NoBrush);
+		auto path = QPainterPath();
+		path.moveTo(x + check * 0.15, y + check * 0.52);
+		path.lineTo(x + check * 0.4, y + check * 0.76);
+		path.lineTo(x + check * 0.88, y + check * 0.26);
+		p.drawPath(path);
+	}
+}
