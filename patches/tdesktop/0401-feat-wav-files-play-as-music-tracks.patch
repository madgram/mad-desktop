 #include <cstdio>
 #include <cstdlib>
@@ -23,9 +24,21 @@ void TestSinglePaths() {
 	Require(SingleFileProfileCandidate(QStringLiteral("C:/x/mad-single/other/abc/")).isEmpty(), "other folder");
 }
 
+void TestWavFiles() {
+	using Tele::IsWavFile;
+	Require(IsWavFile(QStringLiteral("audio/x-wav"), QString()), "wav mime");
+	Require(IsWavFile(QStringLiteral("Audio/WAV"), QString()), "wav mime case");
+	Require(IsWavFile(QStringLiteral("application/octet-stream"), QStringLiteral("take 1.WAV")), "wav extension");
+	Require(IsWavFile(QString(), QStringLiteral("loop.wave")), "wave extension");
+	Require(!IsWavFile(QStringLiteral("audio/mpeg"), QStringLiteral("song.mp3")), "mp3");
+	Require(!IsWavFile(QStringLiteral("application/zip"), QStringLiteral("wav.zip")), "zip named wav");
+	Require(!IsWavFile(QString(), QString()), "empty");
+}
+
 } // namespace
 
 int main() {
 	TestSinglePaths();
+	TestWavFiles();
 	return 0;
 }
