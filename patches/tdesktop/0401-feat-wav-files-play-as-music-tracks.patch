new file mode 100644
index 0000000000000000000000000000000000000000..6d704dec8dfb9cfd821b0d8881085bf2458442ca
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_wav_music.cpp
@@ -0,0 +1,22 @@
+#include "tele/tele_wav_music.h"
+
+#include <QtCore/QStringList>
+
+namespace Tele {
+
+bool IsWavFile(const QString &mime, const QString &name) {
+	static const auto mimes = QStringList{
+		QStringLiteral("audio/wav"),
+		QStringLiteral("audio/x-wav"),
+		QStringLiteral("audio/wave"),
+		QStringLiteral("audio/vnd.wave"),
+	};
+	if (mimes.contains(mime.trimmed(), Qt::CaseInsensitive)) {
+		return true;
+	}
+	const auto trimmed = name.trimmed();
+	return trimmed.endsWith(QStringLiteral(".wav"), Qt::CaseInsensitive)
+		|| trimmed.endsWith(QStringLiteral(".wave"), Qt::CaseInsensitive);
+}
+
+} // namespace Tele
