+QImage MacDockLogo(const QImage &image) {
+	constexpr auto kCanvas = 1024;
+	constexpr auto kContent = 824;
+	auto result = QImage(
+		QSize(kCanvas, kCanvas),
+		QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	auto p = QPainter(&result);
+	p.setRenderHint(QPainter::SmoothPixmapTransform);
+	const auto skip = (kCanvas - kContent) / 2;
+	p.drawImage(QRect(skip, skip, kContent, kContent), image);
+	p.end();
+	return result;
