diff --git a/Telegram/SourceFiles/tele/tele_jump_plan.cpp b/Telegram/SourceFiles/tele/tele_jump_plan.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c882eca54afc1d66e4a87f1fed00b0b00d82bca2
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_jump_plan.cpp
@@ -0,0 +1,27 @@
+#include "tele/tele_jump_plan.h"
+
+#include <algorithm>
+#include <cstdlib>
+
+namespace Tele {
+namespace {
+
+constexpr auto kScreens = 3;
+constexpr auto kShortest = 260;
+constexpr auto kExtra = 300;
+
+} // namespace
+
+JumpPlan PlanJump(int distance, int viewport, bool smooth) {
+	if (!smooth || viewport <= 0) {
+		return { viewport, 0 };
+	}
+	const auto limit = viewport * kScreens;
+	const auto animated = std::min(std::abs(distance), limit);
+	return {
+		limit,
+		kShortest + int((long long)(animated) * kExtra / limit),
+	};
+}
+
+} // namespace Tele
