+void TestJumpPlan() {
+	using Tele::PlanJump;
+	const auto off = PlanJump(5000, 600, false);
+	Require(off.limit == 600 && off.duration == 0, "stock jump");
+	const auto near = PlanJump(-300, 600, true);
+	Require(near.limit == 1800 && near.duration == 310, "near jump");
+	const auto far = PlanJump(100000, 600, true);
+	Require(far.limit == 1800 && far.duration == 560, "far jump");
+	Require(PlanJump(100, 0, true).duration == 0, "no viewport");
+}
