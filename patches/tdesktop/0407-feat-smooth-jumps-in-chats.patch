+++ b/Telegram/SourceFiles/tele/tele_jump_plan.h
@@ -0,0 +1,12 @@
+#pragma once
+
+namespace Tele {
+
+struct JumpPlan {
+	int limit = 0;
+	int duration = 0;
+};
+
+[[nodiscard]] JumpPlan PlanJump(int distance, int viewport, bool smooth);
+
+} // namespace Tele
