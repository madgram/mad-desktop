 [[nodiscard]] bool ChatCrossfade();
+[[nodiscard]] bool ViewerAnimations();
 [[nodiscard]] rpl::producer<> ReduceMotionChanges();
 [[nodiscard]] QString ReduceMotionSaved();
 void SetReduceMotionSaved(const QString &value);
