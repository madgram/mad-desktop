index 0000000000000000000000000000000000000000..4de23af1dd081a07a1bed9183bb9fb37f88d0930
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tests/mad_logic_tests.cpp
@@ -0,0 +1,31 @@
+#include "tele/tele_single_paths.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+
+void Require(bool ok, const char *name) {
+	if (!ok) {
+		std::fprintf(stderr, "failed: %s\n", name);
+		std::exit(1);
+	}
+}
+
+void TestSinglePaths() {
+	using Tele::SingleFileProfileCandidate;
+	Require(SingleFileProfileCandidate(QStringLiteral("C:/Users/u/AppData/Local/mad-single/app/abc123/"))
+		== QStringLiteral("C:/Users/u/AppData/Local/mad-single/profile/"), "single build dir");
+	Require(SingleFileProfileCandidate(QStringLiteral("C:\\Users\\u\\AppData\\Local\\MAD-SINGLE\\App\\abc123"))
+		== QStringLiteral("C:/Users/u/AppData/Local/MAD-SINGLE/profile/"), "native separators and case");
+	Require(SingleFileProfileCandidate(QStringLiteral("C:/Users/u/AppData/Local/Programs/mad/")).isEmpty(), "installed exe");
+	Require(SingleFileProfileCandidate(QStringLiteral("C:/mad-single/app/")).isEmpty(), "no build folder");
+	Require(SingleFileProfileCandidate(QStringLiteral("C:/x/mad-single/other/abc/")).isEmpty(), "other folder");
+}
+
+} // namespace
+
+int main() {
+	TestSinglePaths();
+	return 0;
+}
