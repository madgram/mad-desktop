--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_single_paths.cpp
@@ -0,0 +1,38 @@
+#include "tele/tele_single_paths.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QStringList>
+
+namespace Tele {
+
+QString SingleFileProfileCandidate(const QString &exeDir) {
+	auto path = QDir::fromNativeSeparators(exeDir);
+	while (path.endsWith(QChar('/'))) {
+		path.chop(1);
+	}
+	const auto parts = path.split(QChar('/'));
+	if (parts.size() < 4) {
+		return QString();
+	}
+	const auto &app = parts[parts.size() - 2];
+	const auto &single = parts[parts.size() - 3];
+	if (parts.back().isEmpty()
+		|| app.compare(QStringLiteral("app"), Qt::CaseInsensitive) != 0
+		|| single.compare(QStringLiteral("mad-single"), Qt::CaseInsensitive) != 0) {
+		return QString();
+	}
+	return parts.mid(0, parts.size() - 2).join(QChar('/'))
+		+ QStringLiteral("/profile/");
+}
+
+QString SingleFileWorkdir(const QString &exeDir) {
+	const auto candidate = SingleFileProfileCandidate(exeDir);
+	if (candidate.isEmpty()
+		|| !QDir(candidate).exists()
+		|| QDir(exeDir).exists(QStringLiteral("tdata"))) {
+		return QString();
+	}
+	return candidate;
+}
+
+} // namespace Tele
