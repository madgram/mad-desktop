From: yar2slav <191513735+yar2slav@users.noreply.github.com>
Date: Thu, 19 Nov 2026 02:53:52 +0200
Subject: [PATCH] fix: hidden messages leave no gaps, stray dates or unread
 bars

---
 Telegram/SourceFiles/history/history.cpp      |  4 ++-
 .../history/history_inner_widget.cpp          |  3 +-
 .../history/view/history_view_element.cpp     |  3 +-
 .../history/view/history_view_list_widget.cpp | 33 ++++++++++++++-----
 .../view/history_view_service_message.cpp     |  3 ++
 .../SourceFiles/tele/tele_communities.cpp     |  1 +
 .../SourceFiles/tele/tele_hidden_words.cpp    |  5 +++
 Telegram/SourceFiles/tele/tele_ignored.cpp    |  5 +++
 8 files changed, 46 insertions(+), 11 deletions(-)

diff --git a/Telegram/SourceFiles/history/history.cpp b/Telegram/SourceFiles/history/history.cpp
index efe21ec7e9f77a9f86ba502a0997025d1b6003df..3ddf7d29748f83541d2244ab9b74602b5a9e7c1a 100644
--- a/Telegram/SourceFiles/history/history.cpp
+++ b/Telegram/SourceFiles/history/history.cpp
@@ -2171,7 +2171,9 @@ void History::calculateFirstUnreadMessage() {
 				continue;
 			} else if (!item->out()) {
 				if (item->id >= *_inboxReadBefore) {
-					_firstUnreadView = message.get();
+					if (!message->isHidden()) {
+						_firstUnreadView = message.get();
+					}
 				} else {
 					return;
 				}
diff --git a/Telegram/SourceFiles/history/history_inner_widget.cpp b/Telegram/SourceFiles/history/history_inner_widget.cpp
index d9d1ed29ad031c4f6706ebdee827c460c806b347..540dd53be7e25c3e008a58c829b1c57050e6652a 100644
--- a/Telegram/SourceFiles/history/history_inner_widget.cpp
+++ b/Telegram/SourceFiles/history/history_inner_widget.cpp
@@ -5172,7 +5172,8 @@ void HistoryInner::setupThanosEffect() {
 					&& item->history() != migrated()) {
 					return nullptr;
 				}
-				return item->mainView();
+				const auto view = item->mainView();
+				return (view && !view->isHidden()) ? view : nullptr;
 			},
 			.itemTop = [=](not_null<const HistoryView::Element*> view) {
 				return itemTop(view);
diff --git a/Telegram/SourceFiles/history/view/history_view_element.cpp b/Telegram/SourceFiles/history/view/history_view_element.cpp
index b04a62bb745089e3fb0f98a3fc08cee8da6170c8..bcee6297580c0d8e1c59bb67b812fd44ad220acf 100644
--- a/Telegram/SourceFiles/history/view/history_view_element.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_element.cpp
@@ -2633,7 +2633,7 @@ bool Element::isInOneBunchWithPrevious() const {
 void Element::recountAttachToPreviousInBlocks() {
 	if (isHidden() || data()->isEmpty()) {
 		if (const auto next = nextDisplayedInBlocks()) {
-			next->recountAttachToPreviousInBlocks();
+			next->previousInBlocksChanged();
 		} else if (const auto previous = previousDisplayedInBlocks()) {
 			previous->setAttachToNext(false);
 		}
@@ -2800,6 +2800,7 @@ void Element::refreshIfHiddenChanged() const {
 		Pending.remove(id);
 		if (const auto item = session->data().message(id)) {
 			session->data().requestItemViewRefresh(item);
+			session->data().sendHistoryChangeNotifications();
 		}
 	});
 }
diff --git a/Telegram/SourceFiles/history/view/history_view_list_widget.cpp b/Telegram/SourceFiles/history/view/history_view_list_widget.cpp
index 86c3b6aaf15727a7fea336ec9a3612449db232cf..2447782916350cdffd939048c699b1f9d0cde99e 100644
--- a/Telegram/SourceFiles/history/view/history_view_list_widget.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_list_widget.cpp
@@ -6174,7 +6174,7 @@ void ListWidget::setupThanosEffect() {
 			.viewForItem = [=](not_null<const HistoryItem*> item)
 					-> HistoryView::Element* {
 				const auto i = _views.find(item);
-				return (i != end(_views))
+				return (i != end(_views) && !i->second->isHidden())
 					? i->second.get()
 					: nullptr;
 			},
@@ -6246,11 +6246,9 @@ void ListWidget::refreshAttachmentsAtIndex(int index) {
 	Expects(index >= 0 && index < _items.size());
 
 	const auto from = [&] {
-		if (index > 0) {
-			for (auto i = index - 1; i != 0; --i) {
-				if (!_items[i]->isHidden()) {
-					return i;
-				}
+		for (auto i = index; i != 0;) {
+			if (!_items[--i]->isHidden()) {
+				return i;
 			}
 		}
 		return index;
@@ -6287,13 +6285,29 @@ void ListWidget::refreshAttachmentsFromTill(int from, int till) {
 		}
 		return nullptr;
 	};
-	auto view = _items[from].get();
-	view->refreshForumThreadBar(previousShown(), showBars);
+	auto view = (Element*)nullptr;
+	if (_items[from]->isHidden()) {
+		_items[from]->refreshForumThreadBar(nullptr, showBars);
+		_items[from]->setDisplayDate(false);
+		_items[from]->setAttachToPrevious(false);
+		_items[from]->setAttachToNext(false);
+		view = previousShown();
+	} else {
+		view = _items[from].get();
+		view->refreshForumThreadBar(previousShown(), showBars);
+	}
 	for (auto i = from + 1; i != till; ++i) {
 		const auto next = _items[i].get();
 		if (next->isHidden()) {
 			next->refreshForumThreadBar(nullptr, showBars);
 			next->setDisplayDate(false);
+			next->setAttachToPrevious(false);
+			next->setAttachToNext(false);
+		} else if (!view) {
+			next->refreshForumThreadBar(nullptr, showBars);
+			next->setDisplayDate(!hidesDates);
+			next->setAttachToPrevious(false);
+			view = next;
 		} else {
 			next->refreshForumThreadBar(view, showBars);
 			const auto viewDate = view->dateTime();
@@ -6309,6 +6323,9 @@ void ListWidget::refreshAttachmentsFromTill(int from, int till) {
 	}
 	if (till == int(_items.size())) {
 		_items.back()->setAttachToNext(false);
+		if (view) {
+			view->setAttachToNext(false);
+		}
 	}
 }
 
diff --git a/Telegram/SourceFiles/history/view/history_view_service_message.cpp b/Telegram/SourceFiles/history/view/history_view_service_message.cpp
