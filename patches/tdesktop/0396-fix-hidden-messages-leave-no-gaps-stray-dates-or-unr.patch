@@ -608,6 +608,9 @@ int Service::marginTop() const {
 }
 
 int Service::marginBottom() const {
+	if (isHidden()) {
+		return 0;
+	}
 	auto result = st::msgServiceMargin.bottom();
 	if (const auto margins = Get<ViewAddedMargins>()) {
 		result += margins->bottom;
diff --git a/Telegram/SourceFiles/tele/tele_communities.cpp b/Telegram/SourceFiles/tele/tele_communities.cpp
index 0595318d80ad052fa85e6dc2930555a42acbbf07..e63c8db61ec60d370c7d87a4139649ff161293ef 100644
--- a/Telegram/SourceFiles/tele/tele_communities.cpp
+++ b/Telegram/SourceFiles/tele/tele_communities.cpp
@@ -56,6 +56,7 @@ void RefreshServiceViews(not_null<Main::Session*> session) {
 	for (const auto &item : items) {
 		session->data().requestItemViewRefresh(item);
 	}
+	session->data().sendHistoryChangeNotifications();
 }
 
 void CloseCommunityWindows(not_null<Main::Session*> session) {
diff --git a/Telegram/SourceFiles/tele/tele_hidden_words.cpp b/Telegram/SourceFiles/tele/tele_hidden_words.cpp
index bcedc4cc8b582511b6bbc95aa7a6b5036ec00421..e2c6f2ac154adb01f95c9bc695f50a96fe754fd1 100644
--- a/Telegram/SourceFiles/tele/tele_hidden_words.cpp
+++ b/Telegram/SourceFiles/tele/tele_hidden_words.cpp
@@ -159,12 +159,17 @@ void Apply(Fn<void()> change) {
 	auto &state = Get();
 	++state.generation;
 	state.cache.clear();
+	auto owners = base::flat_set<not_null<Data::Session*>>();
 	for (auto i = 0; i != int(items.size()); ++i) {
 		const auto item = items[i];
 		if (HiddenByWords(item) != before[i]) {
 			item->history()->owner().requestItemViewRefresh(item);
+			owners.emplace(&item->history()->owner());
 		}
 	}
+	for (const auto &owner : owners) {
+		owner->sendHistoryChangeNotifications();
+	}
 	state.changes.fire({});
 }
 
diff --git a/Telegram/SourceFiles/tele/tele_ignored.cpp b/Telegram/SourceFiles/tele/tele_ignored.cpp
index e0955e6ded4258252aac22e96e58a29cb1180fdd..55b2f056bfa973366935b738e6717c8aeb504aae 100644
--- a/Telegram/SourceFiles/tele/tele_ignored.cpp
+++ b/Telegram/SourceFiles/tele/tele_ignored.cpp
@@ -124,8 +124,13 @@ void Refresh(
 			items.emplace(item);
 		}
 	}
+	auto owners = base::flat_set<not_null<Data::Session*>>();
 	for (const auto &item : items) {
 		item->history()->owner().requestItemViewRefresh(item);
+		owners.emplace(&item->history()->owner());
+	}
+	for (const auto &owner : owners) {
+		owner->sendHistoryChangeNotifications();
 	}
 }
 
