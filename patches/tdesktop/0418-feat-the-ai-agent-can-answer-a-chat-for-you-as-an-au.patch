+		for (const auto &entry : AutoReplies(session)) {
+			if (entry.enabled) {
+				active.push_back(entry);
+			}
+		}
+		const auto shown = !active.empty();
+		if (shown) {
+			barLabel->setText((active.size() == 1)
+				? Tr(u"Auto-reply: %1"_q).arg(active.front().title)
+				: TrCount(
+					int(active.size()),
+					u"Auto-reply in %1 chat"_q,
+					u"Auto-reply is on in %1 chats"_q));
+			barStop->setText(rpl::single((active.size() == 1)
+				? Tr(u"Stop"_q)
+				: Tr(u"Stop all"_q)));
+		}
+		bar->setVisible(shown);
+		barShadow->setVisible(shown);
+		layout();
+	};
+	barStop->setClickedCallback([=] {
+		StopAutoReplies(session);
+	});
+	AutoRepliesChanges(
+		session
+	) | rpl::on_next(updateBar, raw->lifetime());
+	updateBar();
 	crl::on_main(field, [=] {
