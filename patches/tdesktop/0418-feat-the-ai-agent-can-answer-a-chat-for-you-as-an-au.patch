+void Tools::setAutoReply(const QJsonObject &args, Fn<void(ToolOutcome)> done) {
+	const auto peer = PeerFromArgs(_session, args);
+	const auto value = args.value(u"enabled"_q);
+	const auto enabled = value.isBool() ? value.toBool() : true;
+	const auto scenario = args.value(u"scenario"_q).toString().trimmed();
+	const auto user = peer ? peer->asUser() : nullptr;
+	if (!peer) {
+		done(Error(u"Unknown chat_id. Take it from list_chats or "
+			"search_chats."_q));
+		return;
+	} else if (!user
+		|| user->isBot()
+		|| user->isSelf()
+		|| user->isServiceUser()) {
+		done(Error(u"The auto-responder works only in a private chat with a "
+			"person."_q));
+		return;
+	}
+	auto list = AutoReplies(_session);
+	auto i = ranges::find(list, user->id.value, &AutoReply::peer);
+	const auto known = (i != end(list)) && !i->scenario.isEmpty();
+	if (enabled && scenario.isEmpty() && !known) {
+		done(Error(u"A scenario is required: how to talk and what to "
+			"achieve."_q));
+		return;
+	}
+	if (i == end(list)) {
+		list.push_back(AutoReply{
+			.peer = user->id.value,
+			.stopPhrases = DefaultStopPhrases(),
+		});
+		i = end(list) - 1;
+	}
+	const auto title = Title(peer);
+	i->title = title;
+	i->enabled = enabled;
+	if (!scenario.isEmpty()) {
+		i->scenario = scenario;
+	}
+	SetAutoReplies(_session, std::move(list));
+	done({
+		.content = enabled
+			? (u"The auto-responder is on for \"%1\". It answers new "
+				"messages while mad is running."_q.arg(title))
+			: (u"The auto-responder for \"%1\" is off."_q.arg(title)),
+		.title = enabled
+			? Tr(u"Auto-reply for %1"_q).arg(title)
+			: Tr(u"Auto-reply off: %1"_q).arg(title),
+	});
+}
