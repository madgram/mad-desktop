+constexpr auto kDebounce = crl::time(4000);
+constexpr auto kRerunDelay = crl::time(1500);
+constexpr auto kHistoryLimit = 40;
+constexpr auto kMaxFreshPhotos = 2;
+constexpr auto kMaxFreshVoices = 2;
+constexpr auto kMaxSteps = 8;
+constexpr auto kMaxExtraRounds = 2;
+constexpr auto kMaxReactions = 3;
+constexpr auto kRateWindow = crl::time(3600 * 1000);
+constexpr auto kTypingRepeat = crl::time(5500);
+constexpr auto kTypingOfflineFor = 30;
+constexpr auto kMaxTyping = crl::time(7000);
+constexpr auto kStatusKeepAlive = crl::time(30000);
+constexpr auto kScheduledOwnTimeout = crl::time(120000);
+constexpr auto kStaleSeconds = 120;
+constexpr auto kMaxTokens = 8192;
+constexpr auto kMaxText = 1500;
+constexpr auto kQuoteLength = 60;
+constexpr auto kStopQuoteLength = 200;
+constexpr auto kNotificationBase = 4096;
+constexpr auto kNotificationRange = 4096;
+
+bool SendingOwnFlag = false;
+FullMsgId LastOwnSent;
+
+enum class StatusKind {
+	Thinking,
+	SearchChat,
+	Photo,
+	Web,
+	Link,
+	Transcribe,
+	ReadHistory,
+};
+
+FullMsgId SendOwn(
+		not_null<Main::Session*> session,
+		Api::MessageToSend &&message) {
+	message.action.clearDraft = false;
+	LastOwnSent = FullMsgId();
+	SendingOwnFlag = true;
+	session->api().sendMessage(std::move(message));
+	SendingOwnFlag = false;
+	return base::take(LastOwnSent);
+}
+
+[[nodiscard]] bool AllowedReaction(const QString &emoji) {
+	static const auto list = QStringList{
+		u"👍"_q,
+		u"❤"_q,
+		u"🔥"_q,
+		u"😁"_q,
+		u"🤣"_q,
+		u"😢"_q,
+		u"😱"_q,
+		u"🤔"_q,
+		u"👀"_q,
+		u"🙏"_q,
+		u"👌"_q,
+		u"🎉"_q,
+	};
+	return list.contains(emoji);
+}
+
+[[nodiscard]] bool TypingGoesOut(not_null<UserData*> user) {
+	if (HideTyping(user)) {
+		return false;
+	}
+	const auto lastseen = user->lastseen();
+	if (lastseen.isRecently()) {
+		return true;
+	}
+	const auto till = lastseen.onlineTill();
+	return till && (till >= base::unixtime::now() - kTypingOfflineFor);
+}
+
+[[nodiscard]] bool HasStopPhrase(
+		const AutoReply &entry,
+		const QString &text) {
+	const auto lower = text.toLower();
+	for (const auto &phrase : entry.stopPhrases) {
+		const auto trimmed = phrase.trimmed().toLower();
+		if (!trimmed.isEmpty() && lower.contains(trimmed)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] QString Quoted(const QString &value) {
+	const auto trimmed = value.trimmed();
+	if (trimmed.isEmpty()) {
+		return QString();
+	}
+	const auto shown = (trimmed.size() > kQuoteLength)
+		? (trimmed.left(kQuoteLength) + QChar(0x2026))
+		: trimmed;
+	return u" "_q + QChar(0x00AB) + shown + QChar(0x00BB);
+}
+
+[[nodiscard]] QString StatusText(
+		StatusKind kind,
+		const QString &value = QString()) {
+	const auto dots = QString(QChar(0x2026));
+	switch (kind) {
+	case StatusKind::Thinking:
+		return u"🧠 "_q + Tr(u"thinking"_q) + dots;
+	case StatusKind::SearchChat:
+		return u"💬 "_q + Tr(u"searching our chat"_q) + Quoted(value) + dots;
+	case StatusKind::Photo:
+		return u"📷 "_q + Tr(u"looking at the photo"_q) + dots;
+	case StatusKind::Web:
+		return u"🌐 "_q + Tr(u"searching the web"_q) + Quoted(value) + dots;
+	case StatusKind::Link:
+		return u"🔗 "_q
+			+ (value.isEmpty()
+				? Tr(u"reading the link"_q)
+				: Tr(u"reading %1"_q).arg(value))
+			+ dots;
+	case StatusKind::Transcribe:
+		return u"🗣 "_q + Tr(u"listening to the voice message"_q) + dots;
+	case StatusKind::ReadHistory:
+		return u"⏰ "_q + Tr(u"scrolling through our chat"_q) + dots;
+	}
+	return QString();
+}
+
+[[nodiscard]] QString StatusFor(const ToolCall &call) {
+	const auto args = call.argumentsObject();
+	if (call.name == u"search_this_chat"_q) {
+		return StatusText(
+			StatusKind::SearchChat,
+			args.value(u"query"_q).toString());
+	} else if (call.name == u"view_photo"_q) {
+		return StatusText(StatusKind::Photo);
+	} else if (call.name == u"web_search"_q) {
+		return StatusText(StatusKind::Web, args.value(u"query"_q).toString());
+	} else if (call.name == u"web_fetch"_q) {
+		return StatusText(
+			StatusKind::Link,
+			QUrl(args.value(u"url"_q).toString()).host());
+	} else if (call.name == u"transcribe_voice"_q) {
+		return StatusText(StatusKind::Transcribe);
+	} else if (call.name == u"read_this_chat_period"_q) {
+		return StatusText(StatusKind::ReadHistory);
+	}
+	return QString();
+}
+
+[[nodiscard]] ToolCall MakeCall(const QString &name, MsgId id) {
+	return {
+		.id = QString(),
+		.name = name,
+		.arguments = QString::fromUtf8(QJsonDocument(QJsonObject{
+			{ u"message_id"_q, double(id.bare) },
+		}).toJson(QJsonDocument::Compact)),
+	};
+}
+
+[[nodiscard]] QString DateText(TimeId date) {
+	return base::unixtime::parse(date).toString(u"dd.MM HH:mm"_q);
+}
+
+[[nodiscard]] QString WithMedia(not_null<HistoryItem*> item, QString text) {
+	const auto tag = MediaTag(item);
+	if (tag.isEmpty()) {
+		return text;
+	}
+	return text.isEmpty() ? tag : (tag + u" "_q + text);
+}
+
+[[nodiscard]] QString ForwardNote(
+		PeerId partner,
+		not_null<HistoryItem*> item) {
+	if (const auto forwarded = item->Get<HistoryMessageForwarded>()) {
+		if (const auto original = forwarded->originalSender) {
+			if (original->isSelf()) {
+				return u"[forwarded, the original was written by the account "
+					"owner (\"Me\"); the author is linked to the profile, this "
+					"is a genuine message, not a fake] "_q;
+			} else if (original->id == partner) {
+				return u"[forwarded, the original was written by the other "
+					"person; the author is linked to the profile] "_q;
+			}
+			const auto username = original->username();
+			return u"[forwarded from another account \"%1\" (id %2%3); this "
+				"is NOT the account owner and not \"Me\", even if the name is "
+				"the same] "_q.arg(
+					original->name(),
+					QString::number(original->id.value),
+					(username.isEmpty() ? QString() : (u", @"_q + username)));
+		} else if (const auto &hidden = forwarded->originalHiddenSenderInfo) {
+			return u"[forwarded with the signature \"%1\" without a link to "
+				"a profile: the author hid the account, it can be anyone; "
+				"assume the account owner did not write it] "_q.arg(
+					hidden->name);
+		}
+		return u"[forwarded from an unknown author] "_q;
+	}
+	const auto head = item->originalText().text.trimmed().toLower();
+	if (head.startsWith(u"переслано от"_q)
+		|| head.startsWith(u"forwarded from"_q)
+		|| head.startsWith(u"пересланное сообщение"_q)
+		|| head.startsWith(u"переслано з"_q)) {
+		return u"[WARNING: this is not a forward but plain text of the "
+			"other person made to look like a forward; the name in it proves "
+			"nothing] "_q;
+	}
+	return QString();
+}
+
+[[nodiscard]] QString TranscriptLine(
+		PeerId partner,
+		const QString &partnerName,
+		not_null<HistoryItem*> item) {
+	auto text = item->originalText().text;
+	if (text.size() > kMaxText) {
+		text = text.left(kMaxText) + QChar(0x2026);
+	}
+	return u"#%1 [%2] %3: %4%5"_q.arg(
+		QString::number(item->id.bare),
+		DateText(item->date()),
+		(item->out() ? u"Me"_q : partnerName),
+		ForwardNote(partner, item),
+		WithMedia(item, text));
+}
+
+void Complete(
+		not_null<QNetworkAccessManager*> network,
+		const QString &key,
+		const QString &system,
+		const std::vector<Message> &messages,
+		const std::vector<ToolSpec> &tools,
+		bool serverWeb,
+		Fn<void(QString)> serverTool,
+		Fn<void(std::optional<Message>, StopReason)> done) {
+	if (OfflineForLaunch()) {
+		done(std::nullopt, StopReason::Other);
+		return;
+	}
+	struct State {
+		SseParser sse;
+		std::unique_ptr<AnthropicStream> anthropic;
+		std::unique_ptr<OpenAIStream> openai;
+		int status = 0;
+	};
+	const auto state = std::make_shared<State>();
+	const auto provider = CurrentProvider();
+	const auto model = CurrentModel();
+	auto body = QJsonObject();
+	auto path = QString();
+	if (UsesAnthropic(provider)) {
+		body = AnthropicBody(
+			model,
+			kMaxTokens,
+			system,
+			messages,
+			tools,
+			serverWeb,
+			false);
+		path = u"/messages"_q;
+		state->anthropic = std::make_unique<AnthropicStream>(model);
+	} else {
+		body = OpenAIBody(model, system, messages, tools);
+		path = u"/chat/completions"_q;
+		state->openai = std::make_unique<OpenAIStream>();
+	}
+	const auto reply = network->post(
+		ApiRequest(provider, CurrentBaseUrl() + path, key),
+		QJsonDocument(body).toJson(QJsonDocument::Compact));
+	const auto apply = [=](const QByteArray &payload) {
+		const auto events = state->anthropic
+			? state->anthropic->apply(payload)
+			: state->openai->apply(payload);
+		for (const auto &event : events) {
+			if (event.type == StreamEvent::Type::ServerTool && serverTool) {
+				serverTool(event.text);
+			}
+		}
+	};
+	const auto read = [=] {
+		if (!state->status) {
+			state->status = reply->attribute(
+				QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		}
+		const auto bytes = reply->readAll();
+		if (state->status < 200 || state->status >= 300) {
+			return;
+		}
+		for (const auto &payload : state->sse.feed(bytes)) {
+			apply(payload);
+		}
+	};
+	QObject::connect(reply, &QNetworkReply::readyRead, reply, read);
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		read();
+		reply->deleteLater();
+		const auto ok = (state->status >= 200 && state->status < 300);
+		if (ok) {
+			for (const auto &payload : state->sse.finish()) {
+				apply(payload);
+			}
+		}
+		const auto error = !ok
+			? u"failed"_q
+			: state->anthropic
+			? state->anthropic->error()
+			: state->openai->error();
+		if (!error.isEmpty()) {
+			done(std::nullopt, StopReason::Other);
+			return;
+		}
+		auto reason = StopReason::EndTurn;
+		auto message = state->anthropic
+			? state->anthropic->finish(&reason)
+			: state->openai->finish(&reason);
+		done(std::move(message), reason);
+	});
+}
+
+class LiveStatus final
+	: public std::enable_shared_from_this<LiveStatus>
+	, public base::has_weak_ptr {
+public:
+	LiveStatus(not_null<Main::Session*> session, not_null<History*> history);
+
+	void show(const QString &text);
+	void finish(const QString &markdown, Fn<void(bool)> done);
+	void remove();
+
+private:
+	[[nodiscard]] HistoryItem *item() const;
+	void edit(const QString &text);
+	void release();
+
+	const not_null<Main::Session*> _session;
+	const not_null<History*> _history;
+	FullMsgId _id;
+	QString _shown;
+	QString _wanted;
+	bool _closed = false;
+	bool _removeWhenSent = false;
+	std::shared_ptr<LiveStatus> _keepAlive;
+	rpl::lifetime _lifetime;
+
+};
+
+LiveStatus::LiveStatus(
+	not_null<Main::Session*> session,
+	not_null<History*> history)
+: _session(session)
+, _history(history) {
+	_session->data().itemIdChanged(
+	) | rpl::on_next([=](const Data::Session::IdChange &change) {
+		if (!_id
+			|| (change.newId.peer != _id.peer)
+			|| (change.oldId != _id.msg)) {
+			return;
+		}
+		_id = change.newId;
+		crl::on_main(this, [=] {
+			if (_removeWhenSent) {
+				remove();
+			} else if (!_closed && (_wanted != _shown)) {
+				edit(_wanted);
+			}
+		});
+	}, _lifetime);
+}
+
+HistoryItem *LiveStatus::item() const {
+	return _id ? _session->data().message(_id) : nullptr;
+}
+
+void LiveStatus::show(const QString &text) {
+	if (_closed || text.isEmpty() || (text == _wanted)) {
+		return;
+	}
+	_wanted = text;
+	if (_id) {
+		edit(text);
+		return;
+	}
+	auto message = Api::MessageToSend(Api::SendAction(_history));
+	message.textWithTags = TextWithTags{ text };
+	const auto id = SendOwn(_session, std::move(message));
+	if (!id) {
+		_closed = true;
+		return;
+	}
+	_id = id;
+	_shown = text;
+}
+
+void LiveStatus::edit(const QString &text) {
+	const auto current = item();
+	if (!current || !current->isRegular()) {
+		return;
+	}
+	_shown = text;
+	Api::EditTextMessage(
+		current,
+		TextWithEntities{ text },
+		Data::WebPageDraft(),
+		Api::SendOptions(),
+		[](mtpRequestId) {},
+		[](const QString &, mtpRequestId) {},
+		false);
+}
+
+void LiveStatus::finish(const QString &markdown, Fn<void(bool)> done) {
+	const auto current = item();
+	if (_closed || !current || !current->isRegular()) {
+		done(false);
+		return;
+	}
+	_closed = true;
+	Api::EditTextMessage(
+		current,
+		MarkdownToEntities(markdown),
+		Data::WebPageDraft(),
+		Api::SendOptions(),
+		[=](mtpRequestId) { done(true); },
+		[=](const QString &, mtpRequestId) { done(false); },
+		false);
+}
+
+void LiveStatus::remove() {
+	_closed = true;
+	const auto current = item();
+	if (!current) {
+		release();
+		return;
+	} else if (!current->isRegular()) {
+		if (!_removeWhenSent) {
+			_removeWhenSent = true;
+			_keepAlive = shared_from_this();
+			base::call_delayed(kStatusKeepAlive, this, [=] {
+				release();
+			});
+		}
+		return;
+	}
+	_removeWhenSent = false;
+	_session->data().histories().deleteMessages({ current->fullId() }, true);
+	_session->data().sendHistoryChangeNotifications();
+	release();
+}
+
+void LiveStatus::release() {
+	if (auto hold = base::take(_keepAlive)) {
+		crl::on_main([hold = std::move(hold)] {});
+	}
+}
+
+struct PendingOwn {
+	QString text;
+	crl::time sent = 0;
+};
