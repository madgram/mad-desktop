+	std::vector<ToolSpec> tools;
+	bool serverWeb = false;
+	bool localWeb = false;
+	base::flat_set<MsgId> knownIds;
+	MsgId processedMaxId = 0;
+	std::vector<MsgId> photos;
+	std::vector<MsgId> voices;
