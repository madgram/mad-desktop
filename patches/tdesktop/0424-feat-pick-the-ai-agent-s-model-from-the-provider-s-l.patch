+void Runner::fetchModels(
+		Provider provider,
+		Fn<void(std::vector<ModelInfo>, QString)> done) {
+	constexpr auto kMaxPages = 10;
+	constexpr auto kMaxModelsBody = 4 * 1024 * 1024;
+	if (OfflineForLaunch()) {
+		done({}, Tr(u"The agent is off: mad was started with -teleoffline."_q));
+		return;
+	}
+	const auto key = _store->key(provider);
+	const auto base = IsCustom(provider)
+		? CurrentBaseUrl()
+		: OfficialBaseUrl(provider);
+	if (key.isEmpty()) {
+		done({}, Tr(u"Add an API key to load the list of models."_q));
+		return;
+	} else if (base.isEmpty()) {
+		done({}, Tr(u"Set the API address first."_q));
+		return;
+	}
+	struct State {
+		std::vector<ModelInfo> models;
+		int pages = 0;
+		Fn<void(QString)> load;
+	};
+	const auto state = std::make_shared<State>();
+	const auto weak = base::make_weak(this);
+	state->load = [=](QString after) {
+		auto url = base + u"/models"_q;
+		if (UsesAnthropic(provider)) {
+			url += u"?limit=1000"_q;
+			if (!after.isEmpty()) {
+				url += u"&after_id="_q
+					+ QString::fromLatin1(QUrl::toPercentEncoding(after));
+			}
+		}
+		auto request = MakeRequest(provider, url, key);
+		request.setRawHeader("Accept", "application/json");
+		const auto reply = _network->get(request);
+		QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+			const auto status = reply->attribute(
+				QNetworkRequest::HttpStatusCodeAttribute).toInt();
+			const auto body = reply->read(kMaxModelsBody);
+			const auto failed = (reply->error() != QNetworkReply::NoError)
+				&& !status;
+			const auto error = failed ? reply->errorString() : QString();
+			reply->deleteLater();
+			if (!weak) {
+				return;
+			} else if (failed) {
+				state->load = nullptr;
+				done({}, error);
+				return;
+			} else if (status < 200 || status >= 300) {
+				state->load = nullptr;
+				done({}, ErrorMessage(status, body));
+				return;
+			}
+			auto page = ParseModelPage(body);
+			for (auto &model : page.models) {
+				state->models.push_back(std::move(model));
+			}
+			if (UsesAnthropic(provider)
+				&& page.hasMore
+				&& !page.lastId.isEmpty()
+				&& ++state->pages < kMaxPages) {
+				state->load(page.lastId);
+				return;
+			}
+			const auto load = base::take(state->load);
+			done(PreparedModels(provider, base::take(state->models)), QString());
+		});
+	};
+	state->load(QString());
+}
