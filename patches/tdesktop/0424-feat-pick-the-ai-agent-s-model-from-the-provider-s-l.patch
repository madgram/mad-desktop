+void AddAgentModelButton(SectionBuilder &builder) {
+	auto &option = base::options::lookup<QString>(
+		::Tele::kOptionAgentModel);
+	const auto controller = builder.controller();
+	const auto title = ::Tele::Tr(option.name());
+	const auto description = ::Tele::Tr(option.description());
+	auto label = rpl::combine(
+		::Tele::AgentProviderValue(),
+		rpl::single(rpl::empty) | rpl::then(option.changes())
+	) | rpl::map([](const QString &providerId, auto) {
+		using namespace ::Tele::Agent;
+		const auto provider = ProviderFromId(providerId);
+		const auto model = ModelFor(provider);
+		const auto value = model.isEmpty() ? DefaultModel(provider) : model;
+		return value.isEmpty()
+			? ::Tele::Tr(u"Not selected"_q)
+			: (value.size() > 40)
+			? (value.left(40) + QChar(0x2026))
+			: value;
+	});
+	const auto button = AddButton(builder, {
+		.id = option.id(),
+		.title = rpl::single(title),
+		.st = &st::settingsButtonNoIcon,
+		.label = std::move(label),
+		.onClick = [=] {
+			::Tele::Agent::ShowModelBox(controller);
+		},
+		.keywords = { description, u"agent"_q, u"модель"_q },
+	});
+	if (button) {
+		SetupLink(button, option.id());
+	}
+	AddAbout(builder, option.id(), description);
+}
