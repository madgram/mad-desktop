+ModelPage ParseModelPage(const QByteArray &json) {
+	auto result = ModelPage();
+	const auto document = QJsonDocument::fromJson(json);
+	if (!document.isObject()) {
+		return result;
+	}
+	const auto object = document.object();
+	for (const auto &value : object.value(u"data"_s).toArray()) {
+		const auto entry = value.toObject();
+		const auto id = entry.value(u"id"_s).toString().trimmed();
+		if (id.isEmpty()) {
+			continue;
+		}
+		auto name = entry.value(u"display_name"_s).toString().trimmed();
+		if (name.isEmpty()) {
+			name = entry.value(u"name"_s).toString().trimmed();
+		}
+		result.models.push_back({
+			.id = id,
+			.name = (name == id) ? QString() : name,
+			.created = qint64(entry.value(u"created"_s).toDouble()),
+		});
+	}
+	result.hasMore = object.value(u"has_more"_s).toBool();
+	result.lastId = object.value(u"last_id"_s).toString();
+	if (result.lastId.isEmpty() && !result.models.empty()) {
+		result.lastId = result.models.back().id;
+	}
+	return result;
+}
+
+std::vector<ModelInfo> PreparedModels(
+		Provider provider,
+		std::vector<ModelInfo> list) {
+	constexpr auto kMaxModels = 400;
+	auto seen = QSet<QString>();
+	auto result = std::vector<ModelInfo>();
+	result.reserve(list.size());
+	for (auto &model : list) {
+		if (!seen.contains(model.id)) {
+			seen.insert(model.id);
+			result.push_back(std::move(model));
+		}
+	}
+	if (!UsesAnthropic(provider)) {
+		std::stable_sort(
+			begin(result),
+			end(result),
+			[](const ModelInfo &a, const ModelInfo &b) {
+				return (a.created != b.created)
+					? (a.created > b.created)
+					: (a.id < b.id);
+			});
+	}
+	if (int(result.size()) > kMaxModels) {
+		result.resize(kMaxModels);
+	}
+	return result;
+}
