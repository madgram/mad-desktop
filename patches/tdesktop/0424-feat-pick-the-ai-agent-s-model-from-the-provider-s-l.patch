+void ShowModelBox(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto provider = CurrentProvider();
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		struct State {
+			rpl::variable<QString> current;
+			std::shared_ptr<Ui::RadiobuttonGroup> group;
+			std::vector<ModelInfo> models;
+			Ui::VerticalLayout *list = nullptr;
+			Ui::FlatLabel *status = nullptr;
+			Ui::InputField *field = nullptr;
+			bool applying = false;
+		};
+		const auto state = box->lifetime().make_state<State>();
+		state->current = ModelFor(provider);
+		box->setTitle(rpl::single(Tr(u"Model"_q)));
+		box->setWidth(st::boxWideWidth);
+
+		Ui::AddSubsectionTitle(
+			box->verticalLayout(),
+			rpl::single(Tr(u"Manually"_q)));
+		state->field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(Tr(u"Model name"_q)),
+			state->current.current()));
+		box->addRow(
+			object_ptr<Ui::FlatLabel>(
+				box,
+				Tr(u"You can type any model, even if it isn't in the list."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding + QMargins(0, st::boxLittleSkip, 0, 0));
+		state->field->changes() | rpl::on_next([=] {
+			if (state->applying) {
+				return;
+			}
+			const auto value = state->field->getLastText().trimmed();
+			SetModelFor(provider, value);
+			state->current = value;
+		}, state->field->lifetime());
+
+		Ui::AddSkip(box->verticalLayout());
+		Ui::AddSubsectionTitle(
+			box->verticalLayout(),
+			rpl::single(Tr(u"Available models"_q)));
+		state->status = box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Tr(u"Loading the list of models…"_q),
+			st::boxDividerLabel));
+		state->list = box->addRow(
+			object_ptr<Ui::VerticalLayout>(box),
+			QMargins());
+
+		const auto rebuild = [=] {
+			state->list->clear();
+			const auto &models = state->models;
+			const auto index = [=](const QString &id) {
+				const auto i = ranges::find(state->models, id, &ModelInfo::id);
+				return (i != end(state->models))
+					? int(i - begin(state->models))
+					: -1;
+			};
+			state->group = std::make_shared<Ui::RadiobuttonGroup>(
+				index(state->current.current()));
+			for (auto i = 0; i != int(models.size()); ++i) {
+				const auto &model = models[i];
+				const auto text = model.name.isEmpty()
+					? model.id
+					: (model.id + u" · "_q + model.name);
+				state->list->add(
+					object_ptr<Ui::Radiobutton>(
+						state->list,
+						state->group,
+						i,
+						text,
+						st::defaultBoxCheckbox),
+					st::boxRowPadding + QMargins(0, st::boxLittleSkip, 0, 0));
+			}
+			state->group->setChangedCallback([=](int value) {
+				if (value < 0 || value >= int(state->models.size())) {
+					return;
+				}
+				const auto id = state->models[value].id;
+				SetModelFor(provider, id);
+				if (state->field->getLastText().trimmed() != id) {
+					state->applying = true;
+					state->field->setText(id);
+					state->applying = false;
+				}
+				state->current = id;
+			});
+			state->current.changes() | rpl::on_next([=](const QString &id) {
+				state->group->setValue(index(id));
+			}, state->list->lifetime());
+			state->list->resizeToWidth(box->width());
+		};
+
+		Runner::For(session).fetchModels(provider, crl::guard(box, [=](
+				std::vector<ModelInfo> models,
+				QString error) {
+			if (!error.isEmpty()) {
+				state->status->setText(error);
+				return;
+			} else if (models.empty()) {
+				state->status->setText(Tr(u"The provider returned no models."_q));
+				return;
+			}
+			state->status->hide();
+			state->models = std::move(models);
+			rebuild();
+		}));
+
+		box->setFocusCallback([=] { state->field->setFocusFast(); });
+		box->addButton(rpl::single(Tr(u"Done"_q)), [=] {
+			box->closeBox();
+		});
+	}));
+}
