+
+QString ModelFor(Provider provider) {
+	return ModelMap().value(ProviderId(provider)).toString().trimmed();
+}
+
+void SetModelFor(Provider provider, const QString &model) {
+	auto map = ModelMap();
+	const auto trimmed = model.trimmed();
+	if (trimmed.isEmpty()) {
+		map.remove(ProviderId(provider));
+	} else {
+		map.insert(ProviderId(provider), trimmed);
+	}
+	base::options::lookup<QString>(kOptionAgentModel).set(map.isEmpty()
+		? QString()
+		: QString::fromUtf8(QJsonDocument(map).toJson(
+			QJsonDocument::Compact)));
+}
+
+QString CurrentModel() {
+	const auto provider = CurrentProvider();
+	const auto value = ModelFor(provider);
+	return value.isEmpty() ? DefaultModel(provider) : value;
 }
 
