+	const auto font = CardFont(14, true);
+	const auto icon = CardScaled(kChipIcon);
+	const auto gap = CardScaled(kChipGap);
+	auto left = CardScaled(4);
+	for (auto &chip : _chips) {
+		chip.text = font->elided(
+			LinkedAccountTitle(chip.account),
+			CardScaled(kChipMaxText));
+		chip.left = left;
+		chip.width = icon
+			+ CardScaled(8)
+			+ font->width(chip.text)
+			+ (chip.account.verified ? CardScaled(17) : 0);
+		left += chip.width + gap;
+	}
+	_contentWidth = _chips.empty()
+		? 0
+		: (left - gap + CardScaled(4));
