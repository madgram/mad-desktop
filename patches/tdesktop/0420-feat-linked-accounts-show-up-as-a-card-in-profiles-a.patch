+void FillAdd(Context context, not_null<Ui::VerticalLayout*> content) {
+	const auto service = context.service;
+	context.state->title = Tr(u"Add account"_q);
+	AddHeadline(content, Tr(u"Choose a platform"_q), QString());
+	auto login = std::vector<LinkedPlatform>();
+	auto dns = std::vector<LinkedPlatform>();
+	for (const auto &platform : service->platforms()) {
+		if (platform.method == u"dns"_q) {
+			dns.push_back(platform);
+		} else {
+			login.push_back(platform);
+		}
+	}
+	if (login.empty() && dns.empty()) {
+		AddLabel(
+			content,
+			service->busy() ? Tr(u"Loading…"_q) : service->error(),
+			CardSubtitleStyle(),
+			Side());
+		AddSkip(content, 20);
+		return;
+	}
+	if (!login.empty()) {
+		AddLabel(
+			content,
+			Tr(u"Sign in to confirm ownership"_q),
+			CardTitleStyle(),
+			Side());
+		AddSkip(content, 12);
+		AddPlatformGrid(context, content, std::move(login));
+		AddSkip(content, 22);
+	}
+	if (!dns.empty()) {
+		AddLabel(content, Tr(u"Your website"_q), CardTitleStyle(), Side());
+		AddSkip(content, 12);
+		AddPlatformGrid(context, content, std::move(dns));
+		AddSkip(content, 22);
+	}
+	AddLabel(
+		content,
+		Tr(u"Signing in proves the account is yours. mad never sees your "
+			"passwords."_q),
+		CardCaptionStyle(),
+		Side());
+	AddSkip(content, 24);
+}
