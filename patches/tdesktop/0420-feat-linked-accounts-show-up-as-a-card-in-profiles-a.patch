+void PaintPlatformCard(
+		QPainter &p,
+		QRect rect,
+		bool over,
+		const LinkedPlatform &platform,
+		const QString &status) {
+	auto hq = PainterHighQualityEnabler(p);
+	if (!platform.available) {
+		p.setOpacity(0.5);
+	}
+	const auto radius = CardScaled(kCardRadius) * 1.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(over && platform.available
+		? st::windowBgRipple
+		: st::windowBgOver);
+	p.drawRoundedRect(QRectF(rect), radius, radius);
+	const auto padding = CardScaled(14);
+	const auto icon = CardScaled(kCardIcon);
+	const auto height = rect.height();
+	p.drawImage(
+		QRect(padding, (height - icon) / 2, icon, icon),
+		LinkedPlatformIcon(platform.id, icon));
+	const auto chevron = CardScaled(11);
+	const auto textLeft = padding + icon + CardScaled(12);
+	const auto available = std::max(
+		rect.width() - textLeft - chevron - 2 * padding,
+		0);
+	const auto titleFont = CardFont(15, true);
+	const auto statusFont = CardFont(13, false);
+	const auto skip = CardScaled(2);
+	const auto textTop = (height
+		- titleFont->height
+		- skip
+		- statusFont->height) / 2;
+	p.setFont(titleFont);
+	p.setPen(st::windowBoldFg);
+	p.drawText(
+		textLeft,
+		textTop + titleFont->ascent,
+		titleFont->elided(LinkedPlatformName(platform.id), available));
+	p.setFont(statusFont);
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		textLeft,
+		textTop + titleFont->height + skip + statusFont->ascent,
+		statusFont->elided(status, available));
+	PaintCardChevron(
+		p,
+		QRectF(
+			rect.width() - padding - chevron,
+			(height - chevron) / 2.,
+			chevron,
+			chevron),
+		st::windowSubTextFg->c,
+		false);
+	p.setOpacity(1.);
+}
+
+void AddPlatformGrid(
+		Context context,
+		not_null<Ui::VerticalLayout*> content,
+		std::vector<LinkedPlatform> platforms) {
+	const auto service = context.service;
+	const auto grid = content->add(
+		object_ptr<Ui::RpWidget>(content),
+		Side());
+	auto cards = std::vector<not_null<PaintedButton*>>();
+	for (const auto &platform : platforms) {
+		const auto linked = [&]() -> const LinkedAccount* {
+			if (platform.method == u"dns"_q) {
+				return nullptr;
+			}
+			for (const auto &account : service->mine().accounts) {
+				if (account.platform == platform.id) {
+					return &account;
+				}
+			}
+			return nullptr;
+		}();
+		const auto status = linked
+			? Tr(u"linked"_q)
+			: !platform.available
+			? Tr(u"soon"_q)
+			: (platform.method == u"dns"_q)
+			? Tr(u"via DNS"_q)
+			: Tr(u"sign in"_q);
+		const auto accountId = linked ? linked->id : QString();
+		const auto card = Ui::CreateChild<PaintedButton>(grid, [=](
+				QPainter &p,
+				QRect rect,
+				bool over) {
+			PaintPlatformCard(p, rect, over, platform, status);
+		});
+		card->setPointerCursor(platform.available || !accountId.isEmpty());
+		card->setClickedCallback([=] {
+			if (!accountId.isEmpty()) {
+				Open(context, { .type = PageType::Account, .id = accountId });
+			} else {
+				StartLink(context, platform);
+			}
+		});
+		cards.push_back(card);
+	}
+	const auto rows = (int(cards.size()) + 1) / 2;
+	const auto height = CardScaled(kCardHeight);
+	const auto gap = CardScaled(kCardGap);
+	grid->resize(
+		grid->width(),
+		rows ? (rows * height + (rows - 1) * gap) : 0);
+	grid->widthValue() | rpl::on_next([=](int width) {
+		const auto column = std::max((width - gap) / 2, 0);
+		for (auto i = 0; i != int(cards.size()); ++i) {
+			cards[i]->setGeometry(
+				(i % 2) * (column + gap),
+				(i / 2) * (height + gap),
+				column,
+				height);
+		}
+	}, grid->lifetime());
+}
