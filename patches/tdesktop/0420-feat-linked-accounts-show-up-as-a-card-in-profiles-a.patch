+	not_null<LinkedAccountsService*> service;
+	not_null<State*> state;
+};
+
+void Rebuild(Context context);
+
+void ScheduleRebuild(Context context) {
+	if (context.state->rebuildScheduled) {
+		return;
+	}
+	context.state->rebuildScheduled = true;
+	crl::on_main(context.box, [=] {
+		context.state->rebuildScheduled = false;
+		Rebuild(context);
+	});
+}
+
+void Open(Context context, Page page) {
+	context.state->stack.push_back(std::move(page));
+	ScheduleRebuild(context);
+}
+
+void Back(Context context) {
+	auto &stack = context.state->stack;
+	if (stack.size() > 1) {
+		stack.pop_back();
+		ScheduleRebuild(context);
+	} else {
+		context.box->closeBox();
+	}
+}
+
+void ReplaceTop(Context context, Page page) {
+	auto &stack = context.state->stack;
+	if (!stack.empty()) {
+		stack.pop_back();
+	}
+	stack.push_back(std::move(page));
+	ScheduleRebuild(context);
+}
+
+void PopToRoot(Context context) {
+	context.state->stack.resize(1);
+	ScheduleRebuild(context);
+}
