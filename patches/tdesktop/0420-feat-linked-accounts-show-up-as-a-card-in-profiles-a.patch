+		st::lineWidth,
+		st::shadowFg);
+}
+
+void PaintAccountRow(
+		QPainter &p,
+		QRect rect,
+		bool over,
+		const LinkedAccount &account,
+		const QString &title,
+		const QString &subtitle,
+		const QString &value,
+		bool valueActive,
+		bool first,
+		bool last) {
+	const auto width = rect.width();
+	const auto height = rect.height();
+	if (over) {
+		p.fillRect(rect, st::windowBgOver);
+	}
+	if (first) {
+		PaintSeparator(p, width, 0);
+	}
+	PaintSeparator(p, width, height - st::lineWidth);
+	const auto side = CardScaled(kSide);
+	const auto icon = CardScaled(kAccountIcon);
+	p.drawImage(
+		QRect(side, (height - icon) / 2, icon, icon),
+		LinkedPlatformIcon(account.platform, icon));
+	const auto chevron = CardScaled(12);
+	const auto valueFont = CardFont(14, false);
+	const auto valueWidth = value.isEmpty() ? 0 : valueFont->width(value);
+	const auto right = width
+		- side
+		- chevron
+		- CardScaled(12)
+		- (valueWidth ? (valueWidth + CardScaled(10)) : 0);
+	const auto textLeft = side + icon + CardScaled(14);
+	const auto titleFont = CardFont(15, true);
+	const auto subtitleFont = CardFont(13, false);
+	const auto skip = CardScaled(3);
+	const auto textTop = (height
+		- titleFont->height
+		- skip
+		- subtitleFont->height) / 2;
+	const auto verified = account.verified ? CardScaled(15) : 0;
+	const auto verifiedSkip = verified ? (verified + CardScaled(6)) : 0;
+	const auto titleText = titleFont->elided(
+		title,
+		std::max(right - textLeft - verifiedSkip, 0));
+	p.setFont(titleFont);
+	p.setPen(st::windowBoldFg);
+	p.drawText(textLeft, textTop + titleFont->ascent, titleText);
+	if (verified) {
+		PaintLinkedVerified(
+			p,
+			QRectF(
+				textLeft + titleFont->width(titleText) + CardScaled(6),
+				textTop + (titleFont->height - verified) / 2.,
+				verified,
+				verified),
+			st::windowActiveTextFg->c);
+	}
+	p.setFont(subtitleFont);
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		textLeft,
+		textTop + titleFont->height + skip + subtitleFont->ascent,
+		subtitleFont->elided(subtitle, std::max(right - textLeft, 0)));
+	if (valueWidth) {
+		p.setFont(valueFont);
+		p.setPen(valueActive ? st::windowActiveTextFg : st::windowSubTextFg);
+		p.drawText(
+			width - side - chevron - CardScaled(12) - valueWidth,
+			(height - valueFont->height) / 2 + valueFont->ascent,
+			value);
+	}
+	PaintCardChevron(
+		p,
+		QRectF(
+			width - side - chevron,
+			(height - chevron) / 2.,
+			chevron,
+			chevron),
+		st::windowSubTextFg->c,
+		false);
+}
+
+void AddAccountRow(
+		not_null<Ui::VerticalLayout*> content,
+		LinkedAccount account,
+		QString title,
+		QString subtitle,
+		QString value,
+		bool valueActive,
+		bool first,
+		bool last,
+		Fn<void()> clicked) {
+	const auto row = content->add(object_ptr<PaintedButton>(
+		content,
+		[=](QPainter &p, QRect rect, bool over) {
+			PaintAccountRow(
+				p,
+				rect,
+				over,
+				account,
+				title,
+				subtitle,
+				value,
+				valueActive,
+				first,
+				last);
+		}));
+	row->resize(row->width(), CardScaled(kAccountRowHeight));
+	row->setClickedCallback(std::move(clicked));
+}
