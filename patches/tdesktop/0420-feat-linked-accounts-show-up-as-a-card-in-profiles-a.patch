+
+[[nodiscard]] bool HasBundledIcon(const QString &platform) {
+	static const auto known = std::vector<QString>{
+		u"discord"_q,
+		u"github"_q,
+		u"gitlab"_q,
+		u"lastfm"_q,
+		u"reddit"_q,
+		u"soundcloud"_q,
+		u"spotify"_q,
+		u"steam"_q,
+		u"twitch"_q,
+	};
+	return ranges::contains(known, platform);
+}
+
+void PaintGlobe(QPainter &p, const QRectF &rect, const QColor &color) {
+	auto pen = QPen(color);
+	pen.setWidthF(rect.width() * 0.075);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	p.drawEllipse(rect);
+	const auto center = rect.center();
+	p.drawLine(
+		QPointF(rect.left(), center.y()),
+		QPointF(rect.right(), center.y()));
+	p.drawEllipse(QRectF(
+		center.x() - rect.width() * 0.22,
+		rect.top(),
+		rect.width() * 0.44,
+		rect.height()));
+	const auto latitude = rect.height() * 0.24;
+	const auto inset = rect.width() * 0.09;
+	p.drawLine(
+		QPointF(rect.left() + inset, center.y() - latitude),
+		QPointF(rect.right() - inset, center.y() - latitude));
+	p.drawLine(
+		QPointF(rect.left() + inset, center.y() + latitude),
+		QPointF(rect.right() - inset, center.y() + latitude));
+}
+
+[[nodiscard]] QImage GeneratedIcon(const QString &platform, int pixels) {
+	auto result = QImage(
+		QSize(pixels, pixels),
+		QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	auto p = QPainter(&result);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto domain = (platform == u"domain"_q);
+	const auto rect = QRectF(0, 0, pixels, pixels);
+	const auto radius = pixels * 0.233;
+	p.setPen(Qt::NoPen);
+	p.setBrush(domain ? QColor(51, 120, 245) : QColor(82, 82, 82));
+	p.drawRoundedRect(rect, radius, radius);
+	if (domain) {
+		const auto side = pixels * 0.52;
+		PaintGlobe(
+			p,
+			QRectF(
+				(pixels - side) / 2.,
+				(pixels - side) / 2.,
+				side,
+				side),
+			QColor(255, 255, 255));
+	} else {
+		const auto letter = LinkedPlatformTitle(platform).left(1).toUpper();
+		auto font = st::semiboldFont->f;
+		font.setPixelSize(std::max(int(std::round(pixels * 0.47)), 1));
+		p.setFont(font);
+		p.setPen(QColor(255, 255, 255));
+		p.drawText(rect, Qt::AlignCenter, letter);
+	}
+	p.end();
+	return result;
+}
+
+} // namespace
+
+QString LinkedPlatformName(const QString &platform) {
+	return (platform == u"domain"_q)
+		? Tr(u"Domain"_q)
+		: LinkedPlatformTitle(platform);
+}
+
+QImage LinkedPlatformIcon(const QString &platform, int size) {
+	static auto cache = base::flat_map<QString, QImage>();
+	const auto ratio = style::DevicePixelRatio();
+	const auto pixels = std::max(size, 1) * ratio;
+	const auto key = platform + QChar('/') + QString::number(pixels);
+	if (const auto i = cache.find(key); i != end(cache)) {
+		return i->second;
+	}
+	auto result = QImage();
+	if (HasBundledIcon(platform)) {
+		const auto path = u":/tele/platforms/"_q + platform + u".png"_q;
+		if (QFile::exists(path)) {
+			result = QImage(path).scaled(
+				pixels,
+				pixels,
+				Qt::IgnoreAspectRatio,
+				Qt::SmoothTransformation);
+		}
+	}
+	if (result.isNull()) {
+		result = GeneratedIcon(platform, pixels);
+	}
+	result = result.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+	result.setDevicePixelRatio(ratio);
+	cache.emplace(key, result);
+	return result;
+}
+
+void PaintLinkedVerified(QPainter &p, const QRectF &rect, const QColor &color) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto width = std::max(rect.width() * 0.1, 1.);
+	auto pen = QPen(color);
+	pen.setWidthF(width);
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	const auto inner = rect.marginsRemoved(QMarginsF(
+		width / 2.,
+		width / 2.,
+		width / 2.,
+		width / 2.));
+	p.drawEllipse(inner);
+	auto check = QPainterPath();
+	check.moveTo(
+		inner.left() + inner.width() * 0.28,
+		inner.top() + inner.height() * 0.52);
+	check.lineTo(
+		inner.left() + inner.width() * 0.44,
+		inner.top() + inner.height() * 0.67);
+	check.lineTo(
+		inner.left() + inner.width() * 0.73,
+		inner.top() + inner.height() * 0.36);
+	p.drawPath(check);
+}
+
+void PaintLinkedExternalArrow(
+		QPainter &p,
+		const QRectF &rect,
+		const QColor &color) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto pen = QPen(color);
+	pen.setWidthF(std::max(rect.width() * 0.13, 1.));
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	const auto from = QPointF(
+		rect.left() + rect.width() * 0.15,
+		rect.top() + rect.height() * 0.85);
+	const auto to = QPointF(
+		rect.left() + rect.width() * 0.85,
+		rect.top() + rect.height() * 0.15);
+	p.drawLine(from, to);
+	auto head = QPainterPath();
+	head.moveTo(rect.left() + rect.width() * 0.3, to.y());
+	head.lineTo(to);
+	head.lineTo(to.x(), rect.top() + rect.height() * 0.7);
+	p.drawPath(head);
+}
+
+} // namespace Tele
