+[[nodiscard]] std::optional<LinkedAccount> AccountFromObject(
+		const QJsonObject &object,
+		int index) {
+	auto displayName = Text(object, "displayName");
+	if (displayName.isEmpty()) {
+		displayName = Text(object, "display_name");
+	}
+	const auto label = Text(object, "label");
+	const auto icon = Text(object, "icon");
+	const auto position = object.value(QStringLiteral("position"));
+	auto account = LinkedAccount{
+		.id = Id(object.value(QStringLiteral("id"))),
+		.platform = Text(object, "platform"),
+		.handle = Text(object, "handle"),
+		.displayName = displayName,
+		.url = Text(object, "url"),
+		.label = (label == QStringLiteral("name"))
+			? label
+			: QStringLiteral("handle"),
+		.icon = (icon == QStringLiteral("favicon"))
+			? icon
+			: QStringLiteral("default"),
+		.position = position.isDouble() ? position.toInt() : index,
+		.verified = Flag(object.value(QStringLiteral("verified")), false),
+		.visible = Flag(object.value(QStringLiteral("visible")), true),
+		.hiddenByAdmin = Flag(
+			object.value(QStringLiteral("hiddenByAdmin")),
+			false),
+	};
+	if (account.id.isEmpty() || account.platform.isEmpty()) {
+		return std::nullopt;
+	} else if (!IsSafeLinkedUrl(account.url)) {
+		account.url = QString();
+	}
+	return account;
+}
