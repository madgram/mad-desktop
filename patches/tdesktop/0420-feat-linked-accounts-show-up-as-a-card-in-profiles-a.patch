+	save->setClickedCallback([=] {
+		const auto visible = state->visibleDraft.current();
+		const auto label = state->labelDraft.current();
+		const auto report = crl::guard(context.box, [=](QString error) {
+			ShowToast(context, error);
+		});
+		if (visible != account.visible) {
+			service->setVisible(id, visible, report);
