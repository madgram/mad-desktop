+[[nodiscard]] QPainterPath RowShape(QSize size, bool first, bool last) {
+	const auto radius = CardScaled(kCardRadius) * 1.;
+	auto result = QPainterPath();
+	const auto width = size.width() * 1.;
+	const auto height = size.height() * 1.;
+	if (first && last) {
+		result.addRoundedRect(QRectF(0, 0, width, height), radius, radius);
+	} else if (first) {
+		result.addRoundedRect(
+			QRectF(0, 0, width, height + radius),
+			radius,
+			radius);
+	} else if (last) {
+		result.addRoundedRect(
+			QRectF(0, -radius, width, height + radius),
+			radius,
+			radius);
+	} else {
+		result.addRect(QRectF(0, 0, width, height));
+	}
+	return result;
 }
 
