+	const auto pixels = e->pixelDelta();
+	const auto angle = e->angleDelta();
+	const auto shift = e->modifiers().testFlag(Qt::ShiftModifier);
+	auto delta = 0.;
+	if (!pixels.isNull()) {
+		delta = pixels.x() ? pixels.x() : (shift ? pixels.y() : 0);
+	} else {
+		delta = (angle.x() ? angle.x() : (shift ? angle.y() : 0))
+			* CardScaled(60) / 120.;
+	}
+	if (fits() || !delta) {
+		e->ignore();
+		return;
+	}
+	scrollTo(_scrollTarget - delta, false);
+	e->accept();
