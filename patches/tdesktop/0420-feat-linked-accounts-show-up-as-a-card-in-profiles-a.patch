+void LinkedAccountsBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto service = &LinkedAccountsService::For(&controller->session());
+	const auto state = box->lifetime().make_state<State>();
+	const auto context = Context{
+		.box = box,
+		.controller = controller,
+		.service = service,
+		.state = state,
+	};
+	state->stack.push_back({ .type = PageType::Accounts });
+	box->setWidth(CardScaled(kBoxWidth));
+	box->setMaxHeight(CardScaled(kMaxHeight));
+	const auto boxStyle = box->lifetime().make_state<style::Box>(
+		st::defaultBox);
+	boxStyle->buttonPadding = QMargins();
+	boxStyle->buttonHeight = 0;
+	box->setStyle(*boxStyle);
+	box->setNoContentMargin(true);
+	box->setPinnedToTopContent(MakeHeader(context, box));
+	state->footer = box->setPinnedToBottomContent(
+		object_ptr<Ui::VerticalLayout>(box)).get();
+	service->mineUpdates() | rpl::on_next([=] {
+		const auto type = state->stack.back().type;
+		if (type == PageType::Accounts || type == PageType::Add) {
+			ScheduleRebuild(context);
+		}
+	}, box->lifetime());
+	Rebuild(context);
+	service->loadMine();
+}
