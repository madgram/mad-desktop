+[[nodiscard]] object_ptr<Ui::RpWidget> MakeListCard(
+		QWidget *parent,
+		const std::vector<LinkedAccount> &accounts) {
+	auto result = object_ptr<Ui::RpWidget>(parent);
+	const auto raw = result.data();
+	const auto count = int(accounts.size());
+	const auto rowHeight = CardScaled(kRowHeight);
+	auto rows = std::vector<not_null<PaintedButton*>>();
+	for (auto i = 0; i != count; ++i) {
+		const auto account = accounts[i];
+		const auto first = (i == 0);
+		const auto last = (i + 1 == count);
+		const auto row = Ui::CreateChild<PaintedButton>(raw, [=](
+				QPainter &p,
+				QRect rect,
+				bool over) {
+			PaintListRow(
+				p,
+				rect.size(),
+				account,
+				over && !account.url.isEmpty(),
+				first,
+				last);
+		});
+		row->setPointerCursor(!account.url.isEmpty());
+		row->setClickedCallback([=] {
+			OpenAccount(account);
+		});
+		rows.push_back(row);
+	}
+	raw->resize(raw->width(), rowHeight * count);
+	raw->widthValue() | rpl::on_next([=](int width) {
+		for (auto i = 0; i != int(rows.size()); ++i) {
+			rows[i]->setGeometry(0, i * rowHeight, width, rowHeight);
+		}
+	}, raw->lifetime());
+	return result;
+}
 
