+void AddRadioRow(
+		not_null<Ui::VerticalLayout*> content,
+		const QString &text,
+		const QString &value,
+		rpl::producer<bool> checked,
+		bool first,
+		Fn<void()> clicked) {
+	const auto state = std::make_shared<bool>(false);
+	const auto row = content->add(object_ptr<PaintedButton>(
+		content,
+		[=](QPainter &p, QRect rect, bool over) {
+			const auto width = rect.width();
+			const auto height = rect.height();
+			if (first) {
+				PaintSeparator(p, width, 0);
+			}
+			PaintSeparator(p, width, height - st::lineWidth);
+			const auto side = CardScaled(kSide);
+			const auto radio = CardScaled(kRadioSize);
+			PaintCardRadio(
+				p,
+				QRectF(side, (height - radio) / 2., radio, radio),
+				*state);
+			const auto left = side + radio + CardScaled(14);
+			const auto font = CardFont(15, false);
+			const auto valueFont = CardFont(14, false);
+			const auto valueWidth = value.isEmpty()
+				? 0
+				: std::min(
+					valueFont->width(value),
+					std::max(width - left - side, 0) / 2);
+			p.setFont(font);
+			p.setPen(st::windowFg);
+			p.drawText(
+				left,
+				(height - font->height) / 2 + font->ascent,
+				font->elided(
+					text,
+					std::max(
+						width - left - side - valueWidth - CardScaled(8),
+						0)));
+			if (valueWidth) {
+				p.setFont(valueFont);
+				p.setPen(st::windowSubTextFg);
+				p.drawText(
+					width - side - valueWidth,
+					(height - valueFont->height) / 2 + valueFont->ascent,
+					valueFont->elided(value, valueWidth));
+			}
+		}));
+	row->resize(row->width(), CardScaled(kRadioRowHeight));
+	row->setClickedCallback(std::move(clicked));
+	std::move(checked) | rpl::on_next([=](bool value) {
+		*state = value;
+		row->update();
+	}, row->lifetime());
+}
