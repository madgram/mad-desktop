+void FillAccount(Context context, not_null<Ui::VerticalLayout*> content) {
+	const auto service = context.service;
+	const auto state = context.state;
+	const auto id = state->stack.back().id;
+	const auto found = FindAccount(service, id);
+	if (!found) {
+		crl::on_main(context.box, [=] {
+			Back(context);
+		});
+		return;
+	}
+	const auto account = *found;
+	const auto platform = LinkedPlatformName(account.platform);
+	state->title = Tr(u"Account visibility"_q);
+	state->visibleDraft = account.visible;
+	state->labelDraft = account.label;
+
+	AddSkip(content, 20);
+	const auto header = content->add(object_ptr<Ui::RpWidget>(content));
+	header->resize(header->width(), CardScaled(128));
+	header->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(header);
+		const auto width = header->width();
+		const auto icon = CardScaled(64);
+		p.drawImage(
+			QRect((width - icon) / 2, 0, icon, icon),
+			LinkedPlatformIcon(account.platform, icon));
+		const auto titleFont = CardFont(22, true);
+		const auto subtitleFont = CardFont(14, false);
+		const auto verified = account.verified ? CardScaled(18) : 0;
+		const auto verifiedSkip = verified ? (verified + CardScaled(6)) : 0;
+		const auto available = std::max(
+			width - 2 * CardScaled(kSide) - verifiedSkip,
+			0);
+		const auto title = titleFont->elided(platform, available);
+		const auto titleWidth = titleFont->width(title) + verifiedSkip;
+		const auto titleLeft = (width - titleWidth) / 2;
+		const auto titleTop = icon + CardScaled(12);
+		p.setFont(titleFont);
+		p.setPen(st::windowBoldFg);
+		p.drawText(titleLeft, titleTop + titleFont->ascent, title);
+		if (verified) {
+			PaintLinkedVerified(
+				p,
+				QRectF(
+					titleLeft + titleFont->width(title) + CardScaled(6),
+					titleTop + (titleFont->height - verified) / 2.,
+					verified,
+					verified),
+				st::windowActiveTextFg->c);
+		}
+		const auto subtitle = subtitleFont->elided(
+			LinkedAccountTitle(account),
+			std::max(width - 2 * CardScaled(kSide), 0));
+		p.setFont(subtitleFont);
+		p.setPen(st::windowSubTextFg);
+		p.drawText(
+			(width - subtitleFont->width(subtitle)) / 2,
+			titleTop + titleFont->height + CardScaled(4)
+				+ subtitleFont->ascent,
+			subtitle);
+	}, header->lifetime());
+	AddSkip(content, 8);
+
+	AddLabel(
+		content,
+		Tr(u"Who can see this account?"_q),
+		CardTitleStyle(),
+		Side());
+	AddSkip(content, 10);
+	AddRadioRow(
+		content,
+		Tr(u"Everyone"_q),
+		QString(),
+		state->visibleDraft.value(),
+		true,
+		[=] { state->visibleDraft = true; });
+	AddRadioRow(
+		content,
+		Tr(u"Only me"_q),
+		QString(),
+		state->visibleDraft.value() | rpl::map(!rpl::mappers::_1),
+		false,
+		[=] { state->visibleDraft = false; });
+	AddSkip(content, 10);
+	const auto caption = AddLabel(
+		content,
+		QString(),
+		CardCaptionStyle(),
+		Side());
+	state->visibleDraft.value() | rpl::on_next([=](bool visible) {
+		caption->setText(visible
+			? Tr(u"Everyone using mad sees %1 in your profile."_q).arg(
+				platform)
+			: Tr(u"Only you see %1. It is hidden from your profile."_q).arg(
+				platform));
+	}, caption->lifetime());
+
+	if (LinkedAccountHasLabelChoice(account)) {
+		AddSkip(content, 20);
+		AddLabel(
+			content,
+			Tr(u"Shown in profile as"_q),
+			CardTitleStyle(),
+			Side());
+		AddSkip(content, 10);
+		AddRadioRow(
+			content,
+			(account.platform == u"steam"_q)
+				? Tr(u"Profile URL"_q)
+				: Tr(u"Username"_q),
+			account.handle,
+			state->labelDraft.value() | rpl::map([](const QString &label) {
+				return (label != u"name"_q);
+			}),
+			true,
+			[=] { state->labelDraft = u"handle"_q; });
+		AddRadioRow(
+			content,
+			Tr(u"Display name"_q),
+			account.displayName,
+			state->labelDraft.value() | rpl::map([](const QString &label) {
+				return (label == u"name"_q);
+			}),
+			false,
+			[=] { state->labelDraft = u"name"_q; });
+	}
+
+	AddSkip(content, 20);
+	AddLabel(content, Tr(u"Preview"_q), CardTitleStyle(), Side());
+	AddSkip(content, 10);
+	const auto preview = content->add(object_ptr<Ui::RpWidget>(content));
+	preview->resize(preview->width(), CardScaled(48));
+	preview->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(preview);
+		auto hq = PainterHighQualityEnabler(p);
+		auto shown = account;
+		shown.label = state->labelDraft.current();
+		const auto text = LinkedAccountTitle(shown);
+		const auto font = CardFont(14, true);
+		const auto icon = CardScaled(24);
+		const auto padding = CardScaled(12);
+		const auto verified = account.verified ? CardScaled(13) : 0;
+		const auto side = CardScaled(kSide);
+		const auto maxText = std::max(
+			preview->width() - 2 * side - 2 * padding - icon
+				- CardScaled(8) - (verified ? verified + CardScaled(4) : 0),
+			0);
+		const auto elided = font->elided(text, maxText);
+		const auto chip = 2 * padding
+			+ icon
+			+ CardScaled(8)
+			+ font->width(elided)
+			+ (verified ? verified + CardScaled(4) : 0);
+		const auto rect = QRect(side, 0, chip, preview->height());
+		const auto radius = CardScaled(kCardRadius) * 1.;
+		p.setPen(Qt::NoPen);
+		p.setOpacity(state->visibleDraft.current() ? 1. : 0.5);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(QRectF(rect), radius, radius);
+		p.drawImage(
+			QRect(
+				rect.x() + padding,
+				(rect.height() - icon) / 2,
+				icon,
+				icon),
+			LinkedPlatformIcon(account.platform, icon));
+		const auto textLeft = rect.x() + padding + icon + CardScaled(8);
+		p.setFont(font);
+		p.setPen(st::windowBoldFg);
+		p.drawText(
+			textLeft,
+			(rect.height() - font->height) / 2 + font->ascent,
+			elided);
+		if (verified) {
+			PaintLinkedVerified(
+				p,
+				QRectF(
+					textLeft + font->width(elided) + CardScaled(4),
+					(rect.height() - verified) / 2.,
+					verified,
+					verified),
+				st::windowActiveTextFg->c);
+		}
+		p.setOpacity(1.);
+	}, preview->lifetime());
+	rpl::merge(
+		state->visibleDraft.changes() | rpl::to_empty,
+		state->labelDraft.changes() | rpl::to_empty
+	) | rpl::on_next([=] {
+		preview->update();
+	}, preview->lifetime());
+
+	AddSkip(content, 18);
+	const auto links = content->add(
+		object_ptr<Ui::RpWidget>(content),
+		Side());
+	auto linkButtons = std::vector<not_null<Ui::LinkButton*>>();
+	if (!account.url.isEmpty()) {
+		const auto open = Ui::CreateChild<Ui::LinkButton>(
+			links,
+			Tr(u"Open profile"_q));
+		const auto url = account.url;
+		open->setClickedCallback([=] {
+			UrlClickHandler::Open(url);
+		});
+		linkButtons.push_back(open);
+	}
+	const auto refresh = Ui::CreateChild<Ui::LinkButton>(
+		links,
+		Tr(u"Refresh details"_q));
+	refresh->setClickedCallback([=] {
+		const auto platformId = account.platform;
+		service->refreshAccount(id, crl::guard(context.box, [=](
+				QString error,
+				bool reconnect) {
+			if (reconnect) {
+				for (const auto &item : service->platforms()) {
+					if (item.id == platformId) {
+						StartLink(context, item);
+						return;
+					}
+				}
+				ShowToast(context, Tr(u"Sign in to the platform again."_q));
+			} else if (!error.isEmpty()) {
+				ShowToast(context, error);
+			} else {
+				ShowToast(context, Tr(u"Details updated."_q));
+			}
+		}));
+	});
+	linkButtons.push_back(refresh);
+	links->resize(links->width(), linkButtons.front()->height());
+	links->widthValue() | rpl::on_next([=](int) {
+		auto left = 0;
+		for (const auto &button : linkButtons) {
+			button->moveToLeft(left, 0);
+			left += button->width() + CardScaled(20);
+		}
+	}, links->lifetime());
+	AddSkip(content, 24);
+
+	const auto footer = state->footer;
+	const auto bar = footer->add(object_ptr<Ui::RpWidget>(footer));
+	bar->resize(bar->width(), CardScaled(kFooterHeight));
+	bar->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(bar);
+		p.fillRect(0, 0, bar->width(), st::lineWidth, st::shadowFg);
+	}, bar->lifetime());
+	const auto disconnect = Ui::CreateChild<Ui::RoundButton>(
+		bar,
+		rpl::single(Tr(u"Disconnect"_q)),
+		st::attentionBoxButton);
+	disconnect->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	const auto save = Ui::CreateChild<Ui::RoundButton>(
+		bar,
+		rpl::single(Tr(u"Save"_q)),
+		st::defaultActiveButton);
+	save->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	bar->widthValue() | rpl::on_next([=](int width) {
+		const auto side = CardScaled(kSide) - CardScaled(8);
+		disconnect->moveToLeft(
+			side,
+			(bar->height() - disconnect->height()) / 2,
+			width);
+		save->moveToRight(
+			CardScaled(kSide),
+			(bar->height() - save->height()) / 2,
+			width);
+	}, bar->lifetime());
+	disconnect->setClickedCallback([=] {
+		context.controller->show(Ui::MakeConfirmBox({
+			.text = Tr(u"Disconnect %1? It will disappear from your "
+				"profile."_q).arg(platform),
+			.confirmed = [=](Fn<void()> close) {
