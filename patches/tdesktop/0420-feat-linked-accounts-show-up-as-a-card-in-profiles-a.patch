+void AddCopyCard(
+		Context context,
+		not_null<Ui::VerticalLayout*> content,
+		const QString &caption,
+		const QString &value) {
+	const auto card = content->add(
+		object_ptr<Ui::RpWidget>(content),
+		Side());
+	card->resize(card->width(), CardScaled(64));
+	const auto copy = Ui::CreateChild<Ui::LinkButton>(card, Tr(u"Copy"_q));
+	copy->setClickedCallback([=] {
+		QGuiApplication::clipboard()->setText(value);
+		ShowToast(context, Tr(u"Copied."_q));
+	});
+	card->widthValue() | rpl::on_next([=](int width) {
+		copy->moveToRight(
+			CardScaled(14),
+			(card->height() - copy->height()) / 2,
+			width);
+	}, copy->lifetime());
+	card->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(card);
+		auto hq = PainterHighQualityEnabler(p);
+		const auto radius = CardScaled(kCardRadius) * 1.;
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(QRectF(card->rect()), radius, radius);
+		const auto padding = CardScaled(14);
+		const auto captionFont = CardFont(12, false);
+		const auto valueFont = CardFont(14, true);
+		const auto available = std::max(
+			card->width() - 2 * padding - copy->width() - padding,
+			0);
+		const auto top = (card->height()
+			- captionFont->height
+			- CardScaled(2)
+			- valueFont->height) / 2;
+		p.setFont(captionFont);
+		p.setPen(st::windowSubTextFg);
+		p.drawText(padding, top + captionFont->ascent, caption);
+		p.setFont(valueFont);
+		p.setPen(st::windowBoldFg);
+		p.drawText(
+			padding,
+			top + captionFont->height + CardScaled(2) + valueFont->ascent,
+			valueFont->elided(value, available, Qt::ElideMiddle));
+	}, card->lifetime());
+}
+
+void FillDomainCheck(
+		Context context,
+		not_null<Ui::VerticalLayout*> content) {
+	const auto service = context.service;
+	const auto domain = context.state->stack.back().id;
+	const auto found = FindDraft(service, domain);
+	if (!found) {
+		crl::on_main(context.box, [=] {
+			Back(context);
+		});
+		return;
+	}
+	const auto claim = *found;
+	context.state->title = Tr(u"Verify the domain"_q);
+	AddHeadline(
+		content,
+		claim.displayDomain,
+		Tr(u"Add a TXT record to the domain's DNS. The same record on the "
+			"domain itself works too. DNS can take up to an hour to "
+			"update."_q));
+	AddCopyCard(context, content, Tr(u"Name"_q), claim.recordName);
+	AddSkip(content, 10);
+	AddCopyCard(context, content, Tr(u"Value"_q), claim.recordValue);
+	AddSkip(content, 24);
+
+	const auto footer = context.state->footer;
+	const auto bar = footer->add(object_ptr<Ui::RpWidget>(footer));
+	bar->resize(bar->width(), CardScaled(kFooterHeight));
+	bar->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(bar);
+		p.fillRect(0, 0, bar->width(), st::lineWidth, st::shadowFg);
+	}, bar->lifetime());
+	const auto remove = Ui::CreateChild<Ui::RoundButton>(
+		bar,
+		rpl::single(Tr(u"Delete draft"_q)),
+		st::attentionBoxButton);
+	remove->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	const auto verify = Ui::CreateChild<Ui::RoundButton>(
+		bar,
+		rpl::single(Tr(u"Verify"_q)),
+		st::defaultActiveButton);
+	verify->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	bar->widthValue() | rpl::on_next([=](int width) {
+		remove->moveToLeft(
+			CardScaled(kSide) - CardScaled(8),
+			(bar->height() - remove->height()) / 2,
+			width);
+		verify->moveToRight(
+			CardScaled(kSide),
+			(bar->height() - verify->height()) / 2,
+			width);
+	}, bar->lifetime());
+	remove->setClickedCallback([=] {
+		service->removeDomainDraft(domain);
+		PopToRoot(context);
+	});
+	const auto busy = std::make_shared<bool>(false);
+	verify->setClickedCallback([=] {
+		if (*busy) {
+			return;
+		}
+		*busy = true;
+		const auto shown = claim.displayDomain;
+		service->verifyDomain(domain, crl::guard(verify, [=](
+				QString error) {
+			*busy = false;
+			if (!error.isEmpty()) {
+				ShowToast(context, error);
+				return;
+			}
+			ShowToast(context, Tr(u"%1 linked."_q).arg(shown));
+			PopToRoot(context);
+		}));
+	});
+}
+
+void Rebuild(Context context) {
+	const auto box = context.box;
+	const auto state = context.state;
+	const auto was = box->height();
+	const auto content = box->verticalLayout();
+	content->clear();
+	state->footer->clear();
+	state->canBack = (state->stack.size() > 1);
+	switch (state->stack.back().type) {
+	case PageType::Accounts: FillAccounts(context, content); break;
+	case PageType::Add: FillAdd(context, content); break;
+	case PageType::Account: FillAccount(context, content); break;
+	case PageType::DomainInput: FillDomainInput(context, content); break;
+	case PageType::DomainCheck: FillDomainCheck(context, content); break;
+	}
+	content->resizeToWidth(box->width());
+	state->footer->resizeToWidth(box->width());
+	if (was > 0) {
+		box->animateHeightFrom(was);
+	}
+}
