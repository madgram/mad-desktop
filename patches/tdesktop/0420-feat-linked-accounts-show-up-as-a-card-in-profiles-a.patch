+#include "tele/tele_linked_accounts_service.h"
+
+#include "apiwrap.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_lowercase.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QUrl>
+#include <QtCore/QUrlQuery>
+#include <QtGui/QDesktopServices>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele {
+namespace {
+
+constexpr auto kCacheFor = crl::time(10 * 60 * 1000);
+constexpr auto kMaxBytes = 256 * 1024;
+constexpr auto kBot = "maddtgbot";
+
+[[nodiscard]] QString Base() {
+	return u"https://b.mad.tg"_q;
+}
+
+[[nodiscard]] base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<LinkedAccountsService>> &Services() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<LinkedAccountsService>>();
+	return result;
+}
+
+[[nodiscard]] QString Encoded(const QString &id) {
+	return QString::fromLatin1(QUrl::toPercentEncoding(id));
+}
+
+[[nodiscard]] QByteArray Json(const QJsonObject &object) {
+	return QJsonDocument(object).toJson(QJsonDocument::Compact);
+}
+
+[[nodiscard]] bool Succeeded(int status) {
+	return (status >= 200) && (status < 300);
+}
+
+[[nodiscard]] LinkedProfile PublicProfile(const LinkedProfile &profile) {
+	auto result = LinkedProfile{ .design = profile.design };
+	for (const auto &account : profile.accounts) {
+		if (account.visible && !account.hiddenByAdmin) {
+			result.accounts.push_back(account);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool SameAccount(
+		const LinkedAccount &a,
+		const LinkedAccount &b) {
+	return (a.id == b.id)
+		&& (a.platform == b.platform)
+		&& (a.handle == b.handle)
+		&& (a.displayName == b.displayName)
+		&& (a.url == b.url)
+		&& (a.label == b.label)
+		&& (a.icon == b.icon)
+		&& (a.verified == b.verified)
+		&& (a.visible == b.visible)
+		&& (a.hiddenByAdmin == b.hiddenByAdmin);
+}
+
+[[nodiscard]] bool SameProfile(
+		const LinkedProfile &a,
+		const LinkedProfile &b) {
+	if (a.design != b.design || a.accounts.size() != b.accounts.size()) {
+		return false;
+	}
+	for (auto i = 0; i != int(a.accounts.size()); ++i) {
+		if (!SameAccount(a.accounts[i], b.accounts[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] bool SameDomain(const QString &a, const QString &b) {
+	return !a.isEmpty() && (a.compare(b, Qt::CaseInsensitive) == 0);
+}
+
+} // namespace
+
+LinkedAccountsService::LinkedAccountsService(
+	not_null<Main::Session*> session)
+: _session(session) {
+}
+
+LinkedAccountsService &LinkedAccountsService::For(
+		not_null<Main::Session*> session) {
+	auto &services = Services();
+	const auto i = services.find(session);
+	if (i != end(services)) {
+		return *i->second;
+	}
+	const auto result = services.emplace(
+		session,
+		std::make_unique<LinkedAccountsService>(session)).first->second.get();
+	session->lifetime().add([=] {
+		Services().remove(session);
+	});
+	return *result;
+}
+
+bool LinkedAccountsService::available() const {
+	return !OfflineForLaunch() && !ServerOffForLaunch();
+}
+
+void LinkedAccountsService::request(
+		const QString &method,
+		const QString &path,
+		const QByteArray &body,
+		Done done) {
+	if (!available()) {
+		done(0, QByteArray());
+		return;
+	}
+	auto request = QNetworkRequest(QUrl(Base() + path));
+	request.setHeader(
+		QNetworkRequest::ContentTypeHeader,
+		u"application/json"_q);
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(20000);
+	if (!_token.isEmpty()) {
+		request.setRawHeader("Authorization", "Bearer " + _token.toUtf8());
+	}
+	const auto reply = _network.sendCustomRequest(
+		request,
+		method.toLatin1(),
+		body);
+	QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+		const auto bytes = reply->read(kMaxBytes);
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		reply->deleteLater();
+		done(status, bytes);
+	});
+}
+
+void LinkedAccountsService::authorized(
+		const QString &method,
+		const QString &path,
+		const QByteArray &body,
+		Done done) {
+	const auto weak = base::make_weak(this);
+	withToken([=](QString token) {
+		if (!weak) {
+			return;
+		} else if (token.isEmpty()) {
+			done(0, QByteArray());
+			return;
+		}
+		request(method, path, body, [=](int status, QByteArray bytes) {
+			if (status == 401) {
+				_token = QString();
+			}
+			done(status, bytes);
+		});
+	});
+}
+
+void LinkedAccountsService::withToken(Fn<void(QString)> done) {
+	if (!available()) {
+		done(QString());
+		return;
+	} else if (!_token.isEmpty()) {
+		done(_token);
+		return;
+	}
+	_tokenWaiters.push_back(std::move(done));
+	if (!_authorizing) {
+		authorize();
+	}
+}
+
+void LinkedAccountsService::authorize() {
+	_authorizing = true;
+	const auto name = QString::fromLatin1(kBot);
+	if (const auto peer = _session->data().peerByUsername(name)) {
+		if (const auto bot = peer->asUser()) {
+			requestWebView(bot);
+			return;
+		}
+	}
+	const auto weak = base::make_weak(this);
+	_session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(0),
+		MTP_string(name),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		if (!weak) {
+			return;
+		}
+		const auto &data = result.data();
+		_session->data().processUsers(data.vusers());
+		_session->data().processChats(data.vchats());
+		const auto peer = _session->data().peerLoaded(
+			peerFromMTP(data.vpeer()));
+		if (const auto bot = peer ? peer->asUser() : nullptr) {
+			requestWebView(bot);
+		} else {
+			finishAuthorize(QString());
+		}
+	}).fail([=] {
+		if (weak) {
+			finishAuthorize(QString());
+		}
+	}).send();
+}
+
+void LinkedAccountsService::requestWebView(not_null<UserData*> bot) {
+	const auto weak = base::make_weak(this);
+	_session->api().request(MTPmessages_RequestMainWebView(
+		MTP_flags(0),
+		bot->input(),
+		bot->inputUser(),
+		MTPstring(),
+		MTPDataJSON(),
+		MTP_string("tdesktop")
+	)).done([=](const MTPWebViewResult &result) {
+		if (!weak) {
+			return;
+		}
+		const auto initData = InitDataFromWebViewUrl(
+			qs(result.data().vurl()));
+		if (initData.isEmpty()) {
+			finishAuthorize(QString());
+			return;
+		}
+		const auto body = Json(QJsonObject{
+			{ u"initData"_q, initData },
+		});
+		request(u"POST"_q, u"/api/v1/auth/telegram"_q, body, [=](
+				int status,
+				QByteArray bytes) {
+			finishAuthorize((status == 200)
+				? ParseLinkedToken(bytes)
+				: QString());
+		});
+	}).fail([=] {
+		if (weak) {
+			finishAuthorize(QString());
+		}
+	}).send();
+}
+
+void LinkedAccountsService::finishAuthorize(const QString &token) {
+	_authorizing = false;
+	_token = token;
+	if (token.isEmpty()) {
+		_error = Tr(u"Could not sign in to b.mad.tg."_q);
+		_mineUpdates.fire({});
+	}
+	for (const auto &callback : base::take(_tokenWaiters)) {
+		callback(token);
+	}
+}
+
+const LinkedProfile &LinkedAccountsService::profile(UserId id) {
+	auto &cached = _profiles[id];
+	if (!cached.loading
+		&& (!cached.loaded || crl::now() - cached.loaded > kCacheFor)) {
+		fetchProfile(id);
+	}
+	return _profiles[id].profile;
+}
+
+rpl::producer<UserId> LinkedAccountsService::profileUpdates() const {
+	return _profileUpdates.events();
+}
+
+void LinkedAccountsService::fetchProfile(UserId id) {
+	_profiles[id].loading = true;
+	const auto weak = base::make_weak(this);
+	const auto path = u"/api/v1/profiles/%1"_q.arg(id.bare);
+	authorized(u"GET"_q, path, QByteArray(), [=](
+			int status,
+			QByteArray bytes) {
+		if (!weak) {
+			return;
+		}
+		auto &cached = _profiles[id];
+		cached.loading = false;
+		cached.loaded = crl::now();
+		auto profile = LinkedProfile{ .design = u"row"_q };
+		if (status == 200) {
+			profile = PublicProfile(ParseLinkedProfile(bytes));
+		} else if (status != 404) {
+			return;
+		}
+		if (!SameProfile(profile, cached.profile)) {
+			cached.profile = std::move(profile);
+			_profileUpdates.fire_copy(id);
+		}
+	});
+}
+
+void LinkedAccountsService::loadMine() {
+	++_busy;
+	_error = available()
+		? QString()
+		: Tr(u"The mad server is off for this launch."_q);
+	_mineUpdates.fire({});
+	fetchPlatforms();
+	const auto weak = base::make_weak(this);
+	authorized(u"GET"_q, u"/api/v1/me/accounts"_q, QByteArray(), [=](
+			int status,
+			QByteArray bytes) {
+		if (!weak) {
+			return;
+		}
+		--_busy;
+		if (status == 200) {
+			applyMine(ParseLinkedProfile(bytes));
+			return;
+		} else if (_error.isEmpty()) {
+			_error = Tr(u"Could not load your accounts."_q);
+		}
+		_mineUpdates.fire({});
+	});
+}
+
+void LinkedAccountsService::fetchPlatforms() {
+	if (!_platforms.empty()) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	request(u"GET"_q, u"/api/v1/platforms"_q, QByteArray(), [=](
+			int status,
+			QByteArray bytes) {
+		if (weak && status == 200) {
+			_platforms = ParseLinkedPlatforms(bytes);
+			_mineUpdates.fire({});
+		}
+	});
+}
+
+const LinkedProfile &LinkedAccountsService::mine() const {
+	return _mine;
+}
+
+bool LinkedAccountsService::mineLoaded() const {
+	return _mineLoaded;
+}
+
+const std::vector<LinkedPlatform> &LinkedAccountsService::platforms() const {
+	return _platforms;
+}
+
+QString LinkedAccountsService::error() const {
+	return _error;
+}
+
+bool LinkedAccountsService::busy() const {
+	return _busy > 0;
+}
+
+rpl::producer<> LinkedAccountsService::mineUpdates() const {
+	return _mineUpdates.events();
+}
+
+void LinkedAccountsService::applyMine(LinkedProfile profile) {
+	_mine = std::move(profile);
+	_mineLoaded = true;
+	for (const auto &account : _mine.accounts) {
+		if (account.platform != u"domain"_q) {
+			continue;
+		}
+		_domainDrafts.erase(ranges::remove_if(
+			_domainDrafts,
+			[&](const LinkedDomainClaim &claim) {
+				return SameDomain(claim.domain, account.handle)
+					|| SameDomain(claim.displayDomain, account.handle);
+			}), end(_domainDrafts));
+	}
+	publishOwn();
+	_mineUpdates.fire({});
+}
+
+void LinkedAccountsService::publishOwn() {
+	const auto id = _session->userId();
+	auto &cached = _profiles[id];
+	cached.profile = PublicProfile(_mine);
+	cached.loaded = crl::now();
+	_profileUpdates.fire_copy(id);
+}
+
+void LinkedAccountsService::update(
+		const QString &id,
+		const QByteArray &body,
+		LinkedProfile changed,
+		Fn<void(QString)> done) {
+	const auto previous = _mine;
+	applyMine(std::move(changed));
+	const auto weak = base::make_weak(this);
+	const auto path = u"/api/v1/me/accounts/"_q + Encoded(id);
+	authorized(u"PATCH"_q, path, body, [=](int status, QByteArray) {
+		if (!weak) {
+			return;
+		} else if (Succeeded(status)) {
+			if (done) {
+				done(QString());
+			}
+			return;
+		}
+		applyMine(previous);
+		if (done) {
+			done(Tr(u"Could not save the change."_q));
+		}
+	});
+}
+
+void LinkedAccountsService::setVisible(
+		const QString &id,
+		bool visible,
+		Fn<void(QString)> done) {
+	auto changed = _mine;
+	for (auto &account : changed.accounts) {
+		if (account.id == id) {
+			account.visible = visible;
+		}
+	}
+	update(
+		id,
+		Json(QJsonObject{ { u"visible"_q, visible } }),
+		std::move(changed),
+		std::move(done));
+}
+
+void LinkedAccountsService::setLabel(
+		const QString &id,
+		const QString &label,
+		Fn<void(QString)> done) {
+	auto changed = _mine;
+	for (auto &account : changed.accounts) {
+		if (account.id == id) {
+			account.label = label;
+		}
+	}
+	update(
+		id,
+		Json(QJsonObject{ { u"label"_q, label } }),
+		std::move(changed),
+		std::move(done));
+}
+
+void LinkedAccountsService::setDesign(
+		const QString &design,
+		Fn<void(QString)> done) {
+	const auto previous = _mine;
+	auto changed = _mine;
+	changed.design = design;
+	applyMine(std::move(changed));
+	const auto weak = base::make_weak(this);
+	const auto body = Json(QJsonObject{ { u"design"_q, design } });
+	authorized(u"PUT"_q, u"/api/v1/me/settings"_q, body, [=](
+			int status,
+			QByteArray) {
+		if (!weak) {
+			return;
+		} else if (Succeeded(status)) {
+			if (done) {
+				done(QString());
+			}
+			return;
+		}
+		applyMine(previous);
+		if (done) {
+			done(Tr(u"Could not save the change."_q));
+		}
+	});
+}
+
+void LinkedAccountsService::remove(
+		const QString &id,
+		Fn<void(QString)> done) {
+	const auto weak = base::make_weak(this);
+	const auto path = u"/api/v1/me/accounts/"_q + Encoded(id);
+	authorized(u"DELETE"_q, path, QByteArray(), [=](int status, QByteArray) {
+		if (!weak) {
+			return;
+		} else if (Succeeded(status) || status == 404) {
+			auto changed = _mine;
+			changed.accounts.erase(ranges::remove_if(
+				changed.accounts,
+				[&](const LinkedAccount &account) {
+					return (account.id == id);
+				}), end(changed.accounts));
+			applyMine(std::move(changed));
+			if (done) {
+				done(QString());
+			}
+			return;
+		}
+		if (done) {
+			done(Tr(u"Could not unlink the account."_q));
+		}
+	});
+}
+
+void LinkedAccountsService::refreshAccount(
+		const QString &id,
+		Fn<void(QString error, bool reconnect)> done) {
+	const auto weak = base::make_weak(this);
+	const auto path = u"/api/v1/me/accounts/"_q + Encoded(id) + u"/refresh"_q;
+	authorized(u"POST"_q, path, QByteArray(), [=](
+			int status,
+			QByteArray bytes) {
+		if (!weak) {
+			return;
+		} else if (Succeeded(status)) {
+			if (const auto fresh = ParseLinkedAccount(bytes)) {
+				auto changed = _mine;
+				for (auto &account : changed.accounts) {
+					if (account.id == fresh->id) {
+						const auto position = account.position;
+						account = *fresh;
+						account.position = position;
+					}
+				}
+				applyMine(std::move(changed));
+			}
+			done(QString(), false);
+		} else if (status == 409) {
+			done(QString(), true);
+		} else {
+			done(Tr(u"Could not refresh the account."_q), false);
+		}
+	});
+}
+
+void LinkedAccountsService::link(
+		const QString &platform,
+		const QString &clientId) {
+	const auto weak = base::make_weak(this);
+	withToken([=](QString token) {
+		if (!weak || token.isEmpty()) {
+			return;
+		}
+		auto query = QUrlQuery();
+		query.addQueryItem(u"token"_q, token);
+		if (!clientId.isEmpty()) {
+			query.addQueryItem(u"client_id"_q, clientId);
+		}
+		auto url = QUrl(Base()
+			+ u"/api/v1/connect/"_q
+			+ Encoded(platform)
+			+ u"/start"_q);
+		url.setQuery(query);
+		QDesktopServices::openUrl(url);
+	});
+}
+
+void LinkedAccountsService::claimDomain(
+		const QString &domain,
+		Fn<void(std::optional<LinkedDomainClaim>, QString)> done) {
+	const auto weak = base::make_weak(this);
+	const auto body = Json(QJsonObject{ { u"domain"_q, domain.trimmed() } });
+	authorized(u"POST"_q, u"/api/v1/me/domains"_q, body, [=](
+			int status,
+			QByteArray bytes) {
+		if (!weak) {
+			return;
+		} else if (Succeeded(status)) {
+			if (const auto claim = ParseLinkedDomainClaim(bytes)) {
+				addDomainDraft(*claim);
+				done(*claim, QString());
+				return;
+			}
+		} else if (status == 400) {
+			done(std::nullopt, Tr(u"That doesn't look like a domain."_q));
+			return;
+		}
+		done(std::nullopt, Tr(u"Could not start the domain check."_q));
+	});
+}
+
+void LinkedAccountsService::verifyDomain(
+		const QString &domain,
+		Fn<void(QString)> done) {
+	const auto weak = base::make_weak(this);
+	const auto body = Json(QJsonObject{ { u"domain"_q, domain } });
+	authorized(u"POST"_q, u"/api/v1/me/domains/verify"_q, body, [=](
+			int status,
+			QByteArray) {
+		if (!weak) {
+			return;
+		} else if (Succeeded(status)) {
+			removeDomainDraft(domain);
+			loadMine();
+			done(QString());
+		} else if (status == 422) {
+			done(Tr(u"The record isn't visible yet. Wait a bit and check "
+				"again."_q));
+		} else {
+			done(Tr(u"Could not check the domain."_q));
+		}
+	});
+}
+
+const std::vector<LinkedDomainClaim> &LinkedAccountsService::domainDrafts(
+) const {
+	return _domainDrafts;
+}
+
+void LinkedAccountsService::addDomainDraft(const LinkedDomainClaim &claim) {
+	removeDomainDraft(claim.domain);
+	_domainDrafts.push_back(claim);
+	_mineUpdates.fire({});
+}
+
+void LinkedAccountsService::removeDomainDraft(const QString &domain) {
+	const auto was = _domainDrafts.size();
+	_domainDrafts.erase(ranges::remove_if(
+		_domainDrafts,
+		[&](const LinkedDomainClaim &claim) {
+			return SameDomain(claim.domain, domain)
+				|| SameDomain(claim.displayDomain, domain);
+		}), end(_domainDrafts));
+	if (_domainDrafts.size() != was) {
+		_mineUpdates.fire({});
+	}
+}
+
+void LinkedAccountsService::invalidate() {
+	_profiles.clear();
+	loadMine();
+}
+
+} // namespace Tele
