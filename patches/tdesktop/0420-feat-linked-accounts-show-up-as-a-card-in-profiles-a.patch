+
+constexpr auto kSegmentHeight = 36;
+constexpr auto kSegmentRadius = 10;
+constexpr auto kSegmentInset = 3;
+constexpr auto kChipHeight = 34;
+constexpr auto kChipPadding = 14;
+constexpr auto kChipGap = 8;
+constexpr auto kChipRadius = 10;
+constexpr auto kSlideDuration = crl::time(160);
+
+[[nodiscard]] style::FlatLabel LabelStyle(
+		const style::FlatLabel &base,
+		const style::color &color,
+		int size,
+		bool semibold) {
+	auto result = base;
+	result.textFg = color;
+	result.minWidth = 0;
+	result.maxHeight = 0;
+	result.style.font = CardFont(size, semibold);
+	result.style.lineHeight = 0;
+	return result;
+}
+
+} // namespace
+
+int CardScaled(int value) {
+	return style::ConvertScale(value, style::Scale());
+}
+
+style::font CardFont(int size, bool semibold) {
+	const auto &base = semibold ? st::semiboldFont : st::normalFont;
+	return style::font(CardScaled(size), base->flags(), base->family());
+}
+
+const style::FlatLabel &CardHeadlineStyle() {
+	static const auto result = LabelStyle(
+		st::boxTitle,
+		st::windowBoldFg,
+		24,
+		true);
+	return result;
+}
+
+const style::FlatLabel &CardTitleStyle() {
+	static const auto result = LabelStyle(
+		st::boxLabel,
+		st::windowBoldFg,
+		15,
+		true);
+	return result;
+}
+
+const style::FlatLabel &CardSubtitleStyle() {
+	static const auto result = LabelStyle(
+		st::boxLabel,
+		st::windowSubTextFg,
+		14,
+		false);
+	return result;
+}
+
+const style::FlatLabel &CardCaptionStyle() {
+	static const auto result = LabelStyle(
+		st::boxLabel,
+		st::windowSubTextFg,
+		12,
+		false);
+	return result;
+}
+
+void PaintCardRadio(QPainter &p, const QRectF &rect, bool checked) {
+	auto hq = PainterHighQualityEnabler(p);
+	if (checked) {
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::activeButtonBg);
+		p.drawEllipse(rect);
+		p.setBrush(st::activeButtonFg);
+		const auto inner = rect.width() * 0.36;
+		p.drawEllipse(QRectF(
+			rect.center().x() - inner / 2.,
+			rect.center().y() - inner / 2.,
+			inner,
+			inner));
+		return;
+	}
+	auto pen = QPen(st::windowSubTextFg->c);
+	pen.setWidthF(std::max(rect.width() * 0.09, 1.));
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	const auto half = pen.widthF() / 2.;
+	p.drawEllipse(rect.marginsRemoved(QMarginsF(half, half, half, half)));
+}
+
+void PaintCardCheck(QPainter &p, const QRectF &rect, const QColor &color) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto pen = QPen(color);
+	pen.setWidthF(std::max(rect.width() * 0.12, 1.));
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	auto path = QPainterPath();
+	path.moveTo(
+		rect.left() + rect.width() * 0.18,
+		rect.top() + rect.height() * 0.52);
+	path.lineTo(
+		rect.left() + rect.width() * 0.42,
+		rect.top() + rect.height() * 0.74);
+	path.lineTo(
+		rect.left() + rect.width() * 0.84,
+		rect.top() + rect.height() * 0.28);
+	p.drawPath(path);
+}
+
+void PaintCardChevron(
+		QPainter &p,
+		const QRectF &rect,
+		const QColor &color,
+		bool left) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto pen = QPen(color);
+	pen.setWidthF(std::max(rect.width() * 0.16, 1.));
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	const auto edge = left ? 0.68 : 0.32;
+	const auto tip = left ? 0.32 : 0.68;
+	auto path = QPainterPath();
+	path.moveTo(
+		rect.left() + rect.width() * edge,
+		rect.top() + rect.height() * 0.18);
+	path.lineTo(
+		rect.left() + rect.width() * tip,
+		rect.top() + rect.height() * 0.5);
+	path.lineTo(
+		rect.left() + rect.width() * edge,
+		rect.top() + rect.height() * 0.82);
+	p.drawPath(path);
+}
+
+void PaintSparkles(QPainter &p, const QRectF &rect, const QColor &color) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto star = [&](float64 x, float64 y, float64 radius) {
+		const auto cx = rect.left() + rect.width() * x;
+		const auto cy = rect.top() + rect.height() * y;
+		const auto r = std::min(rect.width(), rect.height()) * radius;
+		const auto k = r * 0.16;
+		auto path = QPainterPath();
+		path.moveTo(cx, cy - r);
+		path.quadTo(cx + k, cy - k, cx + r, cy);
+		path.quadTo(cx + k, cy + k, cx, cy + r);
+		path.quadTo(cx - k, cy + k, cx - r, cy);
+		path.quadTo(cx - k, cy - k, cx, cy - r);
+		return path;
+	};
+	p.setPen(Qt::NoPen);
+	p.setBrush(color);
+	p.drawPath(star(0.56, 0.56, 0.40));
+	p.drawPath(star(0.20, 0.22, 0.16));
+	p.drawPath(star(0.86, 0.90, 0.10));
+}
+
+PaintedButton::PaintedButton(
+	QWidget *parent,
+	Fn<void(QPainter&, QRect, bool)> paint)
+: AbstractButton(parent)
+, _paint(std::move(paint)) {
+}
+
+void PaintedButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	if (_paint) {
+		_paint(p, rect(), isOver() || isDown());
+	}
+}
+
+void PaintedButton::onStateChanged(State was, StateChangeSource source) {
+	update();
+}
+
+SegmentedControl::SegmentedControl(
+	QWidget *parent,
+	std::vector<QString> options,
+	int selected)
+: RpWidget(parent)
+, _options(std::move(options))
+, _selected(std::clamp(
+	selected,
+	0,
+	std::max(int(_options.size()) - 1, 0))) {
+	setMouseTracking(true);
+}
+
+void SegmentedControl::setSelected(int index) {
+	if (index < 0 || index >= int(_options.size()) || index == _selected) {
+		return;
+	}
+	const auto from = _selected;
+	_selected = index;
+	_animation.start([=] {
+		update();
+	}, from, index, kSlideDuration, anim::easeOutCirc);
+	update();
+}
+
+int SegmentedControl::selected() const {
+	return _selected;
+}
+
+rpl::producer<int> SegmentedControl::selectedChanges() const {
+	return _changes.events();
+}
+
+int SegmentedControl::resizeGetHeight(int newWidth) {
+	return CardScaled(kSegmentHeight);
+}
+
+int SegmentedControl::indexAt(QPoint position) const {
+	const auto count = int(_options.size());
+	if (!count || !rect().contains(position)) {
+		return -1;
+	}
+	const auto inset = CardScaled(kSegmentInset);
+	const auto segment = (width() - 2. * inset) / count;
+	if (segment <= 0.) {
+		return -1;
+	}
+	return std::clamp(
+		int(std::floor((position.x() - inset) / segment)),
+		0,
+		count - 1);
+}
+
+void SegmentedControl::setOver(int index) {
+	if (_over != index) {
+		_over = index;
+		setCursor((index >= 0 && index != _selected)
+			? style::cur_pointer
+			: style::cur_default);
+		update();
+	}
+}
+
+void SegmentedControl::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto count = int(_options.size());
+	if (!count) {
+		return;
+	}
+	const auto radius = CardScaled(kSegmentRadius) * 1.;
+	const auto inset = CardScaled(kSegmentInset);
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::windowBgOver);
+	p.drawRoundedRect(QRectF(rect()), radius, radius);
+	const auto segment = (width() - 2. * inset) / count;
+	const auto position = _animation.value(_selected);
+	p.setBrush(st::windowBg);
+	p.drawRoundedRect(
+		QRectF(
+			inset + segment * position,
+			inset,
+			segment,
+			height() - 2. * inset),
+		radius - inset,
+		radius - inset);
+	const auto font = CardFont(14, true);
+	p.setFont(font);
+	for (auto i = 0; i != count; ++i) {
+		const auto area = QRectF(inset + segment * i, 0, segment, height());
+		p.setPen((i == _selected)
+			? st::windowActiveTextFg
+			: (i == _over)
+			? st::windowFg
+			: st::windowSubTextFg);
+		p.drawText(
+			area,
+			Qt::AlignCenter,
+			font->elided(
+				_options[i],
+				std::max(int(segment) - CardScaled(8), 0)));
+	}
+}
+
+void SegmentedControl::mouseMoveEvent(QMouseEvent *e) {
+	setOver(indexAt(e->pos()));
+}
+
+void SegmentedControl::mousePressEvent(QMouseEvent *e) {
+	if (e->button() == Qt::LeftButton) {
+		_pressed = indexAt(e->pos());
+	}
+}
+
+void SegmentedControl::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = std::exchange(_pressed, -1);
+	if (e->button() != Qt::LeftButton || pressed < 0) {
+		return;
+	} else if (indexAt(e->pos()) != pressed || pressed == _selected) {
+		return;
+	}
+	setSelected(pressed);
+	setCursor(style::cur_default);
+	_changes.fire_copy(pressed);
+}
+
+void SegmentedControl::leaveEventHook(QEvent *e) {
+	setOver(-1);
+}
+
+ChipsSelector::ChipsSelector(
+	QWidget *parent,
+	std::vector<QString> options,
+	int selected)
+: RpWidget(parent)
+, _options(std::move(options))
+, _selected(selected) {
+	setMouseTracking(true);
+}
+
+void ChipsSelector::setSelected(int index) {
+	if (index != _selected) {
+		_selected = index;
+		update();
+	}
+}
+
+int ChipsSelector::selected() const {
+	return _selected;
+}
+
+rpl::producer<int> ChipsSelector::selectedChanges() const {
+	return _changes.events();
+}
+
+int ChipsSelector::layoutChips(int width) {
+	_rects.clear();
+	const auto font = CardFont(14, true);
+	const auto height = CardScaled(kChipHeight);
+	const auto padding = CardScaled(kChipPadding);
+	const auto gap = CardScaled(kChipGap);
+	auto x = 0;
+	auto y = 0;
+	for (const auto &option : _options) {
+		const auto chip = std::min(
+			font->width(option) + 2 * padding,
+			std::max(width, 1));
+		if (x > 0 && x + chip > width) {
+			x = 0;
+			y += height + gap;
+		}
+		_rects.push_back(QRect(x, y, chip, height));
+		x += chip + gap;
+	}
+	return _rects.empty() ? 0 : (y + height);
+}
+
+int ChipsSelector::resizeGetHeight(int newWidth) {
+	return layoutChips(newWidth);
+}
+
+int ChipsSelector::indexAt(QPoint position) const {
+	for (auto i = 0; i != int(_rects.size()); ++i) {
+		if (_rects[i].contains(position)) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+void ChipsSelector::setOver(int index) {
+	if (_over != index) {
+		_over = index;
+		setCursor((index >= 0 && index != _selected)
+			? style::cur_pointer
+			: style::cur_default);
+		update();
+	}
+}
+
+void ChipsSelector::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto font = CardFont(14, true);
+	const auto radius = CardScaled(kChipRadius) * 1.;
+	const auto padding = CardScaled(kChipPadding);
+	p.setFont(font);
+	for (auto i = 0; i != int(_rects.size()); ++i) {
+		const auto active = (i == _selected);
+		const auto rect = QRectF(_rects[i]);
+		const auto half = st::lineWidth / 2.;
+		auto pen = QPen(active ? st::activeButtonBg->c : st::shadowFg->c);
+		pen.setWidthF(st::lineWidth);
+		p.setPen(pen);
+		p.setBrush(active
+			? st::lightButtonBgOver
+			: (i == _over)
+			? st::windowBgOver
+			: st::windowBg);
+		p.drawRoundedRect(
+			rect.marginsRemoved(QMarginsF(half, half, half, half)),
+			radius,
+			radius);
+		p.setPen(active ? st::windowActiveTextFg : st::windowFg);
+		p.drawText(
+			rect,
+			Qt::AlignCenter,
+			font->elided(
+				_options[i],
+				std::max(_rects[i].width() - 2 * padding, 0)));
+	}
+}
+
+void ChipsSelector::mouseMoveEvent(QMouseEvent *e) {
+	setOver(indexAt(e->pos()));
+}
+
+void ChipsSelector::mousePressEvent(QMouseEvent *e) {
+	if (e->button() == Qt::LeftButton) {
+		_pressed = indexAt(e->pos());
+	}
+}
+
+void ChipsSelector::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = std::exchange(_pressed, -1);
+	if (e->button() != Qt::LeftButton || pressed < 0) {
+		return;
+	} else if (indexAt(e->pos()) != pressed || pressed == _selected) {
+		return;
+	}
+	setSelected(pressed);
+	setCursor(style::cur_default);
+	_changes.fire_copy(pressed);
+}
+
+void ChipsSelector::leaveEventHook(QEvent *e) {
+	setOver(-1);
+}
+
+} // namespace Tele
