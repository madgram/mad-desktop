+void FillDomainInput(
+		Context context,
+		not_null<Ui::VerticalLayout*> content) {
+	const auto service = context.service;
+	context.state->title = Tr(u"Your domain"_q);
+	AddHeadline(
+		content,
+		Tr(u"Your domain"_q),
+		Tr(u"Enter a domain like example.com. We'll verify it through "
+			"DNS."_q));
+	const auto field = content->add(
+		object_ptr<Ui::InputField>(
+			content,
+			st::defaultInputField,
+			rpl::single(u"example.com"_q),
+			QString()),
+		Side());
+	AddSkip(content, 8);
+	const auto error = AddLabel(content, QString(), CardCaptionStyle(), Side());
+	error->setTextColorOverride(st::boxTextFgError->c);
+	AddSkip(content, 20);
+
+	const auto footer = context.state->footer;
+	const auto bar = footer->add(object_ptr<Ui::RpWidget>(footer));
+	bar->resize(bar->width(), CardScaled(kFooterHeight));
+	bar->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(bar);
+		p.fillRect(0, 0, bar->width(), st::lineWidth, st::shadowFg);
+	}, bar->lifetime());
+	const auto next = Ui::CreateChild<Ui::RoundButton>(
+		bar,
+		rpl::single(Tr(u"Continue"_q)),
+		st::defaultActiveButton);
+	next->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	bar->widthValue() | rpl::on_next([=](int width) {
+		next->moveToRight(
+			CardScaled(kSide),
+			(bar->height() - next->height()) / 2,
+			width);
+	}, bar->lifetime());
+	const auto busy = std::make_shared<bool>(false);
+	const auto submit = [=] {
+		if (*busy) {
+			return;
+		}
+		const auto value = field->getLastText().trimmed().toLower();
+		if (!IsLinkedDomain(value)) {
+			error->setText(Tr(u"That doesn't look like a domain."_q));
+			field->showError();
+			return;
+		}
+		*busy = true;
+		error->setText(QString());
+		service->claimDomain(value, crl::guard(error, [=](
+				std::optional<LinkedDomainClaim> claim,
+				QString text) {
+			*busy = false;
+			if (claim) {
+				ReplaceTop(context, {
+					.type = PageType::DomainCheck,
+					.id = claim->domain,
+				});
+			} else {
+				error->setText(text);
+			}
+		}));
+	};
+	field->submits() | rpl::on_next(submit, field->lifetime());
+	next->setClickedCallback(submit);
+	crl::on_main(field, [=] {
+		field->setFocusFast();
+	});
+}
