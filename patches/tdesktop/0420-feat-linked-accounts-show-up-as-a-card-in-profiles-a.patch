+[[nodiscard]] object_ptr<Ui::RpWidget> MakeHeader(
+		Context context,
+		not_null<QWidget*> parent) {
+	auto result = object_ptr<Ui::RpWidget>(parent);
+	const auto raw = result.data();
+	raw->resize(CardScaled(kBoxWidth), CardScaled(kHeaderHeight));
+	const auto back = Ui::CreateChild<Ui::IconButton>(
+		raw,
+		st::infoTopBarBack);
+	const auto close = Ui::CreateChild<Ui::IconButton>(
+		raw,
+		st::boxTitleClose);
+	back->setClickedCallback([=] {
+		Back(context);
+	});
+	close->setClickedCallback([=] {
+		context.box->closeBox();
+	});
+	context.state->canBack.value() | rpl::on_next([=](bool shown) {
+		back->setVisible(shown);
+	}, back->lifetime());
+	raw->widthValue() | rpl::on_next([=](int width) {
+		back->moveToLeft(0, (raw->height() - back->height()) / 2, width);
+		close->moveToRight(
+			CardScaled(4),
+			(raw->height() - close->height()) / 2,
+			width);
+	}, raw->lifetime());
+	context.state->title.value() | rpl::on_next([=] {
+		raw->update();
+	}, raw->lifetime());
+	raw->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(raw);
+		const auto width = raw->width();
+		const auto font = CardFont(16, true);
+		const auto reserve = std::max(back->width(), close->width())
+			+ CardScaled(8);
+		const auto title = font->elided(
+			context.state->title.current(),
+			std::max(width - 2 * reserve, 0));
+		p.setFont(font);
+		p.setPen(st::boxTitleFg);
+		p.drawText(
+			(width - font->width(title)) / 2,
+			(raw->height() - font->height) / 2 + font->ascent,
+			title);
+		p.fillRect(
+			0,
+			raw->height() - st::lineWidth,
+			width,
+			st::lineWidth,
+			st::shadowFg);
+	}, raw->lifetime());
+	return result;
+}
