+void FillAccounts(Context context, not_null<Ui::VerticalLayout*> content) {
+	const auto service = context.service;
+	context.state->title = Tr(u"Linked accounts"_q);
+	AddHeadline(
+		content,
+		Tr(u"Your accounts"_q),
+		Tr(u"Choose who can see each account on your profile."_q));
+	if (!service->mineLoaded()) {
+		const auto text = service->busy()
+			? Tr(u"Loading…"_q)
+			: service->error();
+		if (!text.isEmpty()) {
+			AddLabel(content, text, CardSubtitleStyle(), Side());
+		}
+		if (!service->busy()) {
+			AddSkip(content, 10);
+			const auto retry = content->add(
+				object_ptr<Ui::LinkButton>(content, Tr(u"Retry"_q)),
+				Side());
+			retry->setClickedCallback([=] {
+				service->loadMine();
+			});
+		}
+		AddSkip(content, 20);
+		return;
+	}
+	const auto &mine = service->mine();
+	const auto &drafts = service->domainDrafts();
+	const auto total = int(mine.accounts.size() + drafts.size());
+	auto index = 0;
+	for (const auto &account : mine.accounts) {
+		auto subtitle = LinkedAccountTitle(account);
+		if (account.hiddenByAdmin) {
+			subtitle += u" · "_q + Tr(u"hidden by moderators"_q);
+		}
+		const auto id = account.id;
+		AddAccountRow(
+			content,
+			account,
+			LinkedPlatformName(account.platform),
+			subtitle,
+			account.visible ? Tr(u"everyone"_q) : Tr(u"only me"_q),
+			account.visible,
+			(index == 0),
+			(index + 1 == total),
+			[=] { Open(context, { .type = PageType::Account, .id = id }); });
+		++index;
+	}
+	for (const auto &claim : drafts) {
+		const auto domain = claim.domain;
+		AddAccountRow(
+			content,
+			LinkedAccount{ .platform = u"domain"_q },
+			claim.displayDomain,
+			Tr(u"waiting for the TXT record"_q),
+			QString(),
+			false,
+			(index == 0),
+			(index + 1 == total),
+			[=] {
+				Open(context, { .type = PageType::DomainCheck, .id = domain });
+			});
+		++index;
+	}
+	if (!total) {
+		AddLabel(
+			content,
+			Tr(u"Nothing linked yet."_q),
+			CardSubtitleStyle(),
+			Side());
+	}
+	if (!service->error().isEmpty()) {
+		AddSkip(content, 10);
+		AddLabel(content, service->error(), CardCaptionStyle(), Side());
+	}
+	AddSkip(content, 14);
+	const auto note = content->add(object_ptr<Ui::RpWidget>(content));
+	note->resize(note->width(), CardScaled(22));
+	note->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(note);
+		const auto side = CardScaled(kSide);
+		const auto mark = CardScaled(15);
+		const auto font = CardFont(13, false);
+		PaintLinkedVerified(
+			p,
+			QRectF(side, (note->height() - mark) / 2., mark, mark),
+			st::windowActiveTextFg->c);
+		p.setFont(font);
+		p.setPen(st::windowSubTextFg);
+		const auto left = side + mark + CardScaled(8);
+		p.drawText(
+			left,
+			(note->height() - font->height) / 2 + font->ascent,
+			font->elided(
+				Tr(u"Ownership confirmed through platform sign-in."_q),
+				std::max(note->width() - left - side, 0)));
+	}, note->lifetime());
+	AddSkip(content, 16);
+	const auto add = content->add(
+		object_ptr<Ui::RoundButton>(
+			content,
+			rpl::single(u"+ "_q + Tr(u"Add account"_q)),
+			st::defaultActiveButton),
+		Side(),
+		style::al_left);
+	add->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	add->setClickedCallback([=] {
+		Open(context, { .type = PageType::Add });
+	});
+	AddSkip(content, 24);
+	AddLabel(content, Tr(u"Profile layout"_q), CardTitleStyle(), Side());
+	AddSkip(content, 10);
+	const auto layout = content->add(
+		object_ptr<SegmentedControl>(
+			content,
+			std::vector<QString>{ Tr(u"Row"_q), Tr(u"List"_q) },
+			(mine.design == u"list"_q) ? 1 : 0),
+		Side());
+	layout->selectedChanges() | rpl::on_next([=](int index) {
+		service->setDesign(
+			index ? u"list"_q : u"row"_q,
+			crl::guard(context.box, [=](QString error) {
+				ShowToast(context, error);
+			}));
+	}, layout->lifetime());
+	AddSkip(content, 8);
+	AddLabel(
+		content,
+		Tr(u"Every mad user sees the block this way."_q),
+		CardCaptionStyle(),
+		Side());
+	AddSkip(content, 24);
+}
+
+void AskClientId(Context context, Fn<void(QString)> done) {
+	context.controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Spotify"_q));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Tr(u"Create an app on developer.spotify.com, add "
+				"https://b.mad.tg/api/v1/connect/spotify/callback as its "
+				"redirect URL and paste its Client ID here."_q),
+			st::boxLabel));
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(u"Client ID"_q),
+			SpotifyClientId()));
+		const auto submit = [=] {
+			const auto value = field->getLastText().trimmed();
+			if (value.isEmpty()) {
+				field->showError();
+				return;
+			}
+			SetSpotifyClientId(value);
+			box->closeBox();
+			done(value);
+		};
+		field->submits() | rpl::on_next(submit, field->lifetime());
+		box->setFocusCallback([=] { field->setFocusFast(); });
+		box->addButton(rpl::single(Tr(u"Continue"_q)), submit);
+		box->addButton(rpl::single(Tr(u"Cancel"_q)), [=] {
+			box->closeBox();
+		});
+	}));
+}
+
+void StartLink(Context context, const LinkedPlatform &platform) {
+	const auto service = context.service;
+	if (!service->available()) {
+		ShowToast(context, Tr(u"The mad server is off for this launch."_q));
+		return;
+	} else if (!platform.available) {
+		ShowToast(context, Tr(u"This platform isn't available yet."_q));
+		return;
+	} else if (platform.method == u"dns"_q) {
+		Open(context, { .type = PageType::DomainInput });
+		return;
+	}
+	const auto id = platform.id;
+	const auto go = [=](QString clientId) {
+		service->link(id, clientId);
+		ShowToast(context, Tr(u"Finish signing in in the browser."_q));
+	};
+	if (platform.needsClientId) {
+		AskClientId(context, crl::guard(context.box, go));
+	} else {
+		go(QString());
+	}
+}
