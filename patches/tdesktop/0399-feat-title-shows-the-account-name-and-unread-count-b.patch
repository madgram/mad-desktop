@@ -81,6 +81,29 @@ struct Context {
 	return brief ? Compact(text) : text;
 }
 
+[[nodiscard]] QString AutoTitle(const Context &context) {
+	const auto controller = context.controller;
+	auto parts = QStringList();
+	if (TitleBuild()) {
+		parts.push_back(TitleLabel());
+	}
+	auto account = QString();
+	if (controller && TitleName() && !StreamerMode()) {
+		account = controller->session().user()->name();
+	}
+	const auto unread = (controller && TitleUnread())
+		? Core::App().unreadBadge()
+		: 0;
+	if (unread > 0) {
+		const auto counter = u"(%1)"_q.arg(unread);
+		account = account.isEmpty() ? counter : (account + ' ' + counter);
+	}
+	if (!account.isEmpty()) {
+		parts.push_back(account);
+	}
+	return parts.isEmpty() ? u"mad"_q : parts.join(u" \u00B7 "_q);
+}
+
 [[nodiscard]] std::optional<QString> Value(
 		const Token &token,
 		const Context &context) {
@@ -149,6 +172,8 @@ struct Context {
 		return (controller && Connecting(&controller->session()))
 			? (brief ? QString(QChar(0x2026)) : u"connecting"_q)
 			: QString();
+	} else if (name == u"auto"_q) {
+		return AutoTitle(context);
 	} else if (name == u"label"_q && context.label) {
 		auto inner = context;
