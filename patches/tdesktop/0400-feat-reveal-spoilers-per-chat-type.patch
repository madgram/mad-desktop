diff --git a/Telegram/SourceFiles/tele/tele_spoilers.cpp b/Telegram/SourceFiles/tele/tele_spoilers.cpp
index 217d07c28c2df03176c9eb84054d413085c29111..6648493395384121a2218883e43c8e1b43aff7a7 100644
--- a/Telegram/SourceFiles/tele/tele_spoilers.cpp
+++ b/Telegram/SourceFiles/tele/tele_spoilers.cpp
@@ -129,7 +129,7 @@ void Track(not_null<HistoryView::Element*> view) {
 }
 
 [[nodiscard]] bool RevealsIn(not_null<HistoryView::Element*> view) {
-	return RevealSpoilers()
+	return RevealSpoilersIn(view->data()->history()->peer)
 		&& (view->delegate()->elementContext()
 			!= HistoryView::Context::ContactPreview);
 }
@@ -140,8 +140,23 @@ void InvalidateAllPreviews() {
 	EnumerateSessions(InvalidatePreviews);
 }
 
-void RevealTextSpoilers(Ui::Text::String &text) {
-	if (RevealSpoilers() && text.hasSpoilers()) {
+bool RevealSpoilersIn(PeerData *peer) {
+	if (!RevealSpoilers()) {
+		return false;
+	} else if (!peer) {
+		return true;
+	} else if (peer->isSelf()) {
+		return RevealSpoilersSaved();
+	} else if (peer->isUser()) {
+		return RevealSpoilersPrivate();
+	} else if (peer->isBroadcast()) {
+		return RevealSpoilersChannels();
+	}
+	return RevealSpoilersGroups();
+}
+
+void RevealTextSpoilers(Ui::Text::String &text, PeerData *peer) {
+	if (RevealSpoilersIn(peer) && text.hasSpoilers()) {
 		text.setSpoilerRevealed(true, anim::type::instant);
 	}
 }
@@ -190,7 +205,7 @@ void RevealPreviewSpoilers(
 			return;
 		}
 	}
-	RevealTextSpoilers(text);
+	RevealTextSpoilers(text, item->history()->peer);
 }
 
 bool RevealPreviewSpoiler(
