index 0000000000000000000000000000000000000000..d1766a9f3f4910cd6e967c925f7d4d6b798c9f6b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mad_badge_tooltip.cpp
@@ -0,0 +1,396 @@
+#include "tele/tele_mad_badge_tooltip.h"
+
+#include "base/event_filter.h"
+#include "base/timer.h"
+#include "ui/effects/animations.h"
+#include "ui/image/image_prepare.h"
+#include "ui/painter.h"
+#include "ui/rp_widget.h"
+#include "ui/text/text.h"
+#include "styles/style_basic.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QPointer>
+#include <QtGui/QCursor>
+#include <QtGui/QGuiApplication>
+#include <QtGui/QPainterPath>
+#include <QtGui/QScreen>
+#include <QtWidgets/QApplication>
+
+namespace Tele {
+namespace {
+
+constexpr auto kShowDuration = crl::time(400);
+constexpr auto kFadeInDuration = crl::time(200);
+constexpr auto kHideDuration = crl::time(200);
+constexpr auto kShowFor = crl::time(4000);
+constexpr auto kIgnoreInputFor = crl::time(150);
+constexpr auto kMinScale = 0.01;
+constexpr auto kTextOpacity = 0.75;
+
+[[nodiscard]] float64 Spring(float64 t) {
+	constexpr auto s = 0.9;
+	const auto u = t - 1.;
+	return u * u * ((s + 1.) * u + s) + 1.;
+}
+
+[[nodiscard]] style::TextStyle TextStyleOf(int size, bool semibold) {
+	const auto &font = semibold ? st::semiboldFont : st::normalFont;
+	auto result = st::defaultTextStyle;
+	result.font = style::font(
+		style::ConvertScale(size),
+		font->flags(),
+		font->family());
+	return result;
+}
+
+[[nodiscard]] QPainterPath TailPath(
+		float64 tipX,
+		float64 tipY,
+		float64 baseY,
+		float64 width) {
+	const auto half = width / 2.;
+	auto result = QPainterPath();
+	result.moveTo(tipX - half, baseY);
+	result.cubicTo(
+		tipX - half * 0.5,
+		baseY,
+		tipX - half * 0.2,
+		tipY,
+		tipX,
+		tipY);
+	result.cubicTo(
+		tipX + half * 0.2,
+		tipY,
+		tipX + half * 0.5,
+		baseY,
+		tipX + half,
+		baseY);
+	result.closeSubpath();
+	return result;
+}
+
+class BadgeTooltip final : public Ui::RpWidget {
+public:
+	BadgeTooltip(
+		const QString &title,
+		const QString &description,
+		QWidget *anchor,
+		QRect anchorRect);
+
+	void hideAnimated();
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+
+private:
+	void prepare(QWidget *anchor, QRect anchorRect);
+	[[nodiscard]] QImage backdrop(QWidget *window, QRect global) const;
+
+	style::TextStyle _titleStyle;
+	style::TextStyle _textStyle;
+	Ui::Text::String _title;
+	Ui::Text::String _text;
+	QImage _frame;
+	QRect _frameRect;
+	QPointF _tip;
+	crl::time _shown = 0;
+	crl::time _hiding = 0;
+	Ui::Animations::Basic _animation;
+	base::Timer _hideTimer;
+
+};
+
+QPointer<BadgeTooltip> Shown;
+
+BadgeTooltip::BadgeTooltip(
+	const QString &title,
+	const QString &description,
+	QWidget *anchor,
+	QRect anchorRect)
+: RpWidget(nullptr)
+, _titleStyle(TextStyleOf(14, true))
+, _textStyle(TextStyleOf(13, false))
+, _title(_titleStyle, title, kPlainTextOptions)
+, _text(_textStyle, description, kPlainTextOptions)
+, _hideTimer([=] { hideAnimated(); }) {
+	setWindowFlags(Qt::WindowFlags(Qt::FramelessWindowHint)
+		| Qt::BypassWindowManagerHint
+		| Qt::NoDropShadowWindowHint
+		| Qt::WindowTransparentForInput
+		| Qt::WindowDoesNotAcceptFocus
+		| Qt::ToolTip);
+	setAttribute(Qt::WA_NoSystemBackground);
+	setAttribute(Qt::WA_TranslucentBackground);
+	setAttribute(Qt::WA_TransparentForMouseEvents);
+	setAttribute(Qt::WA_ShowWithoutActivating);
+
+	prepare(anchor, anchorRect);
+
+	_animation.init([=](crl::time now) {
+		update();
+		if (_hiding) {
+			if (now - _hiding >= kHideDuration) {
+				deleteLater();
+				return false;
+			}
+			return true;
+		}
+		return (now - _shown) < kShowDuration;
+	});
+	base::install_event_filter(
+		this,
+		QCoreApplication::instance(),
+		[=](not_null<QEvent*> e) {
+			const auto type = e->type();
+			if ((type == QEvent::MouseButtonPress
+				|| type == QEvent::Wheel
+				|| type == QEvent::KeyPress
+				|| type == QEvent::ApplicationDeactivate)
+				&& (crl::now() - _shown >= kIgnoreInputFor)) {
+				hideAnimated();
+			}
+			return base::EventFilterResult::Continue;
+		});
+	_shown = crl::now();
+	show();
+	_animation.start();
+	_hideTimer.callOnce(kShowFor);
+}
+
+void BadgeTooltip::prepare(QWidget *anchor, QRect anchorRect) {
+	const auto margin = style::ConvertScale(8);
+	const auto paddingH = style::ConvertScale(11);
+	const auto paddingV = style::ConvertScale(8);
+	const auto skip = style::ConvertScale(4);
+	const auto maxWidth = style::ConvertScale(260);
+	const auto radius = style::ConvertScaleExact(12.5);
+	const auto tailWidth = style::ConvertScale(29);
+	const auto tailHeight = style::ConvertScale(10);
+	const auto distance = style::ConvertScale(10);
+	const auto edge = style::ConvertScale(12);
+	const auto belowLimit = style::ConvertScale(120);
+
+	const auto hasTitle = !_title.isEmpty();
+	const auto hasText = !_text.isEmpty();
+	const auto textWidth = std::clamp(
+		std::max(
+			hasTitle ? _title.maxWidth() : 0,
+			hasText ? _text.maxWidth() : 0),
+		1,
+		maxWidth - 2 * paddingH);
+	const auto titleHeight = hasTitle ? _title.countHeight(textWidth) : 0;
+	const auto textHeight = hasText ? _text.countHeight(textWidth) : 0;
+	const auto bubble = QSize(
+		textWidth + 2 * paddingH,
+		(titleHeight
+			+ ((hasTitle && hasText) ? skip : 0)
+			+ textHeight
+			+ 2 * paddingV));
+
+	const auto cursorSize = style::ConvertScale(16);
+	const auto target = anchor
+		? QRect(anchor->mapToGlobal(anchorRect.topLeft()), anchorRect.size())
+		: QRect(
+			QCursor::pos() - QPoint(cursorSize / 2, cursorSize / 2),
+			QSize(cursorSize, cursorSize));
+	const auto window = anchor
+		? anchor->window()
+		: [] {
+			const auto under = QApplication::widgetAt(QCursor::pos());
+			return under ? under->window() : nullptr;
+		}();
+	const auto screen = QGuiApplication::screenAt(target.center())
+		? QGuiApplication::screenAt(target.center())
+		: QGuiApplication::primaryScreen();
+	const auto available = screen
+		? screen->availableGeometry()
+		: QRect(target.center() - QPoint(1000, 1000), QSize(2000, 2000));
+	const auto windowTop = window
+		? window->mapToGlobal(QPoint()).y()
+		: available.y();
+
+	auto below = (target.y() - windowTop) < belowLimit;
+	const auto aboveTop = target.y() - distance - tailHeight - bubble.height();
+	if (!below && aboveTop < available.y() + edge) {
+		below = true;
+	}
+	const auto tipY = below
+		? (target.y() + target.height() + distance)
+		: (target.y() - distance);
+	const auto bubbleTop = below
+		? (tipY + tailHeight)
+		: (tipY - tailHeight - bubble.height());
+	const auto centerX = target.x() + target.width() / 2.;
+	const auto bubbleLeft = std::clamp(
+		int(std::round(centerX - bubble.width() / 2.)),
+		available.x() + edge,
+		std::max(
+			available.x() + edge,
+			available.x() + available.width() - edge - bubble.width()));
+	const auto tipMin = bubbleLeft + radius + tailWidth / 2.;
+	const auto tipMax = bubbleLeft + bubble.width() - radius - tailWidth / 2.;
+	const auto tipX = (tipMin <= tipMax)
+		? std::clamp(centerX, tipMin, tipMax)
+		: (bubbleLeft + bubble.width() / 2.);
+
+	const auto drawn = QRect(
+		bubbleLeft,
+		below ? tipY : bubbleTop,
+		bubble.width(),
+		bubble.height() + tailHeight);
+	setGeometry(drawn.marginsAdded({ margin, margin, margin, margin }));
+	_frameRect = QRect(QPoint(margin, margin), drawn.size());
+	_tip = QPointF(
+		margin + tipX - bubbleLeft,
+		margin + (below ? 0 : drawn.height()));
+
+	const auto ratio = style::DevicePixelRatio();
+	_frame = QImage(
+		drawn.size() * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	_frame.setDevicePixelRatio(ratio);
+	_frame.fill(Qt::transparent);
+
+	const auto bubbleY = below ? tailHeight : 0;
+	auto shape = QPainterPath();
+	shape.addRoundedRect(
+		QRectF(0, bubbleY, bubble.width(), bubble.height()),
+		radius,
+		radius);
+	const auto localTipX = tipX - bubbleLeft;
+	const auto tail = below
+		? TailPath(localTipX, 0., tailHeight + 1., tailWidth)
+		: TailPath(localTipX, drawn.height(), bubble.height() - 1., tailWidth);
+	shape = shape.united(tail);
+
+	const auto night = (st::windowBg->c.lightnessF() < 0.5);
+	const auto blurred = backdrop(window, drawn);
+	auto tint = night ? QColor(30, 30, 32) : QColor(0, 0, 0);
+	tint.setAlphaF(blurred.isNull() ? 0.92 : night ? 0.85 : 0.6);
+
+	auto p = QPainter(&_frame);
+	auto hq = PainterHighQualityEnabler(p);
+	if (!blurred.isNull()) {
+		p.setClipPath(shape);
+		p.drawImage(QRect(QPoint(), drawn.size()), blurred);
+		p.setClipping(false);
+	}
+	p.fillPath(shape, tint);
+
+	auto y = bubbleY + paddingV;
+	if (hasTitle) {
+		p.setPen(QColor(255, 255, 255));
+		_title.draw(p, {
+			.position = QPoint(paddingH, y),
+			.outerWidth = drawn.width(),
+			.availableWidth = textWidth,
+		});
+		y += titleHeight + (hasText ? skip : 0);
+	}
+	if (hasText) {
+		auto color = QColor(255, 255, 255);
+		color.setAlphaF(kTextOpacity);
+		p.setPen(color);
+		_text.draw(p, {
+			.position = QPoint(paddingH, y),
+			.outerWidth = drawn.width(),
+			.availableWidth = textWidth,
+		});
+	}
+}
+
+QImage BadgeTooltip::backdrop(QWidget *window, QRect global) const {
+	if (!window || !window->isVisible()) {
+		return QImage();
+	}
+	const auto origin = window->mapFromGlobal(global.topLeft());
+	const auto local = QRect(origin, global.size()).intersected(window->rect());
+	if (local.isEmpty()) {
+		return QImage();
+	}
+	auto image = window->grab(local).toImage();
+	if (image.isNull()) {
+		return QImage();
+	}
+	const auto factor = style::ConvertScale(4);
+	const auto small = QSize(
+		std::max(image.width() / factor, 1),
+		std::max(image.height() / factor, 1));
+	const auto blurred = Images::BlurLargeImage(
+		image.convertToFormat(QImage::Format_ARGB32_Premultiplied).scaled(
+			small,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation),
+		6);
+	const auto ratio = style::DevicePixelRatio();
+	auto result = QImage(
+		global.size() * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	auto p = QPainter(&result);
+	p.setRenderHint(QPainter::SmoothPixmapTransform);
+	p.drawImage(
+		QRect((local.topLeft() - origin) * ratio, local.size() * ratio),
+		blurred);
+	p.end();
+	return result;
+}
+
+void BadgeTooltip::hideAnimated() {
+	if (_hiding) {
+		return;
+	}
+	_hideTimer.cancel();
+	_hiding = crl::now();
+	_animation.start();
+}
+
+void BadgeTooltip::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto now = crl::now();
+	auto scale = 1.;
+	auto opacity = 1.;
+	if (_hiding) {
+		const auto t = std::clamp(
+			(now - _hiding) / float64(kHideDuration),
+			0.,
+			1.);
+		opacity = 1. - t;
+		scale = 1. - (1. - kMinScale) * t;
+	} else {
+		const auto t = std::clamp(
+			(now - _shown) / float64(kShowDuration),
+			0.,
+			1.);
+		scale = kMinScale + (1. - kMinScale) * Spring(t);
+		opacity = std::clamp(
+			(now - _shown) / float64(kFadeInDuration),
+			0.,
+			1.);
+	}
+	p.setOpacity(opacity);
+	p.setRenderHint(QPainter::SmoothPixmapTransform);
+	p.translate(_tip);
+	p.scale(scale, scale);
+	p.translate(-_tip);
+	p.drawImage(_frameRect, _frame);
+}
+
+} // namespace
+
+void ShowMadBadgeTooltip(
+		const QString &title,
+		const QString &description,
+		QWidget *anchor,
+		QRect anchorRect) {
+	if (title.isEmpty() && description.isEmpty()) {
+		return;
+	}
+	if (const auto old = Shown.data()) {
+		delete old;
+	}
+	Shown = new BadgeTooltip(title, description, anchor, anchorRect);
+}
+
+} // namespace Tele
