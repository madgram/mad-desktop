+QString MadBadgeTooltipText(
+		const QString &value,
+		int limit,
+		bool singleLine) {
+	constexpr auto kMaxMarks = 2;
+	constexpr auto kMaxLines = 3;
+	auto cleaned = QString();
+	cleaned.reserve(value.size());
+	auto marks = 0;
+	for (const auto code : value.toUcs4()) {
+		const auto ucs4 = char32_t(code);
+		switch (QChar::category(ucs4)) {
+		case QChar::Mark_NonSpacing:
+		case QChar::Mark_SpacingCombining:
+		case QChar::Mark_Enclosing:
+			if (++marks > kMaxMarks) {
+				continue;
+			}
+			break;
+		case QChar::Other_Control:
+		case QChar::Other_Format:
+		case QChar::Separator_Line:
+		case QChar::Separator_Paragraph:
+			marks = 0;
+			if (ucs4 == char32_t(0x200D)
+				|| (ucs4 >= char32_t(0xE0020) && ucs4 <= char32_t(0xE007F))
+				|| (ucs4 == char32_t('\n') && !singleLine)) {
+				break;
+			}
+			cleaned.append(QChar(' '));
+			continue;
+		default:
+			marks = 0;
+			break;
+		}
+		cleaned.append(QString::fromUcs4(&ucs4, 1));
+	}
+	auto lines = QStringList();
+	for (const auto &line : cleaned.split(QChar('\n'))) {
+		const auto words = line.split(QChar(' '), Qt::SkipEmptyParts);
+		if (!words.isEmpty()) {
+			lines.push_back(words.join(QChar(' ')));
+		}
+	}
+	while (lines.size() > kMaxLines) {
+		lines.removeLast();
+	}
+	const auto text = lines.join(singleLine
+		? QStringLiteral(" ")
+		: QStringLiteral("\n"));
+	auto finder = QTextBoundaryFinder(QTextBoundaryFinder::Grapheme, text);
+	auto count = 0;
+	auto cut = 0;
+	while (finder.toNextBoundary() != -1) {
+		++count;
+		if (count == limit - 1) {
+			cut = int(finder.position());
+		}
+		if (count > limit) {
+			break;
+		}
+	}
+	if (count <= limit) {
+		return text;
+	}
+	return text.left(cut).trimmed() + QChar(0x2026);
+}
+
 }
