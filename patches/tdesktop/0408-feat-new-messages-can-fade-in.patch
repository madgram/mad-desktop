diff --git a/Telegram/SourceFiles/tele/tele_incoming_fade.cpp b/Telegram/SourceFiles/tele/tele_incoming_fade.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e84a0941fd523e0dd0cd4aed7a50f6bee820e174
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_incoming_fade.cpp
@@ -0,0 +1,80 @@
+#include "tele/tele_incoming_fade.h"
+
+#include "base/unixtime.h"
+#include "base/weak_ptr.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/effects/animations.h"
+
+#include <unordered_map>
+
+namespace Tele {
+namespace {
+
+constexpr auto kDuration = crl::time(320);
+constexpr auto kFreshSeconds = 30;
+
+struct Fade {
+	Ui::Animations::Simple animation;
+};
+
+[[nodiscard]] std::unordered_map<const HistoryItem*, Fade> &Fades() {
+	static auto result = std::unordered_map<const HistoryItem*, Fade>();
+	return result;
+}
+
+void Sweep() {
+	auto &fades = Fades();
+	for (auto i = begin(fades); i != end(fades);) {
+		if (i->second.animation.animating()) {
+			++i;
+		} else {
+			i = fades.erase(i);
+		}
+	}
+}
+
+} // namespace
+
+void StartIncomingFade(not_null<HistoryItem*> item) {
+	if (!AnimateIncoming()
+		|| item->out()
+		|| item->isSponsored()
+		|| (base::unixtime::now() - item->date() > kFreshSeconds)) {
+		return;
+	}
+	Sweep();
+	auto &fade = Fades()[item.get()];
+	if (fade.animation.animating()) {
+		return;
+	}
+	const auto session = base::make_weak(&item->history()->session());
+	const auto id = item->fullId();
+	fade.animation.start([=] {
+		if (const auto strong = session.get()) {
+			if (const auto found = strong->data().message(id)) {
+				strong->data().requestItemRepaint(found);
+			}
+		}
+	}, 0., 1., kDuration, anim::easeOutCubic);
+}
+
+float64 IncomingFadeOpacity(not_null<const HistoryItem*> item) {
+	auto &fades = Fades();
+	if (fades.empty()) {
+		return 1.;
+	}
+	const auto i = fades.find(item.get());
+	if (i == end(fades)) {
+		return 1.;
+	} else if (!i->second.animation.animating()) {
+		fades.erase(i);
+		return 1.;
+	}
+	return i->second.animation.value(1.);
+}
+
+} // namespace Tele
