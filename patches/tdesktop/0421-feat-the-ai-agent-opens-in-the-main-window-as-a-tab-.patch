+void ChatView::setupBar() {
+	_barLabel = Ui::CreateChild<Ui::FlatLabel>(
+		_bar.data(),
+		QString(),
+		BarStyle());
+	_barStop = Ui::CreateChild<Ui::RoundButton>(
+		_bar.data(),
+		rpl::single(Tr(u"Stop"_q)),
+		st::attentionBoxButton);
+	_barStop->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	_barStop->setClickedCallback([=] {
+		StopAutoReplies(_session);
+	});
+	_bar->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(_bar.data());
+		auto hq = PainterHighQualityEnabler(p);
+		const auto margin = CardScaled(12);
+		const auto rect = QRectF(
+			margin,
+			CardScaled(6),
+			_bar->width() - 2 * margin,
+			_bar->height() - CardScaled(10));
+		const auto radius = CardScaled(14) * 1.;
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(rect, radius, radius);
+	}, _bar->lifetime());
+	_bar->sizeValue() | rpl::on_next([=](QSize size) {
+		const auto margin = CardScaled(12) + CardScaled(14);
+		const auto center = CardScaled(6) + (size.height() - CardScaled(10)) / 2;
+		_barStop->moveToRight(
+			CardScaled(12) + CardScaled(4),
+			center - _barStop->height() / 2,
+			size.width());
+		_barLabel->resizeToWidth(std::max(
+			size.width() - margin - _barStop->width() - CardScaled(20),
+			1));
+		_barLabel->moveToLeft(
+			margin,
+			center - _barLabel->height() / 2,
+			size.width());
+	}, _bar->lifetime());
+	const auto update = [=] {
+		auto active = std::vector<AutoReply>();
+		for (const auto &entry : AutoReplies(_session)) {
+			if (entry.enabled) {
+				active.push_back(entry);
+			}
+		}
+		_barShown = !active.empty();
+		if (_barShown) {
+			_barLabel->setText((active.size() == 1)
+				? Tr(u"Auto-reply: %1"_q).arg(active.front().title)
+				: TrCount(
+					int(active.size()),
+					u"Auto-reply in %1 chat"_q,
+					u"Auto-reply is on in %1 chats"_q));
+			_barStop->setText(rpl::single((active.size() == 1)
+				? Tr(u"Stop"_q)
+				: Tr(u"Stop all"_q)));
+		}
+		_bar->setVisible(_barShown);
+		layout();
+	};
+	AutoRepliesChanges(
+		_session
+	) | rpl::on_next(update, _bar->lifetime());
+	update();
+}
