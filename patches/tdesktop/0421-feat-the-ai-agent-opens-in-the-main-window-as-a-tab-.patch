+[[nodiscard]] const style::SideBarButton &ButtonStyle(
+		Ui::ChatsFiltersTabsMode mode) {
+	using Mode = Ui::ChatsFiltersTabsMode;
+	switch (mode) {
+	case Mode::TextOnly: return st::windowFiltersButtonTextOnly;
+	case Mode::TextAndIcons: return st::windowFiltersButton;
+	case Mode::IconsOnly: return Tele::FolderBarStyle(
+		st::windowFiltersButtonIconsOnly);
+	case Mode::Default: break;
+	}
+	return st::windowFiltersButton;
+}
+
+class SideButton final : public Ui::RippleButton {
+public:
+	SideButton(
+		QWidget *parent,
+		const style::SideBarButton &st,
+		Ui::ChatsFiltersTabsMode mode);
+
+	void setActive(bool active);
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+
+private:
+	const style::SideBarButton &_st;
+	const bool _showIcon = true;
+	const bool _showText = true;
+	bool _active = false;
+
+};
+
+SideButton::SideButton(
+	QWidget *parent,
+	const style::SideBarButton &st,
+	Ui::ChatsFiltersTabsMode mode)
+: RippleButton(parent, st.ripple)
+, _st(st)
+, _showIcon(mode != Ui::ChatsFiltersTabsMode::TextOnly)
+, _showText(mode != Ui::ChatsFiltersTabsMode::IconsOnly) {
+	setAccessibleName(Tr(u"Agent"_q));
+}
+
+void SideButton::setActive(bool active) {
+	if (_active != active) {
+		_active = active;
+		update();
+	}
+}
+
+int SideButton::resizeGetHeight(int newWidth) {
+	return _st.minHeight;
+}
+
+void SideButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), _active ? _st.textBgActive : _st.textBg);
+	paintRipple(p, 0, 0);
+	if (_showIcon) {
+		const auto box = Tele::FolderBarIconSize(st::foldersBots.width());
+		const auto x = (_st.iconPosition.x() < 0)
+			? (width() - box) / 2
+			: _st.iconPosition.x();
+		const auto y = (_st.iconPosition.y() < 0)
+			? (height() - box) / 2
+			: _st.iconPosition.y();
+		const auto inset = box * 0.16;
+		PaintSparkles(
+			p,
+			QRectF(x + inset, y + inset, box - 2 * inset, box - 2 * inset),
+			(_active ? st::sideBarIconFgActive : st::sideBarIconFg)->c);
+	}
+	if (_showText) {
+		const auto &font = _st.style.font;
+		const auto available = std::max(width() - 2 * _st.textSkip, 0);
+		const auto text = font->elided(Tr(u"Agent"_q), available);
+		p.setFont(font);
+		p.setPen(_active ? _st.textFgActive : _st.textFg);
+		p.drawText(
+			(width() - font->width(text)) / 2,
+			_st.textTop + font->ascent,
+			text);
+	}
+}
+
+} // namespace
+
+void SetupFiltersMenuButton(
+		not_null<Ui::VerticalLayout*> container,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto current = container->lifetime().make_state<
+		base::unique_qptr<Ui::SlideWrap<SideButton>>>();
+	Core::App().settings().chatFiltersTabsModeValue(
+	) | rpl::on_next([=](Ui::ChatsFiltersTabsMode value) {
+		const auto mode = Ui::VerticalChatsFiltersTabsMode(value);
+		const auto &st = ButtonStyle(mode);
+		*current = nullptr;
+		const auto wrap = container->insert(
+			std::min(1, container->count()),
+			object_ptr<Ui::SlideWrap<SideButton>>(
+				container,
+				object_ptr<SideButton>(container, st, mode)));
+		*current = base::unique_qptr<Ui::SlideWrap<SideButton>>(wrap);
+		const auto button = wrap->entity();
+		button->setClickedCallback([=] {
+			ShowAgent(controller);
+		});
+		AgentSectionShownValue(
+			controller
+		) | rpl::on_next([=](bool shown) {
+			button->setActive(shown);
+		}, button->lifetime());
+		wrap->toggleOn(rpl::combine(
+			AgentConfiguredValue(session),
+			AgentNavigationValue()
+		) | rpl::map([](bool configured, const QString &navigation) {
+			return configured && (navigation != u"chat"_q);
+		}), anim::type::instant);
+		wrap->finishAnimating();
+	}, container->lifetime());
+}
+
