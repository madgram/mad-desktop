+class UserBubble final : public Ui::RpWidget {
+public:
+	UserBubble(QWidget *parent, const Message &message);
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+
+private:
