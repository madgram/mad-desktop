+[[nodiscard]] QPen GlyphPen(const QRectF &rect, const QColor &color) {
+	auto pen = QPen(color);
+	pen.setWidthF(std::max(rect.width() * 0.12, 1.));
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	return pen;
+}
+
+void PaintListGlyph(QPainter &p, const QRectF &rect, const QColor &color) {
+	p.setPen(GlyphPen(rect, color));
+	p.setBrush(Qt::NoBrush);
+	for (auto i = 0; i != 3; ++i) {
+		const auto y = rect.top() + rect.height() * (0.25 + 0.25 * i);
+		p.drawLine(
+			QPointF(rect.left() + rect.width() * 0.1, y),
+			QPointF(rect.right() - rect.width() * 0.1, y));
+	}
+}
+
+void PaintSearchGlyph(QPainter &p, const QRectF &rect, const QColor &color) {
+	p.setPen(GlyphPen(rect, color));
+	p.setBrush(Qt::NoBrush);
+	const auto size = rect.width() * 0.62;
+	p.drawEllipse(QRectF(
+		rect.left() + rect.width() * 0.08,
+		rect.top() + rect.height() * 0.08,
+		size,
+		size));
+	p.drawLine(
+		QPointF(
+			rect.left() + rect.width() * 0.62,
+			rect.top() + rect.height() * 0.62),
+		QPointF(
+			rect.right() - rect.width() * 0.06,
+			rect.bottom() - rect.height() * 0.06));
+}
+
+void PaintCrossGlyph(QPainter &p, const QRectF &rect, const QColor &color) {
+	p.setPen(GlyphPen(rect, color));
+	p.setBrush(Qt::NoBrush);
+	const auto inset = rect.width() * 0.2;
+	p.drawLine(
+		QPointF(rect.left() + inset, rect.top() + inset),
+		QPointF(rect.right() - inset, rect.bottom() - inset));
+	p.drawLine(
+		QPointF(rect.right() - inset, rect.top() + inset),
+		QPointF(rect.left() + inset, rect.bottom() - inset));
+}
+
+void PaintDotsGlyph(QPainter &p, const QRectF &rect, const QColor &color) {
+	p.setPen(Qt::NoPen);
+	p.setBrush(color);
+	const auto size = rect.width() * 0.2;
+	for (auto i = 0; i != 3; ++i) {
+		p.drawEllipse(QRectF(
+			rect.left() + rect.width() * (0.1 + 0.3 * i),
+			rect.center().y() - size / 2.,
+			size,
+			size));
+	}
+}
