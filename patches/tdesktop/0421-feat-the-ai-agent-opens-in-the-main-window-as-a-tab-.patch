+	addAction(
+		pinned ? Tr(u"Unpin"_q) : Tr(u"Pin"_q),
+		[=] { TogglePin(history); },
+		pinned ? &st::menuIconUnpin : &st::menuIconPin);
+	addAction(Tr(u"Agent settings"_q), [=] {
+		ShowAgentSettings(controller);
+	}, &st::menuIconSettings);
+}
