+[[nodiscard]] std::map<
+		not_null<Window::SessionController*>,
+		rpl::variable<int>> &Shown() {
+	static auto result = std::map<
+		not_null<Window::SessionController*>,
+		rpl::variable<int>>();
+	return result;
+}
+
+[[nodiscard]] rpl::variable<int> &ShownFor(
+		not_null<Window::SessionController*> controller) {
+	auto &map = Shown();
+	auto i = map.find(controller);
+	if (i == end(map)) {
+		i = map.emplace(controller, 0).first;
+		controller->lifetime().add([=] {
+			Shown().erase(controller);
+		});
+	}
+	return i->second;
+}
+
+class Memento final : public Window::SectionMemento {
+public:
+	object_ptr<Window::SectionWidget> createWidget(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller,
+		Window::Column column,
+		const QRect &geometry) override;
+
+};
+
+class TopBar final : public Ui::RpWidget {
+public:
+	TopBar(QWidget *parent, not_null<Window::SessionController*> controller);
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+
+private:
+	void layout(int width);
+	void showMenu();
+
+	const not_null<Window::SessionController*> _controller;
+	object_ptr<Ui::IconButton> _back;
+	object_ptr<PaintedButton> _settings;
+	object_ptr<Ui::IconButton> _menu;
+	base::unique_qptr<Ui::PopupMenu> _popup;
+
+};
+
+TopBar::TopBar(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: RpWidget(parent)
+, _controller(controller)
+, _back(this, st::historyTopBarBack)
+, _settings(this, [](QPainter &p, QRect rect, bool over) {
+	st::menuIconSettings.paintInCenter(
+		p,
+		rect,
+		over ? st::menuIconFgOver->c : st::menuIconFg->c);
+})
+, _menu(this, st::infoTopBarMenu) {
+	_back->setClickedCallback([=] {
+		controller->showBackFromStack();
+	});
+	_settings->resize(CardScaled(44), st::topBarHeight);
+	_settings->setClickedCallback([=] {
+		ShowAgentSettings(controller);
+	});
+	_menu->setClickedCallback([=] {
+		showMenu();
+	});
+	controller->adaptive().value() | rpl::on_next([=] {
+		_back->setVisible(controller->adaptive().isOneColumn());
+		layout(width());
+		update();
+	}, lifetime());
+	widthValue() | rpl::on_next([=](int width) {
+		layout(width);
+	}, lifetime());
+}
+
+int TopBar::resizeGetHeight(int newWidth) {
+	return st::topBarHeight;
+}
+
+void TopBar::layout(int width) {
+	_back->moveToLeft(0, 0, width);
+	_menu->moveToRight(0, (st::topBarHeight - _menu->height()) / 2, width);
+	_settings->moveToRight(
+		_menu->width(),
+		(st::topBarHeight - _settings->height()) / 2,
+		width);
+}
+
+void TopBar::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), st::topBarBg);
+	const auto left = _back->isHidden()
+		? CardScaled(20)
+		: _back->width();
+	const auto icon = CardScaled(22);
+	PaintSparkles(
+		p,
+		QRectF(left, (height() - icon) / 2., icon, icon),
+		st::windowActiveTextFg->c);
+	const auto font = CardFont(15, true);
+	const auto textLeft = left + icon + CardScaled(10);
+	const auto available = std::max(
+		width() - textLeft - _menu->width() - _settings->width(),
+		0);
+	p.setFont(font);
+	p.setPen(st::dialogsNameFg);
+	p.drawText(
+		textLeft,
+		(height() - font->height) / 2 + font->ascent,
+		font->elided(Tr(u"AI agent"_q), available));
+}
+
+void TopBar::showMenu() {
+	const auto controller = _controller;
+	_popup = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	_popup->addAction(Tr(u"Clear the conversation"_q), [=] {
+		controller->show(Ui::MakeConfirmBox({
+			.text = Tr(u"Clear the conversation with the agent?"_q),
+			.confirmed = [=](Fn<void()> close) {
+				Runner::For(&controller->session()).clear();
+				close();
+			},
+			.confirmText = Tr(u"Clear"_q),
+			.confirmStyle = &st::attentionBoxButton,
+		}));
+	}, &st::menuIconClear);
+	_popup->addAction(Tr(u"Agent settings"_q), [=] {
+		ShowAgentSettings(controller);
+	}, &st::menuIconSettings);
+	_popup->popup(QCursor::pos());
+}
+
+class Section final : public Window::SectionWidget {
+public:
+	Section(QWidget *parent, not_null<Window::SessionController*> controller);
+	~Section();
+
+	bool hasTopBarShadow() const override {
+		return true;
+	}
+	QPixmap grabForShowAnimation(
+		const Window::SectionSlideParams &params) override;
+	bool showInternal(
+		not_null<Window::SectionMemento*> memento,
+		const Window::SectionShow &params) override;
+	std::shared_ptr<Window::SectionMemento> createMemento() override;
+	Dialogs::RowDescriptor activeChat() const override;
+	bool floatPlayerHandleWheelEvent(QEvent *e) override;
+	QRect floatPlayerAvailableRect() override;
+
+protected:
+	void resizeEvent(QResizeEvent *e) override;
+	void paintEvent(QPaintEvent *e) override;
+	void showAnimatedHook(const Window::SectionSlideParams &params) override;
+	void doSetInnerFocus() override;
+
+private:
+	void updateAdaptiveLayout();
+
+	object_ptr<TopBar> _topBar;
+	object_ptr<Ui::PlainShadow> _topBarShadow;
+	object_ptr<ChatView> _chat;
+
+};
+
+Section::Section(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: Window::SectionWidget(parent, controller)
+, _topBar(this, controller)
+, _topBarShadow(this)
+, _chat(this, controller) {
+	auto &shown = ShownFor(controller);
+	shown = shown.current() + 1;
+	_topBar->move(0, 0);
+	_topBar->resizeToWidth(width());
+	_topBar->show();
+	_topBarShadow->raise();
+	controller->adaptive().value() | rpl::on_next([=] {
+		updateAdaptiveLayout();
+	}, lifetime());
+}
+
+Section::~Section() {
+	auto &map = Shown();
+	const auto i = map.find(controller());
+	if (i != end(map)) {
+		i->second = std::max(i->second.current() - 1, 0);
+	}
+}
+
+void Section::updateAdaptiveLayout() {
+	_topBarShadow->moveToLeft(
+		controller()->adaptive().isOneColumn() ? 0 : st::lineWidth,
+		_topBar->height());
+}
+
+QPixmap Section::grabForShowAnimation(
+		const Window::SectionSlideParams &params) {
+	if (params.withTopBarShadow) {
+		_topBarShadow->hide();
+	}
+	_chat->prepareForShow();
+	auto result = Ui::GrabWidget(this);
+	if (params.withTopBarShadow) {
+		_topBarShadow->show();
+	}
+	return result;
+}
+
+bool Section::showInternal(
+		not_null<Window::SectionMemento*> memento,
+		const Window::SectionShow &params) {
+	return (dynamic_cast<Memento*>(memento.get()) != nullptr);
+}
+
+std::shared_ptr<Window::SectionMemento> Section::createMemento() {
+	return std::make_shared<Memento>();
+}
+
+Dialogs::RowDescriptor Section::activeChat() const {
+	if (const auto history = AgentChatHistory(&controller()->session())) {
+		return { history, FullMsgId() };
+	}
+	return {};
+}
+
+bool Section::floatPlayerHandleWheelEvent(QEvent *e) {
+	return false;
+}
+
+QRect Section::floatPlayerAvailableRect() {
+	return mapToGlobal(_chat->geometry());
+}
+
+void Section::resizeEvent(QResizeEvent *e) {
+	if (!width() || !height()) {
+		return;
+	}
+	_topBar->resizeToWidth(width());
+	_topBarShadow->resize(width(), st::lineWidth);
+	updateAdaptiveLayout();
+	const auto top = _topBar->height();
+	_chat->setGeometry(0, top, width(), std::max(height() - top, 0));
+}
+
+void Section::paintEvent(QPaintEvent *e) {
+	if (animatingShow()) {
+		QPainter(this).fillRect(e->rect(), st::windowBg);
+		SectionWidget::paintEvent(e);
+		return;
+	} else if (controller()->contentOverlapped(this, e)) {
+		return;
+	}
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), st::windowBg);
+}
+
+void Section::showAnimatedHook(const Window::SectionSlideParams &params) {
+	if (params.withTopBarShadow) {
+		_topBarShadow->show();
+	}
+}
+
+void Section::doSetInnerFocus() {
+	_chat->setInnerFocus();
+}
+
+object_ptr<Window::SectionWidget> Memento::createWidget(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller,
+		Window::Column column,
+		const QRect &geometry) {
+	if (column == Window::Column::Third) {
+		return nullptr;
+	}
+	auto result = object_ptr<Section>(parent, controller);
+	result->setGeometry(geometry);
+	return result;
+}
+
+} // namespace
+
+void ShowAgentSection(not_null<Window::SessionController*> controller) {
+	if (const auto history = AgentChatHistory(&controller->session())) {
+		controller->setActiveChatEntry({ history, FullMsgId() });
+	} else {
+		controller->setActiveChatEntry(Dialogs::Key());
+	}
+	controller->showSection(
+		std::make_shared<Memento>(),
+		Window::SectionShow());
+}
+
+rpl::producer<bool> AgentSectionShownValue(
+		not_null<Window::SessionController*> controller) {
+	return ShownFor(
+		controller
+	).value() | rpl::map([](int count) {
+		return (count > 0);
+	}) | rpl::distinct_until_changed();
+}
+
+} // namespace Tele::Agent
