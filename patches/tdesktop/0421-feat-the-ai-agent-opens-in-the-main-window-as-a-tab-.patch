+void ChatView::setupComposer() {
+	const auto composer = _composer.data();
+	_attach = Ui::CreateChild<Ui::IconButton>(composer, st::historyAttach);
+	_field = Ui::CreateChild<Ui::InputField>(
+		composer,
+		FieldStyle(),
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(Tr(u"Message the agent"_q)),
+		QString());
+	_field->setSubmitSettings(Ui::InputField::SubmitSettings::Enter);
+	_field->setMinHeight(
+		st::historySendSize.height() - 2 * st::historySendPadding);
+	_field->setMaxHeight(CardScaled(160));
+	_field->setDocumentMargin(4.);
+	_field->setAdditionalMargin(style::ConvertScale(4) - 4);
+	_send = Ui::CreateChild<Ui::SendButton>(composer, st::aiComposeSendButton);
+	_send->setState({ .type = Ui::SendButton::Type::Send });
+	const auto preview = Ui::CreateChild<PaintedButton>(composer, [=](
+			QPainter &p,
+			QRect rect,
+			bool over) {
+		if (_pendingThumb.isNull()) {
+			return;
+		}
+		auto hq = PainterHighQualityEnabler(p);
+		const auto size = CardScaled(64);
+		const auto target = QRect(0, (rect.height() - size) / 2, size, size);
+		auto path = QPainterPath();
+		const auto radius = CardScaled(10) * 1.;
+		path.addRoundedRect(QRectF(target), radius, radius);
+		p.setClipPath(path);
+		const auto source = _pendingThumb.size();
+		const auto side = std::min(source.width(), source.height());
+		p.drawImage(
+			target,
+			_pendingThumb,
+			QRect(
+				(source.width() - side) / 2,
+				(source.height() - side) / 2,
+				side,
+				side));
+		p.setClipping(false);
+		const auto cross = CardScaled(20);
+		const auto circle = QRectF(
+			target.x() + target.width() - cross + CardScaled(4),
+			target.y() - CardScaled(4),
+			cross,
+			cross);
+		p.setPen(Qt::NoPen);
+		p.setBrush(over ? st::windowBoldFg : st::windowSubTextFg);
+		p.drawEllipse(circle);
+		auto pen = QPen(st::windowBg->c);
+		pen.setWidthF(CardScaled(2));
+		pen.setCapStyle(Qt::RoundCap);
+		p.setPen(pen);
+		const auto inset = cross * 0.32;
+		p.drawLine(
+			QPointF(circle.left() + inset, circle.top() + inset),
+			QPointF(circle.right() - inset, circle.bottom() - inset));
+		p.drawLine(
+			QPointF(circle.right() - inset, circle.top() + inset),
+			QPointF(circle.left() + inset, circle.bottom() - inset));
+	});
+	preview->setClickedCallback([=] {
+		clearPendingImage();
+	});
+	preview->hide();
+	_preview = preview;
+	_attach->setClickedCallback([=] {
+		chooseImage();
+	});
+	_send->setClickedCallback([=] {
+		auto &runner = Runner::For(_session);
+		if (runner.running()) {
+			runner.stop();
+		} else {
+			submit();
+		}
+	});
+	_field->submits() | rpl::on_next([=] {
+		submit();
+	}, _field->lifetime());
+	_field->heightChanges() | rpl::on_next([=] {
+		layout();
+	}, _field->lifetime());
+	composer->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(composer);
+		auto hq = PainterHighQualityEnabler(p);
+		p.fillRect(0, 0, composer->width(), st::lineWidth, st::shadowFg);
+		const auto radius = std::min(_fieldBg.height() / 2., CardScaled(22) * 1.);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(QRectF(_fieldBg), radius, radius);
+	}, composer->lifetime());
+}
+
+int ChatView::layoutComposer(int width) {
+	const auto padding = CardScaled(12);
+	const auto single = CardScaled(44);
+	const auto previewHeight = _pendingImage ? CardScaled(72) : 0;
+	_preview->setVisible(previewHeight > 0);
+	if (previewHeight) {
+		_preview->setGeometry(
+			padding + _attach->width() + CardScaled(6),
+			padding,
+			CardScaled(80),
+			previewHeight);
+	}
+	const auto top = padding + (previewHeight
+		? (previewHeight + CardScaled(8))
+		: 0);
+	const auto inner = CardScaled(14);
+	const auto fieldLeft = padding + _attach->width() + CardScaled(6) + inner;
+	const auto fieldRight = width
+		- padding
+		- _send->width()
+		- CardScaled(8)
+		- inner;
+	const auto fieldWidth = std::max(fieldRight - fieldLeft, 1);
+	_field->resizeToWidth(fieldWidth);
+	const auto background = std::max(
+		_field->height() + 2 * CardScaled(4),
+		single);
+	_field->moveToLeft(
+		fieldLeft,
+		top + (background - _field->height()) / 2,
+		width);
+	_fieldBg = QRect(
+		fieldLeft - inner,
+		top,
+		fieldWidth + 2 * inner,
+		background);
+	const auto lineCenter = top + background - single / 2;
+	_attach->moveToLeft(
+		padding,
+		lineCenter - _attach->height() / 2,
+		width);
+	_send->moveToLeft(
+		width - padding - _send->width(),
+		lineCenter - _send->height() / 2,
+		width);
+	return top + background + padding;
+}
+
+void ChatView::layout() {
+	const auto width = this->width();
+	const auto height = this->height();
+	if (width <= 0 || height <= 0) {
+		return;
+	}
+	auto top = 0;
+	if (_barShown) {
+		_bar->setGeometry(0, 0, width, CardScaled(kBarHeight));
+		top = CardScaled(kBarHeight);
+	}
+	const auto composerHeight = layoutComposer(width);
+	_composer->setGeometry(0, height - composerHeight, width, composerHeight);
+	_composer->update();
+	_scroll->setGeometry(
+		0,
+		top,
+		width,
+		std::max(height - top - composerHeight, 0));
+	_content->resizeToWidth(width);
+	if (_empty) {
+		static_cast<EmptyState*>(_empty)->setMinimalHeight(_scroll->height());
+	}
+}
+
+void ChatView::resizeEvent(QResizeEvent *e) {
+	layout();
+}
+
+void ChatView::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), st::windowBg);
+}
+
+void ChatView::refresh() {
+	const auto &runner = Runner::For(_session);
+	const auto &messages = runner.messages();
+	const auto count = int(messages.size());
+	const auto lastId = count ? messages.back().id : QString();
+	const auto running = runner.running();
+	const auto configured = !runner.key(CurrentProvider()).isEmpty();
+	const auto wasTop = _scroll->scrollTop();
+	const auto atBottom = (wasTop
+		>= _scroll->scrollTopMax() - CardScaled(48));
+	auto rebuilt = false;
+	if (count != _shownCount
+		|| lastId != _shownLastId
+		|| runner.lastError() != _shownError
+		|| running != _shownRunning
+		|| configured != _shownConfigured) {
+		_shownCount = count;
+		_shownLastId = lastId;
+		_shownError = runner.lastError();
+		_shownRunning = running;
+		_shownConfigured = configured;
+		rebuild();
+		rebuilt = true;
+	}
+	if (_live) {
+		const auto streaming = runner.streaming();
+		if (streaming.isEmpty()) {
+			_live->setTextColorOverride(st::windowSubTextFg->c);
+			_live->setText(runner.status().isEmpty()
+				? Tr(u"Thinking…"_q)
+				: runner.status());
+		} else {
+			_live->setTextColorOverride(std::nullopt);
+			_live->setMarkedText(TextWithEntities::Simple(streaming));
+		}
+	}
+	_send->setState({
+		.type = (running
+			? Ui::SendButton::Type::Stop
+			: Ui::SendButton::Type::Send),
+	});
+	_content->resizeToWidth(_scroll->width());
+	if (atBottom) {
+		scrollToBottom();
+	} else if (rebuilt) {
+		_scroll->scrollToY(wasTop);
+	}
+}
+
+void ChatView::rebuild() {
+	_content->clear();
+	_live = nullptr;
+	_empty = nullptr;
+	const auto &runner = Runner::For(_session);
+	if (runner.messages().empty() && !runner.running()) {
+		addEmptyState();
+	} else {
+		addMessages();
+	}
+	_content->resizeToWidth(_scroll->width());
+}
+
+void ChatView::addEmptyState() {
+	const auto session = _session;
+	const auto controller = _controller;
+	const auto empty = _content->add(object_ptr<EmptyState>(
+		_content,
+		_shownConfigured,
+		[=](QString text) {
+			Runner::For(session).send(text);
+		},
+		[=] {
+			ShowAgentSettings(controller);
+		}));
+	empty->setMinimalHeight(_scroll->height());
+	_empty = empty;
+}
+
+void ChatView::addMessages() {
+	const auto &runner = Runner::For(_session);
+	const auto &list = runner.messages();
+	const auto side = CardScaled(kSide);
+	const auto controller = _controller;
+	_content->add(object_ptr<Ui::FixedHeightWidget>(
+		_content,
+		CardScaled(12)));
+	for (auto i = 0; i != int(list.size()); ++i) {
+		const auto &message = list[i];
+		if (message.role == Role::User) {
+			if (!message.text.isEmpty() || !message.images.empty()) {
+				_content->add(object_ptr<UserBubble>(_content, message));
+			}
+			continue;
+		} else if (message.role != Role::Assistant) {
+			continue;
+		}
+		if (!message.text.trimmed().isEmpty()) {
+			const auto text = message.text;
+			_content->add(object_ptr<AssistantText>(_content, text, [=] {
+				CopyMarkdown(text);
+				controller->showToast(Tr(u"Copied."_q));
+			}));
+		}
+		for (const auto &call : message.toolCalls) {
+			auto data = ChipData{ .name = call.name };
+			const auto j = std::find_if(
+				begin(list) + i + 1,
+				end(list),
+				[&](const Message &result) {
+					return (result.role == Role::Tool)
+						&& (result.toolCallId == call.id);
+				});
+			if (j == end(list)) {
+				data.state = runner.running()
+					? ChipState::Running
+					: ChipState::Failed;
+				data.title = ToolStatus(call.name);
+			} else {
+				data.state = j->isError ? ChipState::Failed : ChipState::Done;
+				data.title = j->toolTitle.isEmpty()
+					? (j->isError
+						? ToolStatus(call.name)
+						: Tr(u"Used a tool"_q))
+					: j->toolTitle;
+				if (j->isError) {
+					data.reason = j->text.simplified().left(160);
+				}
+			}
+			_content->add(object_ptr<ToolChip>(_content, std::move(data)));
+		}
+	}
+	if (runner.running()) {
+		_live = _content->add(
+			object_ptr<Ui::FlatLabel>(_content, AssistantStyle()),
+			QMargins(side, CardScaled(4), side, CardScaled(8)));
+		_live->setSelectable(true);
+	}
+	if (!runner.lastError().isEmpty()) {
+		_content->add(
+			object_ptr<Ui::FlatLabel>(
+				_content,
+				runner.lastError(),
+				ErrorStyle()),
+			QMargins(side, CardScaled(6), side, CardScaled(6)));
+		if (runner.canRetry()) {
+			const auto session = _session;
+			const auto retry = _content->add(
+				object_ptr<Ui::LinkButton>(_content, Tr(u"Try again"_q)),
+				QMargins(side, 0, side, CardScaled(6)));
+			retry->setClickedCallback([=] {
+				Runner::For(session).retry();
+			});
+		}
+	}
+	_content->add(object_ptr<Ui::FixedHeightWidget>(
+		_content,
+		CardScaled(12)));
+}
+
+void ChatView::submit() {
+	auto &runner = Runner::For(_session);
+	if (runner.running()) {
+		return;
+	}
+	const auto text = _field->getLastText().trimmed();
+	auto images = std::vector<Image>();
+	if (_pendingImage) {
+		images.push_back(*_pendingImage);
+	}
+	if (text.isEmpty() && images.empty()) {
+		return;
+	}
+	_field->clear();
+	clearPendingImage();
+	runner.send(text, std::move(images));
+	scrollToBottom();
+}
+
+void ChatView::chooseImage() {
+	FileDialog::GetOpenPath(
+		this,
+		Tr(u"Attach photo"_q),
+		FileDialog::ImagesFilter(),
+		crl::guard(this, [=](FileDialog::OpenResult &&result) {
+			auto image = Images::Read({
+				.path = (result.paths.isEmpty()
+					? QString()
+					: result.paths.front()),
+				.content = result.remoteContent,
+			}).image;
+			if (image.isNull()) {
+				_controller->showToast(Tr(u"Could not open the image."_q));
+				return;
+			}
+			setPendingImage(std::move(image));
+		}));
+}
+
+void ChatView::setPendingImage(QImage image) {
+	auto encoded = PreparePhoto(image);
+	if (encoded.base64.isEmpty()) {
+		_controller->showToast(Tr(u"Could not open the image."_q));
+		return;
+	}
+	_pendingImage = std::move(encoded);
+	const auto ratio = style::DevicePixelRatio();
+	const auto side = CardScaled(64) * ratio;
+	_pendingThumb = image.scaled(
+		side,
+		side,
+		Qt::KeepAspectRatioByExpanding,
+		Qt::SmoothTransformation);
+	layout();
+	_preview->update();
+	_field->setFocusFast();
+}
+
+void ChatView::clearPendingImage() {
+	_pendingImage.reset();
+	_pendingThumb = QImage();
+	layout();
+}
+
+void ChatView::scrollToBottom() {
+	crl::on_main(this, [=] {
+		_scroll->scrollToY(_scroll->scrollTopMax());
+	});
+}
+
+void ChatView::prepareForShow() {
+	if (width() > 0 && height() > 0) {
+		layout();
+		_scroll->scrollToY(_scroll->scrollTopMax());
+	}
+}
+
+} // namespace Tele::Agent
