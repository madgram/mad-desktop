+
+constexpr auto kMaxUserId = BareId(0xFFFFFFFFFFFFULL);
+constexpr auto kUserId = UserId(kMaxUserId - (kMaxUserId % 1000) + 2);
+constexpr auto kUserpicSize = 320;
+constexpr auto kPreviewLimit = 300;
+
+struct State {
+	bool shown = false;
+	FullMsgId mirrored;
+	QString text;
+	TimeId date = 0;
+	TimeId placeholderDate = 0;
+	QString status;
+	bool running = false;
+};
+
+[[nodiscard]] base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<State>> &States() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<State>>();
+	return result;
+}
+
+[[nodiscard]] State *StateFor(not_null<Main::Session*> session) {
+	const auto &states = States();
+	const auto i = states.find(session);
+	return (i != end(states)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] QString PlainPreview(QString text) {
+	for (const auto &marker : {
+			u"**"_q,
+			u"__"_q,
+			u"~~"_q,
+			u"||"_q,
+			u"`"_q,
+		}) {
+		text.remove(marker);
+	}
+	return text.simplified().left(kPreviewLimit);
+}
+
+[[nodiscard]] not_null<UserData*> EnsureUser(
+		not_null<Main::Session*> session) {
+	using Flag = MTPDuser::Flag;
+	const auto owner = &session->data();
+	const auto user = owner->processUser(MTP_user(
+		MTP_flags(Flag::f_first_name | Flag::f_photo),
+		MTP_long(kUserId.bare),
+		MTPlong(),
+		MTP_string(Tr(u"AI agent"_q)),
+		MTPstring(),
+		MTPstring(),
+		MTPstring(),
+		MTP_userProfilePhotoEmpty(),
+		MTPUserStatus(),
+		MTPint(),
+		MTPVector<MTPRestrictionReason>(),
+		MTPstring(),
+		MTPstring(),
+		MTPEmojiStatus(),
+		MTPVector<MTPUsername>(),
+		MTPRecentStory(),
+		MTPPeerColor(),
+		MTPPeerColor(),
+		MTPint(),
+		MTPlong(),
+		MTPlong(),
+		MTPlong()));
+	if (user->notify().settingsUnknown()) {
+		user->notify().resetToDefault();
+	}
+	return user;
+}
+
+[[nodiscard]] not_null<History*> EnsureHistory(not_null<UserData*> user) {
+	const auto history = user->owner().history(user);
+	if (!history->folderKnown()) {
+		history->applyDialogFields(nullptr, 0, 0, 0);
+		history->dialogEntryApplied();
+	}
+	return history;
+}
+
+struct Preview {
+	QString text;
+	TimeId date = 0;
+};
+
+[[nodiscard]] Preview LastPreview(not_null<Main::Session*> session) {
+	const auto &messages = Runner::For(session).messages();
+	for (auto i = int(messages.size()); i != 0; --i) {
+		const auto &message = messages[i - 1];
+		if (message.role == Role::Tool || message.text.trimmed().isEmpty()) {
+			continue;
+		}
+		auto text = PlainPreview(message.text);
+		if (message.role == Role::User) {
+			text = tr::lng_from_you(tr::now) + u": "_q + text;
+		}
+		return { .text = text, .date = TimeId(message.date) };
+	}
+	return { .text = Tr(u"How can I help?"_q) };
+}
+
+void Mirror(not_null<Main::Session*> session, not_null<State*> state) {
+	const auto history = EnsureHistory(EnsureUser(session));
+	auto preview = LastPreview(session);
+	if (!preview.date) {
+		if (!state->placeholderDate) {
+			state->placeholderDate = base::unixtime::now();
+		}
+		preview.date = state->placeholderDate;
+	}
+	const auto owner = &session->data();
+	const auto existing = owner->message(state->mirrored);
+	if (existing
+		&& (state->text == preview.text)
+		&& (state->date == preview.date)) {
+		return;
+	}
+	if (existing) {
+		existing->destroy();
+	}
+	const auto item = history->makeMessage({
+		.id = owner->nextLocalMessageId(),
+		.flags = MessageFlag::Local,
+		.from = history->peer->id,
+		.date = preview.date,
+	}, TextWithEntities{ preview.text }, MTP_messageMediaEmpty());
+	history->addNewLocalMessage(item);
+	state->mirrored = item->fullId();
+	state->text = preview.text;
+	state->date = preview.date;
+	history->updateChatListExistence();
+	owner->sendHistoryChangeNotifications();
+}
+
+void Show(not_null<Main::Session*> session, not_null<State*> state) {
+	state->shown = true;
+	Mirror(session, state);
+	auto &store = Runner::For(session).store();
+	if (store.chatPinned()) {
+		RefreshLocalPins(session);
+	} else if (SetLocalPin(
+			session->data().history(AgentPeerId()),
+			FilterId(),
+			true,
+			true)) {
+		store.setChatPinned(true);
+	}
+}
+
+void Hide(not_null<Main::Session*> session, not_null<State*> state) {
+	state->shown = false;
+	state->mirrored = FullMsgId();
+	state->text = QString();
+	state->date = 0;
+	const auto history = session->data().historyLoaded(AgentPeerId());
+	if (!history) {
+		return;
+	}
+	history->clear(History::ClearType::DeleteChat);
+	RefreshLocalPins(session);
+	history->updateChatListExistence();
+	session->data().sendHistoryChangeNotifications();
+}
+
+void TogglePin(not_null<History*> history) {
+	(void)SetLocalPin(history, FilterId(), !history->isPinnedDialog(FilterId()));
+}
+
+} // namespace
+
+PeerId AgentPeerId() {
+	return peerFromUser(kUserId);
+}
+
+bool IsAgentPeer(const PeerData *peer) {
+	return peer && (peer->id == AgentPeerId());
+}
+
+bool AgentPinForced(not_null<Main::Session*> session, PeerId peerId) {
+	if (peerId != AgentPeerId()) {
+		return false;
+	}
+	const auto state = StateFor(session);
+	return state && state->shown;
+}
+
+QImage *AgentUserpic() {
+	struct Cached {
+		QImage image;
+		int palette = -1;
+	};
+	static auto cached = Cached();
+	if (cached.palette != style::PaletteVersion()) {
+		auto image = QImage(
+			QSize(kUserpicSize, kUserpicSize),
+			QImage::Format_ARGB32_Premultiplied);
+		image.fill(st::activeButtonBg->c);
+		auto p = QPainter(&image);
+		auto hq = PainterHighQualityEnabler(p);
+		const auto inset = kUserpicSize * 0.26;
+		PaintSparkles(
+			p,
+			QRectF(
+				inset,
+				inset,
+				kUserpicSize - 2 * inset,
+				kUserpicSize - 2 * inset),
+			st::activeButtonFg->c);
+		p.end();
+		cached.image = std::move(image);
+		cached.palette = style::PaletteVersion();
+	}
+	return &cached.image;
+}
+
+QString AgentStatus() {
+	return Tr(u"Works with your own API key"_q);
+}
+
+rpl::producer<bool> AgentConfiguredValue(not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(rpl::merge(
+		Runner::For(session).updates(),
+		AgentProviderValue() | rpl::to_empty
+	)) | rpl::map([=] {
+		return !Runner::For(session).key(CurrentProvider()).isEmpty();
+	}) | rpl::distinct_until_changed();
+}
+
+History *AgentChatHistory(not_null<Main::Session*> session) {
+	const auto state = StateFor(session);
+	return (state && state->shown)
+		? session->data().historyLoaded(AgentPeerId())
+		: nullptr;
+}
+
+void SetupAgentPeer(not_null<Main::Session*> session) {
+	auto &states = States();
+	if (states.contains(session)) {
+		return;
+	}
+	const auto state = states.emplace(
+		session,
+		std::make_unique<State>()).first->second.get();
+	session->lifetime().add([=] {
+		States().remove(session);
+	});
+	crl::on_main(session, [=] {
+		rpl::combine(
+			AgentConfiguredValue(session),
+			AgentNavigationValue()
+		) | rpl::map([](bool configured, const QString &navigation) {
+			return configured && (navigation == u"chat"_q);
+		}) | rpl::distinct_until_changed(
+		) | rpl::on_next([=](bool shown) {
+			if (shown) {
+				Show(session, state);
+			} else if (state->shown) {
+				Hide(session, state);
+			}
+		}, session->lifetime());
+
+		Runner::For(session).updates(
+		) | rpl::on_next([=] {
+			if (!state->shown) {
+				return;
+			}
+			const auto &runner = Runner::For(session);
+			const auto running = runner.running();
+			const auto status = runner.status();
+			Mirror(session, state);
+			if (running != state->running || status != state->status) {
+				state->running = running;
+				state->status = status;
+				if (const auto history = AgentChatHistory(session)) {
+					history->updateChatListEntry();
+				}
+			}
+		}, session->lifetime());
+	});
+}
+
+void FillAgentMenu(
+		not_null<Window::SessionController*> controller,
+		not_null<History*> history,
+		const Ui::Menu::MenuCallback &addAction) {
