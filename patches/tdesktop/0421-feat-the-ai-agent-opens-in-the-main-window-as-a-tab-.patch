+void AddSubpageButtons(SectionBuilder &builder, const QString &path) {
+	if (Picked) {
+		return;
+	}
+	auto parent = Type();
+	for (const auto &category : Categories()) {
+		if (category.path == path) {
+			parent = category.id;
+		}
+	}
+	for (const auto &category : Categories()) {
+		if (!parent || category.parent != parent) {
+			continue;
+		}
+		const auto button = builder.addSectionButton({
+			.title = rpl::single(::Tele::Tr(category.title)),
+			.targetSection = category.id,
+			.icon = { category.icon },
+			.keywords = category.keywords,
+		});
+		if (button) {
+			SetupCopyLink(button, category.id, QString());
+		}
+	}
+}
+
+void AddAgentNavigation(SectionBuilder &builder) {
+	auto &option = base::options::lookup<QString>(
+		::Tele::kOptionAgentNavigation);
+	const auto id = option.id();
+	if (!Shown(id)) {
+		return;
+	}
+	const auto name = ::Tele::Tr(option.name());
+	const auto description = ::Tele::Tr(option.description());
+	builder.add([&](const WidgetContext &ctx) {
+		auto result = object_ptr<Ui::RpWidget>(ctx.container);
+		const auto row = result.data();
+		const auto &padding = st::settingsButtonNoIcon.padding;
+		row->resize(row->width(), ::Tele::CardScaled(56));
+		const auto control = Ui::CreateChild<::Tele::SegmentedControl>(
+			row,
+			std::vector<QString>{
+				::Tele::Tr(u"As a tab"_q),
+				::Tele::Tr(u"As a chat"_q),
+			},
+			(::Tele::AgentNavigation() == u"chat"_q) ? 1 : 0);
+		control->resizeToWidth(::Tele::CardScaled(190));
+		control->selectedChanges() | rpl::on_next([=](int index) {
+			::Tele::SetAgentNavigation(index ? u"chat"_q : QString());
+		}, control->lifetime());
+		::Tele::AgentNavigationValue(
+		) | rpl::on_next([=](const QString &value) {
+			control->setSelected((value == u"chat"_q) ? 1 : 0);
+		}, control->lifetime());
+		row->widthValue() | rpl::on_next([=](int width) {
+			control->moveToRight(
+				padding.right(),
+				(row->height() - control->height()) / 2,
+				width);
+		}, row->lifetime());
+		row->paintRequest() | rpl::on_next([=] {
+			auto p = QPainter(row);
+			const auto &st = st::settingsExperimentalTitle;
+			const auto &font = st.style.font;
+			const auto available = std::max(
+				row->width()
+					- padding.left()
+					- padding.right()
+					- control->width()
+					- ::Tele::CardScaled(12),
+				0);
+			p.setFont(font);
+			p.setPen(st.textFg);
+			p.drawText(
+				padding.left(),
+				(row->height() - font->height) / 2 + font->ascent,
+				font->elided(name, available));
+		}, row->lifetime());
+		SetupLink(row, id);
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+			.align = style::al_justify,
+		};
+	}, [&] {
+		return SearchEntry{
+			.id = id,
+			.title = name,
+			.keywords = {
+				description,
+				u"tab"_q,
+				u"chat"_q,
+				u"вкладка"_q,
+				u"чат"_q,
+			},
+		};
+	});
+	AddAbout(builder, id, description);
+}
+
+void AddAgentProvider(SectionBuilder &builder) {
+	auto &option = base::options::lookup<QString>(
+		::Tele::kOptionAgentProvider);
+	const auto id = option.id();
+	if (!Shown(id)) {
+		return;
+	}
+	const auto name = ::Tele::Tr(option.name());
+	builder.add([&](const WidgetContext &ctx) {
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto raw = result.data();
+		const auto &padding = st::settingsButtonNoIcon.padding;
+		raw->add(
+			object_ptr<Ui::FlatLabel>(
+				raw,
+				name,
+				st::settingsExperimentalTitle),
+			QMargins(
+				padding.left(),
+				padding.top(),
+				padding.right(),
+				::Tele::CardScaled(10)));
+		const auto values = std::vector<QString>{
+			QString(),
+			u"openai"_q,
+			u"anthropic-compatible"_q,
+			u"openai-compatible"_q,
+		};
+		const auto labels = std::vector<QString>{
+			::Tele::Tr(u"Anthropic"_q),
+			::Tele::Tr(u"OpenAI"_q),
+			::Tele::Tr(u"Anthropic-compatible"_q),
+			::Tele::Tr(u"OpenAI-compatible"_q),
+		};
+		const auto indexOf = [=](const QString &value) {
+			const auto i = ranges::find(values, value);
+			return (i != end(values)) ? int(i - begin(values)) : 0;
+		};
+		const auto chips = raw->add(
+			object_ptr<::Tele::ChipsSelector>(
+				raw,
+				labels,
+				indexOf(::Tele::AgentProvider())),
+			QMargins(
+				padding.left(),
+				0,
+				padding.right(),
+				padding.bottom()));
+		chips->selectedChanges() | rpl::on_next([=](int index) {
+			::Tele::SetAgentProvider(values[index]);
+		}, chips->lifetime());
+		::Tele::AgentProviderValue(
+		) | rpl::on_next([=](const QString &value) {
+			chips->setSelected(indexOf(value));
+		}, chips->lifetime());
+		SetupLink(raw, id);
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+			.align = style::al_justify,
+		};
+	}, [&] {
+		return SearchEntry{
+			.id = id,
+			.title = name,
+			.keywords = {
+				u"claude"_q,
+				u"chatgpt"_q,
+				u"openai"_q,
+				u"anthropic"_q,
+				u"provider"_q,
+				u"провайдер"_q,
+			},
+		};
+	});
+}
+
+void AddAgentPersona(SectionBuilder &builder) {
+	auto &option = base::options::lookup<QString>(
+		::Tele::kOptionAgentPersona);
+	const auto id = option.id();
+	if (!Shown(id)) {
+		return;
+	}
+	const auto name = ::Tele::Tr(option.name());
+	const auto description = ::Tele::Tr(option.description());
+	builder.add([&](const WidgetContext &ctx) {
+		const auto controller = ctx.controller;
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto raw = result.data();
+		const auto &padding = st::settingsButtonNoIcon.padding;
+		const auto card = raw->add(
+			object_ptr<Ui::RpWidget>(raw),
+			QMargins(
+				padding.left(),
+				::Tele::CardScaled(4),
+				padding.right(),
+				0));
+		const auto text = Ui::CreateChild<Ui::FlatLabel>(
+			card,
+			QString(),
+			st::boxLabel);
+		const auto inner = ::Tele::CardScaled(14);
+		const auto refresh = [=] {
+			const auto value = base::options::lookup<QString>(
+				::Tele::kOptionAgentPersona).value().trimmed();
+			text->setText(value.isEmpty()
+				? ::Tele::Agent::DefaultPersona()
+				: value);
+		};
+		base::options::lookup<QString>(
+			::Tele::kOptionAgentPersona
+		).changes() | rpl::on_next(refresh, text->lifetime());
+		refresh();
+		rpl::combine(
+			card->widthValue(),
+			text->heightValue()
+		) | rpl::on_next([=](int width, int) {
+			text->resizeToWidth(std::max(width - 2 * inner, 1));
+			text->moveToLeft(inner, inner, width);
+			const auto height = text->height() + 2 * inner;
+			if (card->height() != height) {
+				card->resize(width, height);
+			}
+		}, card->lifetime());
+		card->paintRequest() | rpl::on_next([=] {
+			auto p = QPainter(card);
+			auto hq = PainterHighQualityEnabler(p);
+			const auto radius = ::Tele::CardScaled(12) * 1.;
+			p.setPen(Qt::NoPen);
+			p.setBrush(st::windowBgOver);
+			p.drawRoundedRect(QRectF(card->rect()), radius, radius);
+		}, card->lifetime());
+		const auto links = raw->add(
+			object_ptr<Ui::RpWidget>(raw),
+			QMargins(
+				padding.left(),
+				::Tele::CardScaled(8),
+				padding.right(),
+				::Tele::CardScaled(4)));
+		const auto edit = Ui::CreateChild<Ui::LinkButton>(
+			links,
+			::Tele::Tr(u"Edit"_q));
+		const auto reset = Ui::CreateChild<Ui::LinkButton>(
+			links,
+			::Tele::Tr(u"Reset to the default text"_q));
+		links->resize(links->width(), edit->height());
+		links->widthValue() | rpl::on_next([=](int width) {
+			edit->moveToLeft(0, 0, width);
+			reset->moveToLeft(
+				edit->width() + ::Tele::CardScaled(20),
+				0,
+				width);
+		}, links->lifetime());
+		edit->setClickedCallback([=] {
+			::Tele::Agent::ShowTextBox(
+				controller,
+				::Tele::kOptionAgentPersona,
+				name,
+				true);
+		});
+		reset->setClickedCallback([=] {
+			base::options::lookup<QString>(
+				::Tele::kOptionAgentPersona).set(QString());
+		});
+		SetupLink(card, id);
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+			.align = style::al_justify,
+		};
+	}, [&] {
+		return SearchEntry{
+			.id = id,
+			.title = name,
+			.keywords = { description, u"persona"_q, u"prompt"_q },
+		};
+	});
+	AddAbout(builder, id, description);
+}
+
+void AddAgentAutoReplyList(SectionBuilder &builder) {
+	const auto id = u"tele-agent-auto-replies"_q;
+	if (!Shown(id)) {
+		return;
+	}
+	const auto title = ::Tele::Tr(u"Auto-replies"_q);
+	builder.add([&](const WidgetContext &ctx) {
+		const auto session = &ctx.controller->session();
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto raw = result.data();
+		const auto rebuild = [=] {
+			raw->clear();
+			const auto list = ::Tele::Agent::AutoReplies(session);
+			if (list.empty()) {
+				const auto &padding = st::settingsButtonNoIcon.padding;
+				raw->add(
+					object_ptr<Ui::FlatLabel>(
+						raw,
+						::Tele::Tr(u"Not enabled for anyone yet."_q),
+						st::settingsExperimentalAbout),
+					QMargins(
+						padding.left(),
+						::Tele::CardScaled(6),
+						padding.right(),
+						::Tele::CardScaled(10)));
+			}
+			for (const auto &entry : list) {
+				auto row = CreateOptionRow(
+					raw,
+					(entry.title.isEmpty()
+						? QString::number(entry.peer)
+						: entry.title),
+					entry.scenario);
+				const auto button = row.button;
+				button->toggleOn(rpl::single(entry.enabled));
+				const auto peer = entry.peer;
+				button->toggledChanges(
+				) | rpl::on_next([=](bool enabled) {
+					auto current = ::Tele::Agent::AutoReplies(session);
+					for (auto &item : current) {
+						if (item.peer == peer) {
+							item.enabled = enabled;
+						}
+					}
+					::Tele::Agent::SetAutoReplies(session, std::move(current));
+				}, button->lifetime());
+				raw->add(std::move(row.widget));
+			}
+			raw->resizeToWidth(raw->width());
+		};
