+UserBubble::UserBubble(QWidget *parent, const Message &message)
+: RpWidget(parent) {
+	if (!message.text.isEmpty()) {
+		_label.create(this, message.text, UserStyle());
+		_label->setSelectable(true);
+	}
+	for (const auto &image : message.images) {
+		auto decoded = QImage::fromData(
+			QByteArray::fromBase64(image.base64.toLatin1()));
+		if (!decoded.isNull()) {
+			_image = std::move(decoded);
+			break;
+		}
+	}
+}
+
+int UserBubble::resizeGetHeight(int newWidth) {
+	const auto side = CardScaled(kSide);
+	const auto padding = QMargins(
+		CardScaled(14),
+		CardScaled(9),
+		CardScaled(14),
+		CardScaled(10));
+	const auto vertical = CardScaled(4);
+	const auto maxBubble = std::max(
+		int(newWidth * kMaxBubble),
+		CardScaled(160));
+	const auto innerMax = std::max(
+		maxBubble - padding.left() - padding.right(),
+		1);
+	auto imageSize = QSize();
+	if (!_image.isNull()) {
+		const auto limit = QSize(
+			std::min(innerMax, CardScaled(kThumbMax)),
+			CardScaled(kThumbMax));
+		const auto original = _image.size()
+			/ std::max(_image.devicePixelRatio(), 1.);
+		imageSize = (original.width() > limit.width()
+			|| original.height() > limit.height())
+			? original.scaled(limit, Qt::KeepAspectRatio)
+			: original;
+	}
+	auto labelWidth = 0;
+	auto labelHeight = 0;
+	if (_label) {
+		labelWidth = std::min(std::max(_label->textMaxWidth(), 1), innerMax);
+		_label->resizeToWidth(labelWidth);
+		labelHeight = _label->height();
+	}
+	const auto skip = (!imageSize.isEmpty() && _label)
+		? CardScaled(6)
+		: 0;
+	const auto innerWidth = std::max(imageSize.width(), labelWidth);
+	const auto innerHeight = imageSize.height() + skip + labelHeight;
+	const auto bubbleWidth = innerWidth + padding.left() + padding.right();
+	const auto bubbleHeight = innerHeight + padding.top() + padding.bottom();
+	_bubble = QRect(
+		newWidth - side - bubbleWidth,
+		vertical,
+		bubbleWidth,
+		bubbleHeight);
+	_imageRect = imageSize.isEmpty()
+		? QRect()
+		: QRect(
+			_bubble.x() + padding.left(),
+			_bubble.y() + padding.top(),
+			imageSize.width(),
+			imageSize.height());
+	if (_label) {
+		_label->moveToLeft(
+			_bubble.x() + padding.left(),
+			_bubble.y() + padding.top() + imageSize.height() + skip,
+			newWidth);
+	}
+	return bubbleHeight + 2 * vertical;
+}
+
+void UserBubble::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto radius = CardScaled(16) * 1.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::lightButtonBgOver);
+	p.drawRoundedRect(QRectF(_bubble), radius, radius);
+	if (_imageRect.isEmpty() || _image.isNull()) {
+		return;
+	}
+	const auto ratio = style::DevicePixelRatio();
+	const auto size = _imageRect.size() * ratio;
+	if (_scaled.size() != size) {
+		_scaled = _image.scaled(
+			size,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+		_scaled.setDevicePixelRatio(ratio);
+	}
+	auto path = QPainterPath();
+	const auto imageRadius = CardScaled(10) * 1.;
+	path.addRoundedRect(QRectF(_imageRect), imageRadius, imageRadius);
+	p.setClipPath(path);
+	p.drawImage(_imageRect, _scaled);
+	p.setClipping(false);
+}
