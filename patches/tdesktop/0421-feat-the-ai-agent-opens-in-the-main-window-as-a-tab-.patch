+
+void ToolChip::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto side = CardScaled(kSide);
+	const auto chipHeight = CardScaled(32);
+	const auto top = (height() - chipHeight) / 2;
+	const auto font = CardFont(13, false);
+	const auto icon = CardScaled(14);
+	const auto padding = CardScaled(12);
+	const auto mark = CardScaled(12);
+	const auto skip = CardScaled(8);
+	const auto failed = (_data.state == ChipState::Failed);
+	auto text = _data.title;
+	if (failed && !_data.reason.isEmpty()) {
+		text += u": "_q + _data.reason;
+	}
+	const auto available = std::max(
+		width() - 2 * side - 2 * padding - icon - 2 * skip - mark,
+		0);
+	const auto elided = font->elided(text, available);
+	const auto chipWidth = 2 * padding
+		+ icon
+		+ skip
+		+ font->width(elided)
+		+ skip
+		+ mark;
+	const auto rect = QRect(side, top, chipWidth, chipHeight);
+	const auto radius = CardScaled(8) * 1.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::windowBgOver);
+	p.drawRoundedRect(QRectF(rect), radius, radius);
+	const auto color = failed
+		? st::boxTextFgError->c
+		: st::windowSubTextFg->c;
+	const auto glyph = QRectF(
+		rect.x() + padding,
+		rect.y() + (chipHeight - icon) / 2.,
+		icon,
+		icon);
+	if (_data.name.contains(u"search"_q)) {
+		PaintSearchGlyph(p, glyph, color);
+	} else {
+		PaintListGlyph(p, glyph, color);
+	}
+	p.setFont(font);
+	p.setPen(failed ? st::boxTextFgError : st::windowFg);
+	p.drawText(
+		rect.x() + padding + icon + skip,
+		rect.y() + (chipHeight - font->height) / 2 + font->ascent,
+		elided);
+	const auto markRect = QRectF(
+		rect.x() + rect.width() - padding - mark,
+		rect.y() + (chipHeight - mark) / 2.,
+		mark,
+		mark);
+	if (_data.state == ChipState::Done) {
+		PaintCardCheck(p, markRect, st::windowSubTextFg->c);
+	} else if (failed) {
+		PaintCrossGlyph(p, markRect, st::boxTextFgError->c);
+	} else {
+		PaintDotsGlyph(p, markRect, st::windowSubTextFg->c);
+	}
+}
