+void PerformAgentQuickAction(
+		not_null<Window::SessionController*> controller,
+		not_null<History*> history,
+		Dialogs::Ui::QuickDialogAction action) {
+	if (action == Dialogs::Ui::QuickDialogAction::Pin) {
+		TogglePin(history);
+	}
+}
+
+bool PaintAgentRowStatus(
+		Painter &p,
+		Data::Thread *thread,
+		QRect rect,
+		int outerWidth,
+		const QColor &color) {
+	const auto history = thread ? thread->owningHistory().get() : nullptr;
+	if (!history || !IsAgentPeer(history->peer)) {
+		return false;
+	}
+	const auto state = StateFor(&history->session());
+	if (!state || !state->running) {
+		return false;
+	}
+	const auto text = state->status.isEmpty()
+		? Tr(u"Typing…"_q)
+		: state->status;
+	p.setFont(st::dialogsTextFont);
+	p.setPen(color);
+	p.drawTextLeft(
+		rect.x(),
+		rect.y(),
+		outerWidth,
+		st::dialogsTextFont->elided(text, std::max(rect.width(), 0)));
+	return true;
+}
+
+} // namespace Tele::Agent
