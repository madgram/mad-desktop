+class EmptyState final : public Ui::RpWidget {
+public:
+	EmptyState(
+		QWidget *parent,
+		bool configured,
+		Fn<void(QString)> suggest,
+		Fn<void()> settings);
+
+	void setMinimalHeight(int height);
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+
+private:
+	object_ptr<Ui::FlatLabel> _text;
+	std::vector<not_null<PaintedButton*>> _buttons;
+	int _minimalHeight = 0;
+	int _top = 0;
+
+};
+
+EmptyState::EmptyState(
+	QWidget *parent,
+	bool configured,
+	Fn<void(QString)> suggest,
+	Fn<void()> settings)
+: RpWidget(parent)
+, _text(
+	this,
+	(configured
+		? Tr(u"I can summarize chats, find things in them, help you "
+			"reply, or just talk."_q)
+		: Tr(u"Add an API key first: Anthropic, OpenAI or any compatible "
+			"service."_q)),
+	CenteredStyle()) {
+	const auto addButton = [&](const QString &text, bool primary) {
+		const auto button = Ui::CreateChild<PaintedButton>(this, [=](
+				QPainter &p,
+				QRect rect,
+				bool over) {
+			auto hq = PainterHighQualityEnabler(p);
+			const auto radius = rect.height() / 2.;
+			const auto half = st::lineWidth / 2.;
+			const auto inner = QRectF(rect).marginsRemoved(
+				QMarginsF(half, half, half, half));
+			if (primary) {
+				p.setPen(Qt::NoPen);
+				p.setBrush(over ? st::activeButtonBgOver : st::activeButtonBg);
+			} else {
+				auto pen = QPen(st::shadowFg->c);
+				pen.setWidthF(st::lineWidth);
+				p.setPen(pen);
+				p.setBrush(over ? st::lightButtonBgOver : st::windowBg);
+			}
+			p.drawRoundedRect(inner, radius, radius);
+			const auto font = CardFont(14, true);
+			p.setFont(font);
+			p.setPen(primary ? st::activeButtonFg : st::windowActiveTextFg);
+			p.drawText(
+				QRectF(rect),
+				Qt::AlignCenter,
+				font->elided(text, std::max(rect.width() - CardScaled(24), 0)));
+		});
+		const auto font = CardFont(14, true);
+		button->resize(
+			font->width(text) + 2 * CardScaled(20),
+			CardScaled(38));
+		_buttons.push_back(button);
+		return button;
+	};
+	if (configured) {
+		const auto list = std::vector<QString>{
+			Tr(u"What did I miss in unread chats?"_q),
+			Tr(u"Summarize my latest chat"_q),
+			Tr(u"Help me politely decline a meeting"_q),
+		};
+		for (const auto &text : list) {
+			addButton(text, false)->setClickedCallback([=] {
+				suggest(text);
+			});
+		}
+	} else {
+		addButton(Tr(u"Open settings"_q), true)->setClickedCallback(settings);
+	}
+}
+
+void EmptyState::setMinimalHeight(int height) {
+	if (_minimalHeight != height) {
+		_minimalHeight = height;
+		resizeToWidth(width());
+	}
+}
+
+int EmptyState::resizeGetHeight(int newWidth) {
+	const auto side = CardScaled(kSide);
+	const auto tile = CardScaled(72);
+	const auto titleHeight = CardFont(26, true)->height;
+	const auto textWidth = std::max(
+		std::min(newWidth - 2 * side, CardScaled(400)),
+		1);
+	_text->resizeToWidth(textWidth);
+	const auto gap = CardScaled(10);
+	auto buttons = 0;
+	for (const auto &button : _buttons) {
+		buttons += button->height() + gap;
+	}
+	if (buttons) {
+		buttons -= gap;
+	}
+	const auto content = tile
+		+ CardScaled(22)
+		+ titleHeight
+		+ CardScaled(10)
+		+ _text->height()
+		+ CardScaled(24)
+		+ buttons;
+	const auto result = std::max(content + 2 * CardScaled(24), _minimalHeight);
+	_top = (result - content) / 2;
+	const auto textTop = _top + tile + CardScaled(22) + titleHeight
+		+ CardScaled(10);
+	_text->moveToLeft((newWidth - textWidth) / 2, textTop, newWidth);
+	auto top = textTop + _text->height() + CardScaled(24);
+	for (const auto &button : _buttons) {
+		const auto buttonWidth = std::min(button->width(), newWidth - 2 * side);
+		button->resize(std::max(buttonWidth, 1), button->height());
+		button->moveToLeft((newWidth - button->width()) / 2, top, newWidth);
+		top += button->height() + gap;
+	}
+	return result;
+}
+
+void EmptyState::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto tile = CardScaled(72);
+	const auto left = (width() - tile) / 2;
+	const auto radius = CardScaled(20) * 1.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::lightButtonBgOver);
+	p.drawRoundedRect(QRectF(left, _top, tile, tile), radius, radius);
+	const auto inset = CardScaled(18);
+	PaintSparkles(
+		p,
+		QRectF(
+			left + inset,
+			_top + inset,
+			tile - 2 * inset,
+			tile - 2 * inset),
+		st::windowActiveTextFg->c);
+	const auto font = CardFont(26, true);
+	const auto title = font->elided(
+		Tr(u"How can I help?"_q),
+		std::max(width() - 2 * CardScaled(kSide), 0));
+	p.setFont(font);
+	p.setPen(st::windowBoldFg);
+	p.drawText(
+		(width() - font->width(title)) / 2,
+		_top + tile + CardScaled(22) + font->ascent,
+		title);
+}
