+
+void ChatView::setupConfirm() {
+	Runner::For(_session).setConfirm(crl::guard(this, [=](
+			Confirmation confirmation,
+			Fn<void(bool)> decided) {
+		const auto pending = std::make_shared<Fn<void(bool)>>(decided);
+		_pendingConfirm = pending;
+		const auto decide = [=](bool approved) {
+			if (const auto callback = base::take(*pending)) {
+				callback(approved);
+			}
+		};
+		auto box = Ui::MakeConfirmBox({
+			.text = TextWithEntities::Simple(confirmation.text),
+			.confirmed = [=](Fn<void()> close) {
+				decide(true);
+				close();
+			},
+			.cancelled = [=](Fn<void()> close) {
+				decide(false);
+				close();
+			},
+			.confirmText = confirmation.confirm,
+			.title = confirmation.title,
+		});
+		box->boxClosing() | rpl::on_next([=] {
+			decide(false);
+		}, box->lifetime());
+		_controller->show(std::move(box));
+	}));
+}
