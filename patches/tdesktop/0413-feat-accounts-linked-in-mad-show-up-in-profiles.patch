+#include "tele/tele_linked_accounts_data.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QUrl>
+#include <QtCore/QUrlQuery>
+
+#include <utility>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxAccounts = 64;
+constexpr auto kMaxText = 256;
+
+[[nodiscard]] QString Text(const QJsonObject &object, const char *key) {
+	const auto value = object.value(QLatin1String(key));
+	return value.isString()
+		? value.toString().left(kMaxText).trimmed()
+		: QString();
+}
+
+} // namespace
+
+QString InitDataFromWebViewUrl(const QString &url) {
+	const auto parsed = QUrl(url);
+	if (!parsed.isValid()) {
+		return QString();
+	}
+	const auto read = [](const QString &part) {
+		const auto query = QUrlQuery(part);
+		return query.queryItemValue(
+			QStringLiteral("tgWebAppData"),
+			QUrl::FullyDecoded);
+	};
+	const auto fromFragment = read(parsed.fragment(QUrl::FullyEncoded));
+	return fromFragment.isEmpty()
+		? read(parsed.query(QUrl::FullyEncoded))
+		: fromFragment;
+}
+
+std::vector<LinkedAccount> ParseLinkedAccounts(const QByteArray &json) {
+	auto result = std::vector<LinkedAccount>();
+	const auto document = QJsonDocument::fromJson(json);
+	const auto list = document.isObject()
+		? document.object().value(QStringLiteral("accounts")).toArray()
+		: QJsonArray();
+	for (const auto &entry : list) {
+		if (!entry.isObject() || int(result.size()) >= kMaxAccounts) {
+			continue;
+		}
+		const auto object = entry.toObject();
+		auto account = LinkedAccount{
+			.id = Text(object, "id"),
+			.platform = Text(object, "platform"),
+			.handle = Text(object, "handle"),
+			.displayName = Text(object, "displayName"),
+			.url = Text(object, "url"),
+			.verified = object.value(QStringLiteral("verified")).toBool(),
+			.visible = object.value(QStringLiteral("visible")).toBool(true),
+			.hiddenByAdmin = object.value(
+				QStringLiteral("hiddenByAdmin")).toBool(),
+		};
+		if (account.id.isEmpty() || account.platform.isEmpty()) {
+			continue;
+		} else if (!IsSafeLinkedUrl(account.url)) {
+			account.url = QString();
+		}
+		result.push_back(std::move(account));
+	}
+	return result;
+}
+
+std::vector<LinkedPlatform> ParseLinkedPlatforms(const QByteArray &json) {
+	auto result = std::vector<LinkedPlatform>();
+	const auto document = QJsonDocument::fromJson(json);
+	if (!document.isArray()) {
+		return result;
+	}
+	for (const auto &entry : document.array()) {
+		if (!entry.isObject()) {
+			continue;
+		}
+		const auto object = entry.toObject();
+		auto platform = LinkedPlatform{
+			.id = Text(object, "id"),
+			.name = Text(object, "name"),
+			.category = Text(object, "category"),
+			.available = object.value(QStringLiteral("available")).toBool(),
+			.needsClientId = object.value(
+				QStringLiteral("needsClientId")).toBool(),
+		};
+		if (!platform.id.isEmpty()) {
+			if (platform.name.isEmpty()) {
+				platform.name = LinkedPlatformTitle(platform.id);
+			}
+			result.push_back(std::move(platform));
+		}
+	}
+	return result;
+}
+
+QString ParseLinkedToken(const QByteArray &json) {
+	const auto document = QJsonDocument::fromJson(json);
+	return document.isObject()
+		? document.object().value(QStringLiteral("token")).toString()
+		: QString();
+}
+
+QString LinkedPlatformTitle(const QString &platform) {
+	static const auto known = std::vector<std::pair<QString, QString>>{
+		{ QStringLiteral("steam"), QStringLiteral("Steam") },
+		{ QStringLiteral("spotify"), QStringLiteral("Spotify") },
+		{ QStringLiteral("discord"), QStringLiteral("Discord") },
+		{ QStringLiteral("twitch"), QStringLiteral("Twitch") },
+		{ QStringLiteral("github"), QStringLiteral("GitHub") },
+		{ QStringLiteral("gitlab"), QStringLiteral("GitLab") },
+		{ QStringLiteral("reddit"), QStringLiteral("Reddit") },
+		{ QStringLiteral("soundcloud"), QStringLiteral("SoundCloud") },
+		{ QStringLiteral("lastfm"), QStringLiteral("Last.fm") },
+	};
+	for (const auto &[id, title] : known) {
+		if (id == platform) {
+			return title;
+		}
+	}
+	return platform.isEmpty()
+		? QString()
+		: platform.left(1).toUpper() + platform.mid(1);
+}
+
+bool IsSafeLinkedUrl(const QString &url) {
+	const auto parsed = QUrl(url, QUrl::StrictMode);
+	return parsed.isValid()
+		&& (parsed.scheme() == QStringLiteral("https"))
+		&& !parsed.host().isEmpty()
+		&& parsed.userInfo().isEmpty();
+}
+
+} // namespace Tele
