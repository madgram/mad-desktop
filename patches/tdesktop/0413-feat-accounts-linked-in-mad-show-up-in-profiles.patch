+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QUrlQuery>
+#include <QtGui/QDesktopServices>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele {
+namespace {
+
+constexpr auto kCacheFor = crl::time(10 * 60 * 1000);
+constexpr auto kMaxBytes = 256 * 1024;
+constexpr auto kBot = "maddtgbot";
+
+[[nodiscard]] QString Base() {
+	return u"https://b.mad.tg"_q;
+}
+
+struct Cached {
+	std::vector<LinkedAccount> accounts;
+	crl::time loaded = 0;
+	bool loading = false;
+};
+
+class Service final : public QObject, public base::has_weak_ptr {
+public:
+	explicit Service(not_null<Main::Session*> session);
+
+	[[nodiscard]] static Service &For(not_null<Main::Session*> session);
+
+	[[nodiscard]] const std::vector<LinkedAccount> &profile(UserId id);
+	[[nodiscard]] rpl::producer<UserId> profileUpdates() const;
+
+	void loadMine();
+	[[nodiscard]] const std::vector<LinkedAccount> &mine() const;
+	[[nodiscard]] const std::vector<LinkedPlatform> &platforms() const;
+	[[nodiscard]] QString error() const;
+	[[nodiscard]] bool busy() const;
+	[[nodiscard]] rpl::producer<> mineUpdates() const;
+
+	void remove(const QString &id);
+	void link(const QString &platform, const QString &clientId);
+	void invalidate();
+
+private:
+	using Done = Fn<void(int status, QByteArray body)>;
+
+	void withToken(Fn<void(QString)> done);
+	void authorize();
+	void requestWebView(not_null<UserData*> bot);
+	void finishAuthorize(const QString &token);
+	void request(
+		const QString &method,
+		const QString &path,
+		const QByteArray &body,
+		Done done);
+	void fetchProfile(UserId id);
+	void fetchPlatforms();
+	void setError(const QString &error);
+
+	const not_null<Main::Session*> _session;
+	QNetworkAccessManager _network;
+	QString _token;
+	bool _authorizing = false;
+	std::vector<Fn<void(QString)>> _tokenWaiters;
+	base::flat_map<UserId, Cached> _profiles;
+	rpl::event_stream<UserId> _profileUpdates;
+	std::vector<LinkedAccount> _mine;
+	std::vector<LinkedPlatform> _platforms;
+	QString _error;
+	int _busy = 0;
+	rpl::event_stream<> _mineUpdates;
+
+};
+
+[[nodiscard]] base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Service>> &Services() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Service>>();
+	return result;
+}
+
+Service::Service(not_null<Main::Session*> session)
+: _session(session) {
+}
+
+Service &Service::For(not_null<Main::Session*> session) {
+	auto &services = Services();
+	const auto i = services.find(session);
+	if (i != end(services)) {
+		return *i->second;
+	}
+	const auto result = services.emplace(
+		session,
+		std::make_unique<Service>(session)).first->second.get();
+	session->lifetime().add([=] {
+		Services().remove(session);
+	});
+	return *result;
+}
+
+void Service::request(
+		const QString &method,
+		const QString &path,
+		const QByteArray &body,
+		Done done) {
+	auto request = QNetworkRequest(QUrl(Base() + path));
+	request.setHeader(
+		QNetworkRequest::ContentTypeHeader,
+		u"application/json"_q);
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(20000);
+	if (!_token.isEmpty()) {
+		request.setRawHeader("Authorization", "Bearer " + _token.toUtf8());
+	}
+	const auto reply = _network.sendCustomRequest(
+		request,
+		method.toLatin1(),
+		body);
+	QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+		const auto bytes = reply->read(kMaxBytes);
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		reply->deleteLater();
+		done(status, bytes);
+	});
+}
+
+void Service::withToken(Fn<void(QString)> done) {
+	if (!_token.isEmpty()) {
+		done(_token);
+		return;
+	}
+	_tokenWaiters.push_back(std::move(done));
+	if (!_authorizing) {
+		authorize();
+	}
+}
+
+void Service::authorize() {
+	_authorizing = true;
+	const auto name = QString::fromLatin1(kBot);
+	if (const auto peer = _session->data().peerByUsername(name)) {
+		if (const auto bot = peer->asUser()) {
+			requestWebView(bot);
+			return;
+		}
+	}
+	const auto weak = base::make_weak(this);
+	_session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(0),
+		MTP_string(name),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		if (!weak) {
+			return;
+		}
+		const auto &data = result.data();
+		_session->data().processUsers(data.vusers());
+		_session->data().processChats(data.vchats());
+		const auto peer = _session->data().peerLoaded(
+			peerFromMTP(data.vpeer()));
+		if (const auto bot = peer ? peer->asUser() : nullptr) {
+			requestWebView(bot);
+		} else {
+			finishAuthorize(QString());
+		}
+	}).fail([=] {
+		if (weak) {
+			finishAuthorize(QString());
+		}
+	}).send();
+}
+
+void Service::requestWebView(not_null<UserData*> bot) {
+	const auto weak = base::make_weak(this);
+	_session->api().request(MTPmessages_RequestMainWebView(
+		MTP_flags(0),
+		bot->input(),
+		bot->inputUser(),
+		MTPstring(),
+		MTPDataJSON(),
+		MTP_string("tdesktop")
+	)).done([=](const MTPWebViewResult &result) {
+		if (!weak) {
+			return;
+		}
+		const auto initData = InitDataFromWebViewUrl(
+			qs(result.data().vurl()));
+		if (initData.isEmpty()) {
+			finishAuthorize(QString());
+			return;
+		}
+		const auto body = QJsonDocument(QJsonObject{
+			{ u"initData"_q, initData },
+		}).toJson(QJsonDocument::Compact);
+		request(u"POST"_q, u"/api/v1/auth/telegram"_q, body, [=](
+				int status,
+				QByteArray bytes) {
+			finishAuthorize((status == 200)
+				? ParseLinkedToken(bytes)
+				: QString());
+		});
+	}).fail([=] {
+		if (weak) {
+			finishAuthorize(QString());
+		}
+	}).send();
+}
+
+void Service::finishAuthorize(const QString &token) {
+	_authorizing = false;
+	_token = token;
+	if (token.isEmpty()) {
+		setError(Tr(u"Could not sign in to b.mad.tg."_q));
+	}
+	for (const auto &callback : base::take(_tokenWaiters)) {
+		callback(token);
+	}
+}
+
+const std::vector<LinkedAccount> &Service::profile(UserId id) {
+	auto &cached = _profiles[id];
+	if (!cached.loading
+		&& (!cached.loaded || crl::now() - cached.loaded > kCacheFor)) {
+		fetchProfile(id);
+	}
+	return _profiles[id].accounts;
+}
+
+rpl::producer<UserId> Service::profileUpdates() const {
+	return _profileUpdates.events();
+}
+
+[[nodiscard]] bool SameAccounts(
+		const std::vector<LinkedAccount> &a,
+		const std::vector<LinkedAccount> &b) {
+	if (a.size() != b.size()) {
+		return false;
+	}
+	for (auto i = 0; i != int(a.size()); ++i) {
+		if (a[i].id != b[i].id
+			|| a[i].displayName != b[i].displayName
+			|| a[i].handle != b[i].handle
+			|| a[i].url != b[i].url) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void Service::fetchProfile(UserId id) {
+	_profiles[id].loading = true;
+	const auto weak = base::make_weak(this);
+	withToken([=](QString token) {
+		if (!weak) {
+			return;
+		}
+		if (token.isEmpty()) {
+			auto &cached = _profiles[id];
+			cached.loading = false;
+			cached.loaded = crl::now();
+			return;
+		}
+		const auto path = u"/api/v1/profiles/%1"_q.arg(id.bare);
+		request(u"GET"_q, path, QByteArray(), [=](
+				int status,
+				QByteArray bytes) {
+			if (status == 401) {
+				_token = QString();
+			}
+			auto &cached = _profiles[id];
+			cached.loading = false;
+			cached.loaded = crl::now();
+			if (status != 200) {
+				return;
+			}
+			auto accounts = ParseLinkedAccounts(bytes);
+			if (!SameAccounts(accounts, cached.accounts)) {
+				cached.accounts = std::move(accounts);
+				_profileUpdates.fire_copy(id);
+			}
+		});
+	});
+}
+
+void Service::loadMine() {
+	const auto weak = base::make_weak(this);
+	++_busy;
+	_error = QString();
+	_mineUpdates.fire({});
+	fetchPlatforms();
+	withToken([=](QString token) {
+		if (!weak) {
+			return;
+		}
+		if (token.isEmpty()) {
+			--_busy;
+			_mineUpdates.fire({});
+			return;
+		}
+		request(u"GET"_q, u"/api/v1/me/accounts"_q, QByteArray(), [=](
+				int status,
+				QByteArray bytes) {
+			--_busy;
+			if (status == 200) {
+				_mine = ParseLinkedAccounts(bytes);
+				_profiles.remove(_session->userId());
+			} else {
+				if (status == 401) {
+					_token = QString();
+				}
+				_error = Tr(u"Could not load your accounts."_q);
+			}
+			_mineUpdates.fire({});
+		});
+	});
+}
+
+void Service::fetchPlatforms() {
+	if (!_platforms.empty()) {
+		return;
+	}
+	request(u"GET"_q, u"/api/v1/platforms"_q, QByteArray(), [=](
+			int status,
+			QByteArray bytes) {
+		if (status == 200) {
+			_platforms = ParseLinkedPlatforms(bytes);
+			_mineUpdates.fire({});
+		}
+	});
+}
+
+const std::vector<LinkedAccount> &Service::mine() const {
+	return _mine;
+}
+
+const std::vector<LinkedPlatform> &Service::platforms() const {
+	return _platforms;
+}
+
+QString Service::error() const {
+	return _error;
+}
+
+bool Service::busy() const {
+	return _busy > 0;
+}
+
+rpl::producer<> Service::mineUpdates() const {
+	return _mineUpdates.events();
+}
+
+void Service::setError(const QString &error) {
+	_error = error;
+	_mineUpdates.fire({});
+}
+
+void Service::remove(const QString &id) {
+	const auto weak = base::make_weak(this);
+	withToken([=](QString token) {
+		if (!weak || token.isEmpty()) {
+			return;
+		}
+		const auto path = u"/api/v1/me/accounts/"_q
+			+ QString::fromLatin1(QUrl::toPercentEncoding(id));
+		request(u"DELETE"_q, path, QByteArray(), [=](
+				int status,
+				QByteArray) {
+			loadMine();
+			if (status != 204 && status != 404) {
+				setError(Tr(u"Could not unlink the account."_q));
+			}
+		});
+	});
+}
+
+void Service::link(const QString &platform, const QString &clientId) {
+	const auto weak = base::make_weak(this);
+	withToken([=](QString token) {
+		if (!weak || token.isEmpty()) {
+			return;
+		}
+		auto query = QUrlQuery();
+		query.addQueryItem(u"token"_q, token);
+		if (!clientId.isEmpty()) {
+			query.addQueryItem(u"client_id"_q, clientId);
+		}
+		auto url = QUrl(Base()
+			+ u"/api/v1/connect/"_q
+			+ QString::fromLatin1(QUrl::toPercentEncoding(platform))
+			+ u"/start"_q);
+		url.setQuery(query);
+		QDesktopServices::openUrl(url);
+	});
+}
+
+void Service::invalidate() {
+	_profiles.clear();
+	loadMine();
+}
+
+[[nodiscard]] QString AccountName(const LinkedAccount &account) {
+	return account.displayName.isEmpty()
+		? account.handle
+		: account.displayName;
+}
+
+[[nodiscard]] TextWithEntities AccountsText(
+		const std::vector<LinkedAccount> &accounts) {
+	auto result = TextWithEntities();
+	for (const auto &account : accounts) {
+		if (!result.empty()) {
+			result.append('\n');
+		}
+		const auto name = AccountName(account);
+		result.append(LinkedPlatformTitle(account.platform) + u": "_q);
+		result.append(account.url.isEmpty()
+			? TextWithEntities::Simple(name)
+			: Ui::Text::Link(name, account.url));
+	}
+	return result;
+}
+
+[[nodiscard]] QString AccountLine(const LinkedAccount &account) {
+	auto result = LinkedPlatformTitle(account.platform)
+		+ u" · "_q
+		+ AccountName(account);
+	if (account.hiddenByAdmin) {
+		result += u" · "_q + Tr(u"hidden by moderators"_q);
+	} else if (!account.visible) {
+		result += u" · "_q + Tr(u"hidden"_q);
+	}
+	return result;
+}
+
+void AskClientId(
+		not_null<Window::SessionController*> controller,
+		Fn<void(QString)> done) {
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Spotify"_q));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Tr(u"Create an app on developer.spotify.com, add "
+				"https://b.mad.tg/api/v1/connect/spotify/callback as its "
+				"redirect URL and paste its Client ID here."_q),
+			st::boxLabel));
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(u"Client ID"_q),
+			SpotifyClientId()));
+		const auto submit = [=] {
+			const auto value = field->getLastText().trimmed();
+			if (value.isEmpty()) {
+				field->showError();
+				return;
+			}
+			SetSpotifyClientId(value);
+			box->closeBox();
+			done(value);
+		};
+		field->submits() | rpl::on_next(submit, field->lifetime());
+		box->setFocusCallback([=] { field->setFocusFast(); });
+		box->addButton(rpl::single(Tr(u"Continue"_q)), submit);
+		box->addButton(rpl::single(Tr(u"Cancel"_q)), [=] {
+			box->closeBox();
+		});
+	}));
+}
+
+void Fill(
+		not_null<Ui::VerticalLayout*> content,
+		not_null<Window::SessionController*> controller) {
+	auto &service = Service::For(&controller->session());
+	const auto weak = base::make_weak(&service);
+	content->clear();
+	const auto status = service.busy()
+		? Tr(u"Loading…"_q)
+		: service.error();
+	if (!status.isEmpty()) {
+		Ui::AddDividerText(content, rpl::single(status));
+	}
+	Ui::AddSubsectionTitle(content, rpl::single(Tr(u"Your accounts"_q)));
+	if (service.mine().empty() && !service.busy()) {
+		content->add(
+			object_ptr<Ui::FlatLabel>(
+				content,
+				Tr(u"Nothing linked yet."_q),
+				st::settingsExperimentalAbout),
+			st::settingsExperimentalAboutPadding);
+	}
+	for (const auto &account : service.mine()) {
+		const auto line = AccountLine(account);
+		const auto button = content->add(object_ptr<Ui::SettingsButton>(
+			content,
+			rpl::single(line),
+			st::settingsButtonNoIcon));
+		const auto id = account.id;
+		button->setClickedCallback([=] {
+			controller->show(Ui::MakeConfirmBox({
+				.text = Tr(u"Unlink %1?"_q).arg(line),
+				.confirmed = [=](Fn<void()> close) {
+					if (const auto strong = weak.get()) {
+						strong->remove(id);
+					}
+					close();
+				},
+				.confirmText = Tr(u"Unlink"_q),
+			}));
+		});
+	}
+	Ui::AddSkip(content);
+	Ui::AddDivider(content);
+	Ui::AddSkip(content);
+	Ui::AddSubsectionTitle(content, rpl::single(Tr(u"Link an account"_q)));
+	for (const auto &platform : service.platforms()) {
+		if (!platform.available) {
+			continue;
+		}
+		const auto button = content->add(object_ptr<Ui::SettingsButton>(
+			content,
+			rpl::single(platform.name),
+			st::settingsButtonNoIcon));
+		const auto id = platform.id;
+		const auto needsClientId = platform.needsClientId;
+		button->setClickedCallback([=] {
+			const auto go = [=](QString clientId) {
+				if (const auto strong = weak.get()) {
+					strong->link(id, clientId);
+				}
+			};
+			if (needsClientId) {
+				AskClientId(controller, go);
+			} else {
+				go(QString());
+			}
+		});
+	}
+	content->resizeToWidth(content->width());
+}
+
+} // namespace
+
+rpl::producer<TextWithEntities> LinkedAccountsTextValue(
+		not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	if (!user || user->isBot() || user->isServiceUser()) {
+		return rpl::single(TextWithEntities());
+	}
+	const auto session = &user->session();
+	const auto id = peerToUser(user->id);
+	return LinkedAccountsValue(
+	) | rpl::map([=](bool enabled) -> rpl::producer<TextWithEntities> {
+		if (!enabled) {
+			return rpl::single(TextWithEntities());
+		}
+		return rpl::single(
+			id
+		) | rpl::then(Service::For(session).profileUpdates(
+		) | rpl::filter([=](UserId updated) {
+			return (updated == id);
+		})) | rpl::map([=] {
+			return AccountsText(Service::For(session).profile(id));
+		});
+	}) | rpl::flatten_latest();
+}
+
+void SetupLinkedAccountsSettings(
+		not_null<Ui::VerticalLayout*> container,
+		not_null<Window::SessionController*> controller) {
+	auto &service = Service::For(&controller->session());
+	const auto content = container->add(
+		object_ptr<Ui::VerticalLayout>(container));
+	service.mineUpdates(
+	) | rpl::on_next([=] {
+		Fill(content, controller);
+	}, content->lifetime());
+	service.loadMine();
+	Fill(content, controller);
+}
+
+bool HandleLinkedAccountsLink(
+		const QUrl &url,
+		Window::SessionController *controller) {
+	if (url.host().toLower() != u"accounts"_q) {
+		return false;
+	}
+	const auto path = url.path().toLower();
+	if (path == u"/linked"_q) {
+		for (const auto &[index, account] : Core::App().domain().accounts()) {
+			if (const auto session = account->maybeSession()) {
+				Service::For(session).invalidate();
+			}
+		}
+		if (controller) {
+			controller->showToast(Tr(u"Account linked."_q));
+		}
+	} else if (path == u"/failed"_q) {
+		const auto reason = QUrlQuery(url).queryItemValue(u"reason"_q);
+		if (controller) {
+			controller->showToast((reason == u"limit"_q)
+				? Tr(u"Too many linked accounts."_q)
+				: Tr(u"Could not link the account."_q));
+		}
+	}
+	return true;
+}
+
+} // namespace Tele
