+QMap<QString, QString> MadTargetSignatures(
+		const MadRegistry &registry,
+		qint64 now) {
+	auto result = QMap<QString, QString>();
+	for (auto i = registry.assignments.cbegin(); i != registry.assignments.cend(); ++i) {
+		if (const auto badge = FindMadBadge(registry, i.key(), now)) {
+			result[i.key()] = QStringLiteral("b:") + badge->id;
+		}
+	}
+	for (auto i = registry.names.cbegin(); i != registry.names.cend(); ++i) {
+		const auto name = FindMadName(registry, i.key(), now);
+		if (name.colors.empty()) {
+			continue;
+		}
+		auto signature = QStringLiteral("n:%1").arg(int(name.effect));
+		for (const auto &color : name.colors) {
+			signature += ',' + color.name(QColor::HexRgb);
+		}
+		auto &value = result[i.key()];
+		value = value.isEmpty() ? signature : (value + ';' + signature);
+	}
+	return result;
+}
+
+QStringList ChangedMadTargets(
+		const QMap<QString, QString> &was,
+		const QMap<QString, QString> &now) {
+	auto result = QStringList();
+	for (auto i = was.cbegin(); i != was.cend(); ++i) {
+		const auto j = now.constFind(i.key());
+		if (j == now.cend() || *j != *i) {
+			result.push_back(i.key());
+		}
+	}
+	for (auto i = now.cbegin(); i != now.cend(); ++i) {
+		if (!was.contains(i.key())) {
+			result.push_back(i.key());
+		}
+	}
+	return result;
+}
