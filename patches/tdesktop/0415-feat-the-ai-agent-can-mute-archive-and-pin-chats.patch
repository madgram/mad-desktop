+void Tools::chatAction(
+		const QString &name,
+		const QJsonObject &args,
+		Fn<void(ToolOutcome)> done) {
+	const auto peer = PeerFromArgs(_session, args);
+	if (!peer) {
+		done(Error(u"Unknown chat_id."_q));
+		return;
+	}
+	const auto history = _session->data().history(peer);
+	const auto title = Title(peer);
+	if (name == u"mark_read"_q) {
+		_session->data().histories().readInbox(history);
+		done({
+			.content = u"Marked as read."_q,
+			.title = Tr(u"Marked %1 as read"_q).arg(title),
+		});
+	} else if (name == u"mark_unread"_q) {
+		_session->data().histories().changeDialogUnreadMark(history, true);
+		done({
+			.content = u"Marked as unread."_q,
+			.title = Tr(u"Marked %1 as unread"_q).arg(title),
+		});
+	} else if (name == u"mute"_q) {
+		const auto minutes = std::max(args.value(u"minutes"_q).toInt(), 0);
+		_session->data().notifySettings().update(
+			peer,
+			minutes
+				? Data::MuteValue{ .period = minutes * 60 }
+				: Data::MuteValue{ .forever = true });
+		done({
+			.content = minutes
+				? u"Muted for %1 minutes."_q.arg(minutes)
+				: u"Muted."_q,
+			.title = Tr(u"Muted %1"_q).arg(title),
+		});
+	} else if (name == u"unmute"_q) {
+		_session->data().notifySettings().update(
+			peer,
+			Data::MuteValue{ .unmute = true });
+		done({
+			.content = u"Unmuted."_q,
+			.title = Tr(u"Unmuted %1"_q).arg(title),
+		});
+	} else if ((name == u"archive"_q) || (name == u"unarchive"_q)) {
+		const auto archive = (name == u"archive"_q);
+		const auto outcome = ToolOutcome{
+			.content = archive ? u"Archived."_q : u"Unarchived."_q,
+			.title = archive
+				? Tr(u"Archived %1"_q).arg(title)
+				: Tr(u"Unarchived %1"_q).arg(title),
+		};
+		if ((history->folder() != nullptr) == archive) {
+			done(outcome);
+			return;
+		}
+		const auto weak = base::make_weak(this);
+		_session->api().toggleHistoryArchived(history, archive, [=] {
+			if (weak) {
+				done(outcome);
+			}
+		});
+	} else {
+		const auto pin = (name == u"pin"_q);
+		const auto outcome = ToolOutcome{
+			.content = pin ? u"Pinned."_q : u"Unpinned."_q,
+			.title = pin
+				? Tr(u"Pinned %1"_q).arg(title)
+				: Tr(u"Unpinned %1"_q).arg(title),
+		};
+		if (history->isPinnedDialog(FilterId()) == pin) {
+			done(outcome);
+			return;
+		}
+		auto &owner = _session->data();
+		if (pin && !owner.pinnedCanPin(history)) {
+			done(Error(u"The limit of pinned chats is reached."_q));
+			return;
+		}
+		owner.setChatPinned(history, FilterId(), pin);
+		const auto session = _session;
+		_session->api().request(MTPmessages_ToggleDialogPin(
+			MTP_flags(pin
+				? MTPmessages_ToggleDialogPin::Flag::f_pinned
+				: MTPmessages_ToggleDialogPin::Flag(0)),
+			MTP_inputDialogPeer(peer->input())
+		)).done([=] {
+			session->data().notifyPinnedDialogsOrderUpdated();
+		}).send();
+		done(outcome);
+	}
+}
