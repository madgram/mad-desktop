+void Tools::searchWithContext(
+		not_null<PeerData*> peer,
+		const QString &query,
+		Fn<void(ToolOutcome)> done) {
+	const auto weak = base::make_weak(this);
+	const auto session = _session;
+	const auto title = Title(peer);
+	const auto toolTitle = Tr(u"Searched messages for \"%1\""_q).arg(query);
+	_session->api().request(MTPmessages_Search(
+		MTP_flags(0),
+		peer->input(),
+		MTP_string(query),
+		MTP_inputPeerEmpty(),
+		MTP_inputPeerEmpty(),
+		MTP_vector<MTPReaction>(),
+		MTP_int(0),
+		MTP_inputMessagesFilterEmpty(),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(kSearchHits),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_long(0)
+	)).done([=](const MTPmessages_Messages &result) {
+		if (!weak) {
+			return;
+		}
+		auto hits = Items(session, result);
+		ranges::sort(hits, [](auto a, auto b) {
+			return a->id > b->id;
 		});
+		if (hits.empty()) {
+			done({
+				.content = u"Nothing found for \"%1\" in \"%2\"."_q.arg(
+					query,
+					title),
+				.title = toolTitle,
+			});
+			return;
+		}
+		struct State {
+			std::vector<MsgId> hits;
+			int index = 0;
+			base::flat_set<MsgId> covered;
+			QStringList blocks;
+			Fn<void()> next;
+		};
+		const auto state = std::make_shared<State>();
+		for (const auto &item : hits) {
+			state->hits.push_back(item->id);
+		}
+		const auto weakState = std::weak_ptr<State>(state);
+		state->next = [=] {
+			const auto strong = weakState.lock();
+			if (!strong) {
+				return;
+			}
+			const auto count = int(strong->hits.size());
+			const auto last = std::min(count, kContextHits);
+			while (strong->index < last
+				&& strong->covered.contains(strong->hits[strong->index])) {
+				++strong->index;
+			}
+			if (strong->index >= last) {
+				auto content = u"Found %1 matches for \"%2\" in \"%3\". Each "
+					"match is marked with %4, with 5 messages around it."_q.arg(
+						QString::number(count),
+						query,
+						title,
+						Arrow());
+				content += u"\n\n"_q + strong->blocks.join(u"\n---\n"_q);
+				auto more = QStringList();
+				for (auto i = kContextHits; i < count; ++i) {
+					if (more.size() >= kMoreHits) {
+						break;
+					}
+					const auto item = session->data().message(
+						peer->id,
+						strong->hits[i]);
+					if (item) {
+						more.push_back(ItemLine(item, kMoreItemText));
+					}
+				}
+				if (!more.isEmpty()) {
+					content += u"\n\nMore matches without context:\n"_q
+						+ more.join('\n');
+				}
+				done({ .content = content, .title = toolTitle });
+				return;
+			}
+			const auto hit = strong->hits[strong->index++];
+			const auto add = [=](
+					std::vector<not_null<HistoryItem*>> around) {
+				ranges::sort(around, [](auto a, auto b) {
+					return a->id < b->id;
+				});
+				if (around.empty()) {
+					if (const auto item = session->data().message(
+							peer->id,
+							hit)) {
+						around.push_back(item);
+					}
+				}
+				auto lines = QStringList();
+				for (const auto &item : around) {
+					strong->covered.emplace(item->id);
+					const auto line = ItemLine(item, kContextItemText);
+					lines.push_back((item->id == hit)
+						? (Arrow() + u" "_q + line)
+						: line);
+				}
+				strong->covered.emplace(hit);
+				if (!lines.isEmpty()) {
+					strong->blocks.push_back(lines.join('\n'));
+				}
+				strong->next();
+			};
+			session->api().request(MTPmessages_GetHistory(
+				peer->input(),
+				MTP_int(int(hit.bare + 1)),
+				MTP_int(0),
+				MTP_int(-kContextAround),
+				MTP_int(kContextAround * 2 + 1),
+				MTP_int(0),
+				MTP_int(0),
+				MTP_long(0)
+			)).done([=](const MTPmessages_Messages &result) {
+				if (weak) {
+					add(Items(session, result));
+				}
+			}).fail([=](const MTP::Error &) {
+				if (weak) {
+					add({});
+				}
+			}).send();
+		};
+		state->next();
 	}).fail([=](const MTP::Error &error) {
 		if (weak) {
 			done(Error(error.type()));
@@ -940,6 +1303,10 @@ void Tools::searchMessages(
 		done(Error(u"Unknown chat_id."_q));
 		return;
 	}
+	if (peer) {
