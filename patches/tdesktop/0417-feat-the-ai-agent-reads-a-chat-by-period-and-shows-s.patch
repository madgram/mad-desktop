+void Tools::loadHistory(
+		not_null<PeerData*> peer,
+		int limit,
+		Fn<void(std::vector<not_null<HistoryItem*>>, QString)> done) {
+	struct State {
+		std::vector<not_null<HistoryItem*>> items;
+		MsgId offset = 0;
+		Fn<void()> next;
+	};
+	const auto state = std::make_shared<State>();
+	const auto weakState = std::weak_ptr<State>(state);
+	const auto weak = base::make_weak(this);
+	const auto session = _session;
+	state->next = [=] {
+		const auto strong = weakState.lock();
+		if (!strong) {
+			return;
+		}
+		const auto count = std::min(
+			limit - int(strong->items.size()),
+			kHistoryPage);
+		const auto finish = [=](QString error) {
+			auto items = std::move(strong->items);
+			ranges::sort(items, [](auto a, auto b) {
+				return a->id < b->id;
+			});
+			done(std::move(items), error);
+		};
+		session->api().request(MTPmessages_GetHistory(
+			peer->input(),
+			MTP_int(int(strong->offset.bare)),
+			MTP_int(0),
+			MTP_int(0),
+			MTP_int(count),
+			MTP_int(0),
+			MTP_int(0),
+			MTP_long(0)
+		)).done([=](const MTPmessages_Messages &result) {
+			if (!weak) {
+				return;
+			}
+			const auto page = Items(session, result);
+			auto oldest = strong->offset;
+			for (const auto &item : page) {
+				if (!oldest || item->id < oldest) {
+					oldest = item->id;
+				}
+			}
+			const auto progress = !page.empty() && (oldest != strong->offset);
+			strong->items.insert(end(strong->items), begin(page), end(page));
+			strong->offset = oldest;
+			if (progress && (int(strong->items.size()) < limit)) {
+				strong->next();
+			} else {
+				finish(QString());
+			}
+		}).fail([=](const MTP::Error &error) {
+			if (weak) {
+				finish(error.type());
+			}
+		}).send();
+	};
+	state->next();
+}
+
+void Tools::readPeriod(
+		not_null<PeerData*> peer,
+		TimeId from,
+		TimeId till,
+		Fn<void(ToolOutcome)> done) {
+	struct State {
+		std::vector<not_null<HistoryItem*>> items;
+		MsgId offset = 0;
+		int pages = 0;
+		Fn<void()> next;
+	};
+	const auto state = std::make_shared<State>();
+	const auto weakState = std::weak_ptr<State>(state);
+	const auto weak = base::make_weak(this);
+	const auto session = _session;
+	const auto title = Title(peer);
+	const auto toolTitle = Tr(u"Scrolled through %1"_q).arg(title);
+	state->next = [=] {
+		const auto strong = weakState.lock();
+		if (!strong) {
+			return;
+		}
+		const auto finish = [=](QString error) {
+			if (!error.isEmpty()) {
+				done(Error(error));
+				return;
+			}
+			auto items = std::vector<not_null<HistoryItem*>>();
+			for (const auto &item : strong->items) {
+				if (item->date() >= from && item->date() < till) {
+					items.push_back(item);
+				}
+			}
+			ranges::sort(items, [](auto a, auto b) {
+				return a->id < b->id;
+			});
+			if (items.empty()) {
+				done({
+					.content = u"No messages in this period."_q,
+					.title = toolTitle,
+				});
+				return;
+			}
+			auto lines = QStringList();
+			lines.push_back(u"Chat: %1, %2 messages for the period, oldest "
+				"first:"_q.arg(title, QString::number(items.size())));
+			auto total = 0;
+			for (const auto &item : items) {
+				const auto line = ItemLine(item, kPeriodItemText);
+				total += int(line.size());
+				if (total > kMaxPeriodChars) {
+					lines.push_back(u"The rest is cut by size."_q);
+					break;
+				}
+				lines.push_back(line);
+			}
+			done({ .content = lines.join('\n'), .title = toolTitle });
+		};
+		const auto offsetDate = strong->offset
+			? TimeId(0)
+			: (std::min(till, base::unixtime::now()) + 1);
+		session->api().request(MTPmessages_GetHistory(
+			peer->input(),
+			MTP_int(int(strong->offset.bare)),
+			MTP_int(offsetDate),
+			MTP_int(0),
+			MTP_int(kHistoryPage),
+			MTP_int(0),
+			MTP_int(0),
+			MTP_long(0)
+		)).done([=](const MTPmessages_Messages &result) {
+			if (!weak) {
+				return;
+			}
+			const auto page = Items(session, result);
+			auto oldest = strong->offset;
+			auto oldestDate = TimeId(0);
+			for (const auto &item : page) {
+				if (!oldest || item->id < oldest) {
+					oldest = item->id;
+					oldestDate = item->date();
+				}
+			}
+			const auto progress = !page.empty() && (oldest != strong->offset);
+			strong->items.insert(end(strong->items), begin(page), end(page));
+			strong->offset = oldest;
+			if (progress
+				&& (++strong->pages < kPeriodPages)
+				&& (oldestDate >= from)
+				&& (int(strong->items.size()) < kPeriodLimit)) {
+				strong->next();
+			} else {
+				finish(QString());
+			}
+		}).fail([=](const MTP::Error &error) {
+			if (weak) {
+				finish(error.type());
+			}
+		}).send();
+	};
+	state->next();
+}
