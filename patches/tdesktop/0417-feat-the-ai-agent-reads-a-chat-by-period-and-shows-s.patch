-			MTP_inputPeerEmpty(),
-			MTP_int(0),
-			MTP_int(limit)
-		)).done(finish).fail(fail).send();
-	}
+	_session->api().request(MTPmessages_SearchGlobal(
+		MTP_flags(0),
