+void StackAbove(not_null<QWidget*> widget, not_null<QWidget*> below) {
+	const auto parent = widget->parentWidget();
+	if (!parent || below->parentWidget() != parent) {
+		return;
+	}
+	auto found = false;
+	for (const auto child : parent->children()) {
+		if (!found) {
+			found = (child == below.get());
+		} else if (child != widget.get() && child->isWidgetType()) {
+			widget->stackUnder(static_cast<QWidget*>(child));
+			return;
+		}
+	}
+	if (found) {
+		widget->raise();
+	}
+}
