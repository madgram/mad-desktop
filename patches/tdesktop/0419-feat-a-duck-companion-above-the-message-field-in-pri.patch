+struct Key {
+	double time = 0.;
+	double value = 0.;
+};
+
+[[nodiscard]] double Sample(const std::vector<Key> &keys, double time) {
+	if (keys.empty()) {
+		return 0.;
+	} else if (time <= keys.front().time) {
+		return keys.front().value;
+	}
+	for (auto i = 1; i != int(keys.size()); ++i) {
+		const auto &to = keys[i];
+		if (time <= to.time) {
+			const auto &from = keys[i - 1];
+			const auto span = to.time - from.time;
+			const auto progress = (span > 0.)
+				? ((time - from.time) / span)
+				: 1.;
+			return from.value + (to.value - from.value) * progress;
+		}
+	}
+	return keys.back().value;
+}
