+struct Placement {
+	int x = kDefaultLeft;
+	int bottom = 0;
+	int size = kDefaultSize;
+};
+
+[[nodiscard]] Placement LoadPlacement() {
+	const auto parts = CompanionPlacement().split(QChar(';'));
+	auto result = Placement();
+	if (parts.size() == 3) {
+		result.x = parts[0].toInt();
+		result.bottom = parts[1].toInt();
+		result.size = std::clamp(parts[2].toInt(), kMinSize, kMaxSize);
+	}
+	return result;
+}
