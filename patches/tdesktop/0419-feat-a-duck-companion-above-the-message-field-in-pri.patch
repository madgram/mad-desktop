+	void setShown(bool shown);
+	void reloadPlacement();
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+	void showEvent(QShowEvent *e) override;
+	void hideEvent(QHideEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void mouseDoubleClickEvent(QMouseEvent *e) override;
+	void wheelEvent(QWheelEvent *e) override;
+
+private:
+	[[nodiscard]] int side() const;
+	[[nodiscard]] bool fits() const;
+	[[nodiscard]] bool fitsSize(int size) const;
+	[[nodiscard]] crl::time clock() const;
+	void restack();
+	[[nodiscard]] QPoint clamped(QPoint position) const;
+	void place();
+	void savePosition();
+	void refreshVisibility();
+	void refreshTimer();
+	void refreshMask();
+	void startBounce();
+	void paintWing(QPainter &p, double side, double angle) const;
+	void paintEye(
+		QPainter &p,
+		QPointF center,
+		double scale,
+		double blink) const;
+	void paintBeak(
+		QPainter &p,
+		QPointF offset,
+		double scale,
+		double open) const;
+
+	const not_null<Ui::ElasticScroll*> _scroll;
+	Placement _placement;
+	QRect _area;
+	bool _shown = false;
+	bool _pressed = false;
+	bool _moved = false;
+	bool _doubleClicked = false;
+	int _wheelDelta = 0;
+	QPoint _pressGlobal;
+	QPoint _pressPosition;
+	crl::time _started = 0;
+	crl::time _bounceStarted = 0;
+	crl::time _spinStarted = 0;
+	crl::time _pausedAt = 0;
+	base::Timer _timer;
+	base::Timer _bounceTimer;
+
+};
+
+Companion::Companion(not_null<Ui::ElasticScroll*> scroll)
+: RpWidget(scroll.get())
+, _scroll(scroll)
+, _placement(LoadPlacement())
+, _started(crl::now())
+, _timer([=] { update(); })
+, _bounceTimer([=] { startBounce(); }) {
+	setCursor(Qt::OpenHandCursor);
+	QObject::connect(
+		qApp,
+		&QGuiApplication::applicationStateChanged,
+		this,
+		[=] { refreshTimer(); });
+	hide();
+	restack();
+}
+
+int Companion::side() const {
+	return style::ConvertScale(_placement.size);
+}
+
+bool Companion::fits() const {
+	return fitsSize(_placement.size);
+}
+
+bool Companion::fitsSize(int size) const {
+	const auto scaled = style::ConvertScale(size);
+	return (_area.height() >= int(scaled * kMaskHeight))
+		&& (_area.width()
+			>= int(scaled * kMaskWidth) + style::ConvertScale(kCornerReserve));
+}
+
+crl::time Companion::clock() const {
+	return _pausedAt ? _pausedAt : crl::now();
+}
+
+void Companion::restack() {
+	if (const auto content = _scroll->widget()) {
+		StackAbove(this, content);
+	} else {
+		lower();
+	}
+}
+
+void Companion::reloadPlacement() {
+	if (_pressed) {
+		return;
+	}
+	_placement = LoadPlacement();
+	place();
+	refreshVisibility();
+}
+
+void Companion::setArea(QRect area) {
+	_area = area;
+	if (!_pressed) {
+		place();
+	}
+	refreshVisibility();
+}
+
+void Companion::setShown(bool shown) {
+	_shown = shown;
+	refreshVisibility();
+}
+
+void Companion::refreshVisibility() {
+	const auto visible = _shown && fits();
+	if (visible && isHidden()) {
+		place();
+		restack();
+		show();
+	} else if (!visible && !isHidden()) {
+		hide();
+	}
+}
+
+void Companion::refreshTimer() {
+	const auto active = isVisible()
+		&& (QGuiApplication::applicationState() == Qt::ApplicationActive);
+	if (active) {
+		if (_pausedAt) {
+			const auto shift = crl::now() - base::take(_pausedAt);
+			_started += shift;
+			if (_bounceStarted) {
+				_bounceStarted += shift;
+			}
+			if (_spinStarted) {
+				_spinStarted += shift;
+			}
+		}
+		if (!_timer.isActive()) {
+			_timer.callEach(kFrame);
+		}
+	} else if (!_pausedAt) {
+		_timer.cancel();
+		_pausedAt = crl::now();
+		update();
+	}
+}
+
+QPoint Companion::clamped(QPoint position) const {
+	const auto size = width();
+	const auto bottom = _area.y() + _area.height();
+	const auto minX = -int(size * kMaskLeft);
+	const auto maxX = std::max(
+		_area.width()
+			- int(size * (kMaskLeft + kMaskWidth))
+			- style::ConvertScale(kCornerReserve),
+		minX);
+	const auto minY = _area.y() - int(size * kMaskTop);
+	const auto maxY = std::max(
+		bottom - int(size * (kMaskTop + kMaskHeight)),
+		minY);
+	return QPoint(
+		std::clamp(position.x(), minX, maxX),
+		std::clamp(position.y(), minY, maxY));
+}
+
+void Companion::place() {
+	if (_area.isEmpty()) {
+		return;
+	}
+	const auto size = side();
+	const auto bottom = _area.y() + _area.height();
+	if (width() != size) {
+		resize(size, size);
+		refreshMask();
+	}
+	move(clamped(QPoint(_placement.x, bottom - _placement.bottom - size)));
+}
+
+void Companion::savePosition() {
+	_placement.x = x();
+	_placement.bottom = (_area.y() + _area.height()) - (y() + height());
+	SavePlacement(_placement);
+}
+
+void Companion::refreshMask() {
+	const auto size = width();
+	setMask(QRegion(QRect(
+		int(size * kMaskLeft),
+		int(size * kMaskTop),
+		int(size * kMaskWidth),
+		int(size * kMaskHeight))));
+}
+
+void Companion::startBounce() {
+	const auto now = crl::now();
+	if (!_bounceStarted || (now - _bounceStarted >= kBounceDuration)) {
+		_bounceStarted = now;
+	}
+}
+
+void Companion::showEvent(QShowEvent *e) {
+	RpWidget::showEvent(e);
+	refreshTimer();
+}
+
+void Companion::hideEvent(QHideEvent *e) {
+	RpWidget::hideEvent(e);
+	refreshTimer();
+}
+
+void Companion::mousePressEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	_pressed = true;
+	_moved = false;
+	_pressGlobal = e->globalPos();
+	_pressPosition = pos();
+	setCursor(Qt::ClosedHandCursor);
+}
+
+void Companion::mouseMoveEvent(QMouseEvent *e) {
+	if (!_pressed) {
+		return;
+	}
+	const auto delta = e->globalPos() - _pressGlobal;
+	if (!_moved
+		&& delta.manhattanLength() < QApplication::startDragDistance()) {
+		return;
+	}
+	_moved = true;
+	move(clamped(_pressPosition + delta));
+}
+
+void Companion::mouseReleaseEvent(QMouseEvent *e) {
+	if (!_pressed || e->button() != Qt::LeftButton) {
+		return;
+	}
+	_pressed = false;
+	setCursor(Qt::OpenHandCursor);
+	if (_moved) {
+		savePosition();
+	} else if (!_doubleClicked) {
+		_bounceTimer.callOnce(QApplication::doubleClickInterval());
+	}
+	_doubleClicked = false;
+}
+
+void Companion::mouseDoubleClickEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	_bounceTimer.cancel();
+	_spinStarted = crl::now();
+	mousePressEvent(e);
+	_doubleClicked = true;
+}
+
+void Companion::wheelEvent(QWheelEvent *e) {
+	if (e->phase() == Qt::ScrollMomentum) {
+		return;
+	}
+	_wheelDelta += e->angleDelta().y();
+	const auto steps = _wheelDelta / QWheelEvent::DefaultDeltasPerStep;
+	if (!steps) {
+		return;
+	}
+	_wheelDelta -= steps * QWheelEvent::DefaultDeltasPerStep;
+	auto size = std::clamp(
+		_placement.size + steps * kWheelStep,
+		kMinSize,
+		kMaxSize);
+	while (size > _placement.size && !fitsSize(size)) {
+		size = std::max(size - kWheelStep, _placement.size);
+	}
+	if (size == _placement.size) {
+		return;
+	}
+	const auto was = width();
+	const auto now = style::ConvertScale(size);
+	_placement.x = x() + (was - now) / 2;
+	_placement.bottom = (_area.y() + _area.height()) - (y() + height());
+	_placement.size = size;
+	SavePlacement(_placement);
+	place();
+	refreshVisibility();
+}
+
+void Companion::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.setRenderHint(QPainter::Antialiasing);
+
+	const auto now = clock();
+	const auto time = std::fmod((now - _started) / 1000., kLoop);
+	auto bounce = 1.;
+	if (_bounceStarted) {
+		const auto progress = (now - _bounceStarted)
+			/ double(kBounceDuration);
+		if (progress >= 1.) {
+			_bounceStarted = 0;
+		} else {
+			bounce = Sample(BounceKeys(), progress);
+		}
+	}
+	auto spin = 1.;
+	if (_spinStarted) {
+		const auto progress = (now - _spinStarted) / double(kSpinDuration);
+		if (progress >= 1.) {
+			_spinStarted = 0;
+		} else {
+			const auto eased = 1. - std::pow(1. - progress, 3.);
+			spin = std::cos(M_PI * (1. - eased));
+			if (std::abs(spin) < 0.05) {
+				spin = (spin < 0.) ? -0.05 : 0.05;
+			}
+		}
+	}
+
+	const auto size = double(width());
+	const auto unit = size / 6.;
+	p.translate(size / 2., size / 2. + kCenterY * unit);
+	p.scale(unit, -unit);
+
+	p.translate(0., kCenterY);
+	p.scale(bounce * spin, bounce);
+	p.translate(0., -kCenterY);
+
+	const auto squash = Sample(SquashKeys(), time);
+	p.translate(0., 0.02);
+	p.scale(squash, 2. - squash);
+	p.translate(0., -0.02);
+
+	const auto &body = BodyPath();
+	auto gradient = QRadialGradient(QPointF(-0.35, 1.95), 2.6);
+	gradient.setColorAt(0., QColor(0xFF, 0xE4, 0x5A));
+	gradient.setColorAt(0.5, QColor(0xFF, 0xD5, 0x27));
+	gradient.setColorAt(1., QColor(0xF2, 0xB2, 0x1E));
+	p.setPen(QPen(QColor(0xE6, 0x9A, 0x20, 70), 0.05));
+	p.setBrush(gradient);
+	p.drawPath(body);
+
+	auto shine = QRadialGradient(QPointF(-0.42, 2.05), 0.34);
+	shine.setColorAt(0., QColor(255, 255, 255, 170));
+	shine.setColorAt(1., QColor(255, 255, 255, 0));
+	p.setPen(Qt::NoPen);
+	p.setBrush(shine);
+	p.drawEllipse(QPointF(-0.42, 2.05), 0.34, 0.24);
+
+	paintWing(p, -1., Sample(LiftKeys(), time));
+	paintWing(p, 1., Sample(WaveKeys(), time));
+
+	const auto turn = Sample(TurnKeys(), time);
+	const auto nod = Sample(NodKeys(), time);
+	const auto blink = Sample(BlinkKeys(), time);
+	const auto open = Sample(MouthKeys(), time);
+	p.save();
+	p.setClipPath(body);
+	paintEye(
+		p,
+		QPointF(-0.5 - 0.4 * turn, 1.51 + nod),
+		1. - 0.6 * turn,
+		blink);
+	paintEye(
+		p,
+		QPointF(0.5 - 0.68 * turn, 1.51 + nod),
+		1. - 0.15 * turn,
+		blink);
+	paintBeak(p, QPointF(-0.67 * turn, nod), 1. - 0.15 * turn, open);
+	p.restore();
+}
+
+void Companion::paintWing(QPainter &p, double side, double angle) const {
+	p.save();
+	const auto pivot = QPointF(0.78 * side, 0.9);
+	p.translate(pivot);
+	p.rotate(angle * side);
+	p.translate(-pivot);
+	p.translate(0.9 * side, 0.64);
+	p.rotate(25. * side);
+	auto gradient = QLinearGradient(QPointF(0., 0.3), QPointF(0., -0.3));
+	gradient.setColorAt(0., QColor(0xF8, 0xC8, 0x22));
+	gradient.setColorAt(1., QColor(0xE0, 0xA0, 0x18));
+	p.setPen(QPen(QColor(0xE6, 0x9A, 0x20, 90), 0.03));
+	p.setBrush(gradient);
+	p.drawEllipse(QPointF(0., 0.), 0.13, 0.3);
+	p.restore();
+}
+
+void Companion::paintEye(
+		QPainter &p,
+		QPointF center,
+		double scale,
+		double blink) const {
+	if (blink > 0.85) {
+		auto path = QPainterPath();
+		path.moveTo(center.x() - 0.18 * scale, center.y() - 0.01);
+		path.quadTo(
+			center.x(),
+			center.y() - 0.19,
+			center.x() + 0.18 * scale,
+			center.y() - 0.01);
+		p.setPen(QPen(Qt::black, 0.06, Qt::SolidLine, Qt::RoundCap));
+		p.setBrush(Qt::NoBrush);
+		p.drawPath(path);
+		return;
+	}
+	p.setPen(Qt::NoPen);
+	p.setBrush(Qt::black);
+	p.drawEllipse(
+		center,
+		0.18 * scale,
+		std::max(0.235 * (1. - blink), 0.02));
+	if (blink < 0.5) {
+		p.setBrush(QColor(0xF8, 0xF8, 0xF8));
+		p.drawEllipse(
+			QPointF(center.x() - 0.075 * scale, center.y() + 0.075),
+			0.05 * scale,
+			0.07 * (1. - blink));
+	}
+}
+
+void Companion::paintBeak(
+		QPainter &p,
+		QPointF offset,
+		double scale,
+		double open) const {
+	p.save();
+	p.translate(offset);
+	p.scale(scale, 1.);
+	const auto orange = QColor(0xF8, 0x58, 0x18);
+	const auto drop = 0.1 * open;
+	p.setPen(Qt::NoPen);
+	p.setBrush(orange);
+	p.drawEllipse(QPointF(0., 1.2 - drop), 0.3, 0.08 + 0.03 * open);
+	if (open > 0.05) {
+		p.setBrush(QColor(0xB8, 0x30, 0x30));
+		p.drawEllipse(QPointF(0., 1.17 - drop * 0.5), 0.19, 0.03 + 0.07 * open);
+		p.setBrush(QColor(0xF0, 0x90, 0x50));
+		p.drawEllipse(QPointF(0., 1.11 - drop * 0.6), 0.09, 0.02 + 0.02 * open);
+	}
+	auto upper = QPainterPath();
+	upper.moveTo(0., 1.62);
+	upper.cubicTo(0.1, 1.55, 0.2, 1.4, 0.35, 1.27);
+	upper.cubicTo(0.3, 1.21, 0.1, 1.19, 0., 1.19);
+	upper.cubicTo(-0.1, 1.19, -0.3, 1.21, -0.35, 1.27);
+	upper.cubicTo(-0.2, 1.4, -0.1, 1.55, 0., 1.62);
+	p.setBrush(orange);
+	p.drawPath(upper);
+	p.restore();
+}
+
+} // namespace
+
+void SetupCompanion(
+		not_null<Ui::ElasticScroll*> scroll,
+		not_null<Window::SessionController*> controller) {
+	const auto companion = Ui::CreateChild<Companion>(scroll.get());
+	scroll->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		companion->setArea(QRect(QPoint(), size));
+	}, companion->lifetime());
+	CompanionPlacementChanges(
+	) | rpl::on_next([=] {
+		companion->reloadPlacement();
+	}, companion->lifetime());
+	const auto refresh = [=] {
+		const auto peer = controller->activeChatCurrent().peer();
+		const auto user = peer ? peer->asUser() : nullptr;
+		companion->setShown(ChatCompanion()
+			&& user
+			&& !user->isBot()
+			&& !user->isSelf());
+	};
+	controller->activeChatValue(
+	) | rpl::on_next([=](const Dialogs::Key &) {
+		refresh();
+	}, companion->lifetime());
+	ChatCompanionChanges(
+	) | rpl::on_next(refresh, companion->lifetime());
+}
+
+} // namespace Tele
