 	AddSkip(builder);
+	AddGroupTitle(builder, u"Buttons"_q);
 	AddOptionToggle(builder, ::Tele::kOptionButtonPayloads);
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionCopyButtonData,
 		{ u"callback"_q, u"clipboard"_q });
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Inline bots"_q);
 	AddOptionToggle(builder, ::Tele::kOptionInlineWithoutVia);
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionInlineAsText,
 		{ u"inline bot"_q });
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Bot chats"_q);
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionStartParam,
@@ -4069,6 +4074,8 @@ void FillBots(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionHideBotEdited,
 		{ u"edited"_q, u"bot"_q });
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Mini apps"_q);
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionTrustedAppLinks,
