+#include "tele/agent/agent_store.h"
+
+#include "base/options.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QFileInfo>
+#include <QtCore/QJsonDocument>
+
+namespace Tele::Agent {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x6d616461);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxMessages = 400;
+constexpr auto kMaxBytes = 32 * 1024 * 1024;
+
+[[nodiscard]] QString OptionText(const char id[]) {
+	return base::options::lookup<QString>(id).value().trimmed();
+}
+
+[[nodiscard]] bool OptionOn(const char id[]) {
+	return base::options::lookup<bool>(id).value();
+}
+
+} // namespace
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session) {
+	read();
+}
+
+QString Store::key(Provider provider) const {
+	const auto i = _keys.find(ProviderId(provider));
+	return (i != end(_keys)) ? i->second : QString();
+}
+
+void Store::setKey(Provider provider, const QString &value) {
+	const auto trimmed = value.trimmed();
+	if (trimmed.isEmpty()) {
+		_keys.erase(ProviderId(provider));
+	} else {
+		_keys[ProviderId(provider)] = trimmed;
+	}
+	write();
+}
+
+const std::vector<Message> &Store::messages() const {
+	return _messages;
+}
+
+void Store::setMessages(std::vector<Message> messages) {
+	if (int(messages.size()) > kMaxMessages) {
+		messages.erase(
+			begin(messages),
+			end(messages) - kMaxMessages);
+		while (!messages.empty() && messages.front().role != Role::User) {
+			messages.erase(begin(messages));
+		}
+	}
+	_messages = std::move(messages);
+	write();
+}
+
+QString Store::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void Store::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_agent"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto blob = QByteArray();
+	file.stream >> magic >> version >> owner >> blob;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| blob.size() > kMaxBytes) {
+		return;
+	}
+	const auto document = QJsonDocument::fromJson(blob);
+	if (!document.isObject()) {
+		return;
+	}
+	const auto object = document.object();
+	const auto keys = object.value(u"keys"_q).toObject();
+	for (auto i = keys.begin(); i != keys.end(); ++i) {
+		const auto value = i.value().toString();
+		if (!value.isEmpty()) {
+			_keys[i.key()] = value;
+		}
+	}
+	_messages = ParseMessages(object.value(u"messages"_q).toArray());
+}
+
+void Store::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto keys = QJsonObject();
+	for (const auto &[provider, value] : _keys) {
+		keys.insert(provider, value);
+	}
+	const auto blob = QJsonDocument(QJsonObject{
+		{ u"keys"_q, keys },
+		{ u"messages"_q, SerializeMessages(_messages) },
+	}).toJson(QJsonDocument::Compact);
+	auto data = EncryptedDescriptor(
+		sizeof(quint32) * 2 + sizeof(quint64) + sizeof(quint32) + blob.size());
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< blob;
+	auto file = FileWriteDescriptor(u"tele_agent"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+Provider CurrentProvider() {
+	return ProviderFromId(OptionText(kOptionAgentProvider));
+}
+
+QString CurrentModel() {
+	const auto value = OptionText(kOptionAgentModel);
+	return value.isEmpty() ? DefaultModel(CurrentProvider()) : value;
+}
+
+QString CurrentBaseUrl() {
+	const auto provider = CurrentProvider();
+	return IsCustom(provider)
+		? NormalizedBaseUrl(OptionText(kOptionAgentBaseUrl))
+		: OfficialBaseUrl(provider);
+}
+
+QString DefaultPersona() {
+	return Tr(u"You are an AI assistant inside mad. Talk briefly and to the "
+		"point, without bureaucratic language. When asked to retell a "
+		"conversation, pick out the main points: who said what, what was "
+		"agreed and what needs an answer."_q);
+}
+
+QString CurrentPersona() {
+	const auto value = OptionText(kOptionAgentPersona);
+	return value.isEmpty() ? DefaultPersona() : value;
+}
+
+bool AllowReadChats() {
+	return OptionOn(kOptionAgentReadChats);
+}
+
+bool AllowSendMessages() {
+	return OptionOn(kOptionAgentSend);
+}
+
+bool SendWithoutConfirmation() {
+	return OptionOn(kOptionAgentSendUnconfirmed);
+}
+
+bool AllowWebSearch() {
+	return OptionOn(kOptionAgentWebSearch);
+}
+
+} // namespace Tele::Agent
