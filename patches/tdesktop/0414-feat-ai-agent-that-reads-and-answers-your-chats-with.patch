+std::vector<ToolSpec> ToolSpecs() {
+	auto result = std::vector<ToolSpec>();
+	const auto read = AllowReadChats();
+	const auto send = AllowSendMessages();
+	if (read || send) {
+		result.push_back({
+			u"list_chats"_q,
+			u"List the user's recent Telegram chats, most recent first. "
+			"Returns chat_id, title, type, unread count and a preview of "
+			"the last message. Use it to find the chat_id of a chat before "
+			"reading or writing to it."_q,
+			Schema(QJsonObject{
+				{ u"limit"_q, Property(
+					u"integer"_q,
+					u"How many chats to return, 1-100. Default 30."_q) },
+				{ u"unread_only"_q, Property(
+					u"boolean"_q,
+					u"Return only chats with unread messages."_q) },
+			}),
+		});
+		result.push_back({
+			u"search_chats"_q,
+			u"Find the user's chats, contacts, groups and channels by name "
+			"or @username. Returns chat_id and title for each match."_q,
+			Schema(QJsonObject{
+				{ u"query"_q, Property(
+					u"string"_q,
+					u"Part of the chat title, contact name or username."_q) },
+			}, { u"query"_q }),
+		});
+	}
+	if (read) {
+		result.push_back({
+			u"read_chat"_q,
+			u"Read the latest messages of a chat. Returns messages oldest "
+			"first as #id [date] author: text; media is described in square "
+			"brackets. Unread messages are marked."_q,
+			Schema(QJsonObject{
+				{ u"chat_id"_q, Property(
+					u"string"_q,
+					u"chat_id from list_chats or search_chats."_q) },
+				{ u"limit"_q, Property(
+					u"integer"_q,
+					u"How many latest messages to read, 1-100. Default 60."_q) },
+			}, { u"chat_id"_q }),
+		});
+		result.push_back({
+			u"search_messages"_q,
+			u"Search messages by text across all of the user's chats, or "
+			"inside one chat. Returns matches newest first."_q,
+			Schema(QJsonObject{
+				{ u"query"_q, Property(u"string"_q, u"Words to search for."_q) },
+				{ u"chat_id"_q, Property(
+					u"string"_q,
+					u"Optional: search only in this chat."_q) },
+				{ u"limit"_q, Property(
+					u"integer"_q,
+					u"How many results, 1-50. Default 20."_q) },
+			}, { u"query"_q }),
+		});
+	}
+	if (send) {
+		result.push_back({
+			u"send_message"_q,
+			u"Send a text message to a chat on the user's behalf. Unless the "
+			"user turned confirmations off, they see a confirmation card; a "
+			"declined send comes back as an error. Use only when the user "
+			"asked to send or reply."_q,
+			Schema(QJsonObject{
+				{ u"chat_id"_q, Property(
+					u"string"_q,
+					u"chat_id from list_chats or search_chats."_q) },
+				{ u"text"_q, Property(
+					u"string"_q,
+					u"The message text, exactly as it should be sent."_q) },
+			}, { u"chat_id"_q, u"text"_q }),
+		});
+		result.push_back({
+			u"schedule_message"_q,
+			u"Schedule a text message to a chat for a later time. Same "
+			"confirmation rules as send_message."_q,
+			Schema(QJsonObject{
+				{ u"chat_id"_q, Property(u"string"_q) },
+				{ u"text"_q, Property(u"string"_q) },
+				{ u"send_at"_q, Property(
+					u"string"_q,
+					u"Local date and time, YYYY-MM-DD HH:MM. Use this or "
+					"in_minutes."_q) },
+				{ u"in_minutes"_q, Property(
+					u"integer"_q,
+					u"Send this many minutes from now."_q) },
+			}, { u"chat_id"_q, u"text"_q }),
+		});
+	}
+	result.push_back({
+		u"remind"_q,
+		u"Remind the user about something later: a scheduled message to "
+		"their Saved Messages arrives at the given time."_q,
+		Schema(QJsonObject{
+			{ u"text"_q, Property(u"string"_q, u"What to remind about."_q) },
+			{ u"remind_at"_q, Property(
+				u"string"_q,
+				u"Local date and time, YYYY-MM-DD HH:MM. Use this or "
+				"in_minutes."_q) },
+			{ u"in_minutes"_q, Property(u"integer"_q) },
+		}, { u"text"_q }),
+	});
+	return result;
+}
+
+QString TimeContext() {
