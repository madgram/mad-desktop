+QString OpenAIStream::error() const {
+	return _error;
+}
+
+bool OpenAIStream::done() const {
+	return _done;
+}
+
+Message OpenAIStream::finish(StopReason *reason) const {
+	auto message = MakeMessage(Role::Assistant, _text);
+	for (const auto &[index, call] : _calls) {
+		if (call.name.isEmpty()) {
+			continue;
+		}
+		message.toolCalls.push_back({
+			call.id.isEmpty() ? (u"call_"_s + NewId().left(12)) : call.id,
+			call.name,
+			call.arguments.isEmpty() ? u"{}"_s : call.arguments,
+		});
+	}
+	if (reason) {
+		const auto calls = !message.toolCalls.empty();
+		if (_finishReason == u"tool_calls"_s
+			|| _finishReason == u"function_call"_s) {
+			*reason = StopReason::ToolUse;
+		} else if (_finishReason == u"length"_s) {
+			*reason = StopReason::MaxTokens;
+		} else if (_finishReason == u"content_filter"_s) {
+			*reason = StopReason::Refusal;
+		} else if (_finishReason.isEmpty() || _finishReason == u"stop"_s) {
+			*reason = calls ? StopReason::ToolUse : StopReason::EndTurn;
+		} else {
+			*reason = calls ? StopReason::ToolUse : StopReason::Other;
+		}
+	}
+	return message;
+}
