+void AddMessage(
+		not_null<Ui::VerticalLayout*> content,
+		const Message &message) {
+	if (message.role == Role::Tool) {
+		auto text = message.toolTitle.isEmpty()
+			? Tr(u"Used a tool"_q)
+			: message.toolTitle;
+		if (message.isError) {
+			text += u": "_q + message.text.left(200);
+		}
+		content->add(
+			object_ptr<Ui::FlatLabel>(
+				content,
+				text,
+				st::settingsExperimentalAbout),
+			RowMargins(0, st::lineWidth * 6));
+		return;
+	} else if (message.text.isEmpty()) {
+		return;
+	}
+	const auto label = content->add(
+		object_ptr<Ui::FlatLabel>(content, st::boxLabel),
+		RowMargins(st::lineWidth * 4, st::lineWidth * 10));
+	label->setMarkedText((message.role == Role::User)
+		? Authored(Tr(u"You"_q), TextWithEntities::Simple(message.text))
+		: Authored(Tr(u"Agent"_q), Markdown(message.text)));
+	label->setSelectable(true);
+}
+
+void SetupConfirm(not_null<Main::Session*> session) {
+	Runner::For(session).setConfirm([=](
+			Confirmation confirmation,
+			Fn<void(bool)> decided) {
+		const auto i = Panels().find(session);
+		if (i == end(Panels())) {
+			decided(false);
+			return;
+		}
+		const auto pending = std::make_shared<Fn<void(bool)>>(decided);
+		i->second.pending = pending;
+		const auto decide = [=](bool approved) {
+			if (const auto callback = base::take(*pending)) {
+				callback(approved);
+			}
+		};
+		auto box = Ui::MakeConfirmBox({
+			.text = TextWithEntities::Simple(confirmation.text),
+			.confirmed = [=](Fn<void()> close) {
+				decide(true);
+				close();
+			},
+			.cancelled = [=](Fn<void()> close) {
+				decide(false);
+				close();
+			},
+			.confirmText = confirmation.confirm,
+			.title = confirmation.title,
+		});
+		box->boxClosing() | rpl::on_next([=] {
+			decide(false);
+		}, box->lifetime());
+		i->second.panel->showBox(
+			std::move(box),
+			Ui::LayerOption::KeepOther,
+			anim::type::normal);
+	});
+}
+
+[[nodiscard]] base::unique_qptr<Ui::RpWidget> MakeChat(
+		not_null<QWidget*> parent,
+		not_null<Main::Session*> session) {
+	auto result = base::make_unique_q<Ui::RpWidget>(parent);
+	const auto raw = result.get();
+	const auto scroll = Ui::CreateChild<Ui::ScrollArea>(raw, st::boxScroll);
+	const auto content = scroll->setOwnedWidget(
+		object_ptr<Ui::VerticalLayout>(scroll));
+	const auto shadow = Ui::CreateChild<Ui::PlainShadow>(raw);
+	const auto bottom = Ui::CreateChild<Ui::RpWidget>(raw);
+	const auto status = Ui::CreateChild<Ui::FlatLabel>(
+		bottom,
+		QString(),
+		st::settingsExperimentalAbout);
+	const auto field = Ui::CreateChild<Ui::InputField>(
+		bottom,
+		st::defaultInputField,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(Tr(u"Ask the agent…"_q)),
+		QString());
+	field->setSubmitSettings(Ui::InputField::SubmitSettings::Enter);
+	field->setMaxHeight(style::ConvertScale(160));
+	const auto send = Ui::CreateChild<Ui::RoundButton>(
+		bottom,
+		rpl::single(Tr(u"Send"_q)),
+		st::defaultActiveButton);
+	const auto stop = Ui::CreateChild<Ui::RoundButton>(
+		bottom,
+		rpl::single(Tr(u"Stop"_q)),
+		st::defaultLightButton);
+	send->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	stop->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+
+	struct State {
+		int shown = -1;
+		QString error;
+		bool running = false;
+		QString status;
+		Ui::FlatLabel *live = nullptr;
+	};
+	const auto state = raw->lifetime().make_state<State>();
+
+	const auto layoutBottom = [=] {
+		const auto width = bottom->width();
+		const auto &padding = st::boxRowPadding;
+		const auto skip = st::boxRowPadding.left() / 2;
+		const auto button = send->isHidden() ? stop : send;
+		const auto statusHeight = state->status.isEmpty()
+			? 0
+			: (status->height() + skip);
+		const auto fieldWidth = std::max(
+			width - padding.left() - padding.right() - button->width() - skip,
+			1);
+		status->resizeToWidth(std::max(
+			width - padding.left() - padding.right(),
+			1));
+		status->moveToLeft(padding.left(), skip);
+		field->resizeToWidth(fieldWidth);
+		field->moveToLeft(padding.left(), skip + statusHeight);
+		const auto height = skip * 2 + statusHeight + std::max(
+			field->height(),
+			button->height());
+		send->moveToRight(padding.right(), height - skip - send->height());
+		stop->moveToRight(padding.right(), height - skip - stop->height());
+		if (bottom->height() != height) {
+			bottom->resize(width, height);
+		}
+	};
+	const auto layout = [=] {
+		const auto size = raw->size();
+		bottom->resizeToWidth(size.width());
+		layoutBottom();
+		const auto bottomTop = size.height() - bottom->height();
+		bottom->moveToLeft(0, bottomTop);
+		shadow->setGeometry(0, bottomTop - st::lineWidth, size.width(), st::lineWidth);
+		scroll->setGeometry(0, 0, size.width(), std::max(bottomTop - st::lineWidth, 0));
+		content->resizeToWidth(size.width());
+	};
+	const auto scrollDown = [=] {
+		crl::on_main(scroll, [=] {
+			scroll->scrollToY(scroll->scrollTopMax());
+		});
+	};
+	const auto rebuild = [=] {
+		const auto &runner = Runner::For(session);
+		content->clear();
+		if (runner.messages().empty()) {
+			content->add(
+				object_ptr<Ui::FlatLabel>(
+					content,
+					Tr(u"Ask about your chats, ask to retell a conversation, "
+						"reply to someone or set a reminder. The agent uses "
+						"your own API key from the settings."_q),
+					st::settingsExperimentalAbout),
+				RowMargins(st::boxRowPadding.left(), st::lineWidth * 10));
+		}
+		for (const auto &message : runner.messages()) {
+			AddMessage(content, message);
+		}
+		state->live = content->add(
+			object_ptr<Ui::FlatLabel>(content, st::boxLabel),
+			RowMargins(st::lineWidth * 4, st::lineWidth * 4));
+		state->live->setSelectable(true);
+		if (!runner.lastError().isEmpty()) {
+			const auto error = content->add(
+				object_ptr<Ui::FlatLabel>(
+					content,
+					runner.lastError(),
+					st::boxLabel),
+				RowMargins(st::lineWidth * 4, st::lineWidth * 4));
+			error->setTextColorOverride(st::boxTextFgError->c);
+			if (runner.canRetry()) {
+				const auto retry = content->add(
+					object_ptr<Ui::SettingsButton>(
+						content,
+						rpl::single(Tr(u"Try again"_q)),
+						st::settingsButtonNoIcon));
+				retry->setClickedCallback([=] {
+					Runner::For(session).retry();
+				});
+			}
+		}
+		state->shown = int(runner.messages().size());
+		state->error = runner.lastError();
+		content->resizeToWidth(scroll->width());
+	};
+	const auto refresh = [=] {
+		const auto &runner = Runner::For(session);
+		if (state->shown != int(runner.messages().size())
+			|| state->error != runner.lastError()) {
+			rebuild();
+		}
+		const auto streaming = runner.streaming();
+		state->live->setMarkedText(streaming.isEmpty()
+			? TextWithEntities()
+			: Authored(
+				Tr(u"Agent"_q),
+				TextWithEntities::Simple(streaming)));
+		state->status = runner.status();
+		status->setText(state->status);
+		send->setVisible(!runner.running());
+		stop->setVisible(runner.running());
+		state->running = runner.running();
+		content->resizeToWidth(scroll->width());
+		layout();
+		scrollDown();
+	};
+	const auto submit = [=] {
+		auto &runner = Runner::For(session);
+		const auto text = field->getLastText().trimmed();
+		if (text.isEmpty() || runner.running()) {
+			return;
+		}
+		field->clear();
+		runner.send(text);
+	};
+	field->submits() | rpl::on_next(submit, field->lifetime());
+	send->setClickedCallback(submit);
+	stop->setClickedCallback([=] {
+		Runner::For(session).stop();
+	});
+	field->heightChanges() | rpl::on_next([=] {
+		layout();
+	}, field->lifetime());
+	raw->sizeValue() | rpl::on_next([=] {
+		layout();
+	}, raw->lifetime());
+	Runner::For(session).updates(
+	) | rpl::on_next(refresh, raw->lifetime());
+	refresh();
+	crl::on_main(field, [=] {
+		field->setFocusFast();
+	});
+	return result;
+}
+
