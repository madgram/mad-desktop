+#pragma once
+
+#include "base/weak_ptr.h"
+#include "tele/agent/agent_tools.h"
+
+#include <QtCore/QObject>
+#include <QtCore/QPointer>
+
+class QNetworkAccessManager;
+class QNetworkReply;
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace Tele::Agent {
+
+class Store;
+
+class Runner final : public QObject, public base::has_weak_ptr {
+public:
+	explicit Runner(not_null<Main::Session*> session);
+	~Runner();
+
+	[[nodiscard]] static Runner &For(not_null<Main::Session*> session);
+
+	void send(const QString &text);
+	void stop();
+	void clear();
+	void retry();
+
+	[[nodiscard]] const std::vector<Message> &messages() const;
+	[[nodiscard]] QString streaming() const;
+	[[nodiscard]] bool running() const;
+	[[nodiscard]] QString status() const;
+	[[nodiscard]] QString lastError() const;
+	[[nodiscard]] bool canRetry() const;
+	[[nodiscard]] rpl::producer<> updates() const;
+
+	[[nodiscard]] QString key(Provider provider) const;
+	void setKey(Provider provider, const QString &value);
+	void checkKey(Fn<void(QString)> done);
+
+	void setConfirm(Confirm confirm);
+
+private:
+	void start();
+	void step();
+	void request();
+	void readAvailable();
+	void finished();
+	void completed(Message message, StopReason reason);
+	void runTools(std::vector<ToolCall> calls, int index);
+	void finish(const QString &error);
+	void persist();
+	void notify();
+
+	const not_null<Main::Session*> _session;
+	const std::unique_ptr<Store> _store;
+	const std::unique_ptr<Tools> _tools;
+	const std::unique_ptr<QNetworkAccessManager> _network;
+	std::vector<Message> _messages;
+	QString _streaming;
+	QString _status;
+	QString _lastError;
+	bool _running = false;
+	int _iterations = 0;
+	bool _dropThinking = false;
+	int _generation = 0;
+	QPointer<QNetworkReply> _reply;
+	int _httpStatus = 0;
+	QByteArray _errorBody;
+	SseParser _sse;
+	std::unique_ptr<AnthropicStream> _anthropic;
+	std::unique_ptr<OpenAIStream> _openai;
+	Confirm _confirm;
+	rpl::event_stream<> _updates;
+
+};
+
