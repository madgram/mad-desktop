+std::vector<StreamEvent> AnthropicStream::apply(const QByteArray &payload) {
+	auto result = std::vector<StreamEvent>();
+	const auto event = ParseObject(payload);
+	const auto type = event.value(u"type"_s).toString();
+	const auto index = event.value(u"index"_s).toInt(-1);
+	if (type == u"content_block_start"_s) {
+		const auto block = event.value(u"content_block"_s).toObject();
+		if (index < 0 || block.isEmpty()) {
+			return result;
+		}
+		_blocks[index] = block;
+		const auto kind = block.value(u"type"_s).toString();
+		if (kind == u"thinking"_s || kind == u"redacted_thinking"_s) {
+			result.push_back({ StreamEvent::Type::Thinking });
+		} else if (kind == u"tool_use"_s) {
+			_partialJson[index] = QString();
+			result.push_back({
+				StreamEvent::Type::ToolStarted,
+				block.value(u"name"_s).toString(),
+			});
+		} else if (kind == u"server_tool_use"_s) {
+			_partialJson[index] = QString();
+			result.push_back({
+				StreamEvent::Type::ServerTool,
+				block.value(u"name"_s).toString(),
+			});
+		} else if (kind == u"text"_s) {
+			const auto text = block.value(u"text"_s).toString();
+			if (!text.isEmpty()) {
+				result.push_back({ StreamEvent::Type::TextDelta, text });
+			}
+		}
+	} else if (type == u"content_block_delta"_s) {
+		const auto i = _blocks.find(index);
+		if (i == end(_blocks)) {
+			return result;
+		}
+		auto &block = i->second;
+		const auto delta = event.value(u"delta"_s).toObject();
+		const auto kind = delta.value(u"type"_s).toString();
+		const auto add = [&](const QString &key, const QString &value) {
+			block.insert(key, block.value(key).toString() + value);
+		};
+		if (kind == u"text_delta"_s) {
+			const auto text = delta.value(u"text"_s).toString();
+			add(u"text"_s, text);
+			if (!text.isEmpty()) {
+				result.push_back({ StreamEvent::Type::TextDelta, text });
+			}
+		} else if (kind == u"thinking_delta"_s) {
+			add(u"thinking"_s, delta.value(u"thinking"_s).toString());
+		} else if (kind == u"signature_delta"_s) {
+			add(u"signature"_s, delta.value(u"signature"_s).toString());
+		} else if (kind == u"input_json_delta"_s) {
+			_partialJson[index] += delta.value(u"partial_json"_s).toString();
+		}
+	} else if (type == u"content_block_stop"_s) {
+		const auto i = _blocks.find(index);
+		if (i == end(_blocks)) {
+			return result;
+		}
+		const auto kind = i->second.value(u"type"_s).toString();
+		if (kind == u"tool_use"_s || kind == u"server_tool_use"_s) {
+			i->second.insert(
+				u"input"_s,
+				ParseObject(_partialJson[index].toUtf8()));
+		}
+	} else if (type == u"message_delta"_s) {
+		const auto reason = event.value(u"delta"_s).toObject().value(
+			u"stop_reason"_s).toString();
+		if (!reason.isEmpty()) {
+			_stopReason = reason;
+		}
+	} else if (type == u"error"_s) {
+		_error = event.value(u"error"_s).toObject().value(
+			u"message"_s).toString();
+		if (_error.isEmpty()) {
+			_error = u"API error."_s;
+		}
+	}
+	return result;
+}
