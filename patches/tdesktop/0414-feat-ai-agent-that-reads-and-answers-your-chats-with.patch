+	OpenAI,
+	AnthropicCompatible,
+	OpenAICompatible,
+};
+
+[[nodiscard]] Provider ProviderFromId(const QString &id);
+[[nodiscard]] QString ProviderId(Provider provider);
+[[nodiscard]] bool UsesAnthropic(Provider provider);
+[[nodiscard]] bool IsCustom(Provider provider);
+[[nodiscard]] QString OfficialBaseUrl(Provider provider);
+[[nodiscard]] QString DefaultModel(Provider provider);
+[[nodiscard]] QString AnthropicVersion(Provider provider);
+
+struct ToolCall {
+	QString id;
+	QString name;
+	QString arguments;
+
+	[[nodiscard]] QJsonObject argumentsObject() const;
+};
+
+struct Image {
+	QString mediaType;
+	QString base64;
+};
+
+enum class Role {
+	User,
+	Assistant,
+	Tool,
+};
+
+struct Message {
+	QString id;
+	Role role = Role::User;
+	QString text;
+	std::vector<ToolCall> toolCalls;
+	QString toolCallId;
+	QString toolTitle;
+	bool isError = false;
+	QByteArray anthropicBlocks;
+	QString anthropicModel;
+	QString contextPrefix;
+	std::vector<Image> images;
+	qint64 date = 0;
+
+	[[nodiscard]] QString requestText() const;
+};
+
+[[nodiscard]] Message MakeMessage(Role role, const QString &text);
+
+struct ToolSpec {
+	QString name;
+	QString description;
+	QJsonObject schema;
+};
+
+enum class StopReason {
+	EndTurn,
+	ToolUse,
+	MaxTokens,
+	Refusal,
+	Pause,
+	Other,
+};
+
+struct StreamEvent {
+	enum class Type {
+		TextDelta,
+		Thinking,
+		ToolStarted,
+		ServerTool,
+	};
+	Type type = Type::TextDelta;
+	QString text;
+};
+
+[[nodiscard]] QString NormalizedBaseUrl(const QString &value);
+[[nodiscard]] QString ErrorMessage(int status, const QByteArray &body);
+
+class SseParser final {
+public:
+	[[nodiscard]] std::vector<QByteArray> feed(const QByteArray &chunk);
+	[[nodiscard]] std::vector<QByteArray> finish();
+
+private:
+	void take(QByteArray line, std::vector<QByteArray> &result);
+
+	QByteArray _buffer;
+
+};
+
+[[nodiscard]] QJsonObject AnthropicBody(
+	const QString &model,
+	int maxTokens,
+	const QString &system,
+	const std::vector<Message> &messages,
+	const std::vector<ToolSpec> &tools,
+	bool webTools,
+	bool dropThinking);
+[[nodiscard]] QJsonObject OpenAIBody(
+	const QString &model,
+	const QString &system,
+	const std::vector<Message> &messages,
+	const std::vector<ToolSpec> &tools);
+
+class AnthropicStream final {
+public:
+	explicit AnthropicStream(QString model);
+
+	[[nodiscard]] std::vector<StreamEvent> apply(const QByteArray &payload);
+	[[nodiscard]] QString error() const;
+	[[nodiscard]] Message finish(StopReason *reason) const;
+
+private:
+	QString _model;
+	std::map<int, QJsonObject> _blocks;
+	std::map<int, QString> _partialJson;
+	QString _stopReason;
+	QString _error;
+
+};
+
+class OpenAIStream final {
+public:
+	[[nodiscard]] std::vector<StreamEvent> apply(const QByteArray &payload);
+	[[nodiscard]] QString error() const;
+	[[nodiscard]] bool done() const;
+	[[nodiscard]] Message finish(StopReason *reason) const;
+
+private:
+	struct Call {
+		QString id;
+		QString name;
+		QString arguments;
+	};
+
+	QString _text;
+	std::map<int, Call> _calls;
+	QString _finishReason;
+	QString _error;
+	bool _reportedThinking = false;
+	bool _done = false;
+
+};
+
+[[nodiscard]] QJsonArray SerializeMessages(
+	const std::vector<Message> &messages);
+[[nodiscard]] std::vector<Message> ParseMessages(const QJsonArray &list);
+void RepairDanglingToolCalls(
+	std::vector<Message> &messages,
+	const QString &cancelled);
+
