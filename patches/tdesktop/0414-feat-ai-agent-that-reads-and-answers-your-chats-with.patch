+[[nodiscard]] rpl::producer<QString> OptionTextValue(
+		const char id[],
+		const QString &empty) {
+	auto &option = base::options::lookup<QString>(id);
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		option.changes()
+	) | rpl::map([&option, empty] {
+		const auto value = option.value().trimmed();
+		return value.isEmpty()
+			? empty
+			: (value.size() > 40)
+			? (value.left(40) + QChar(0x2026))
+			: value;
+	});
+}
