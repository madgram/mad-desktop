+QJsonArray SerializeMessages(const std::vector<Message> &messages) {
+	auto result = QJsonArray();
+	for (const auto &message : messages) {
+		auto calls = QJsonArray();
+		for (const auto &call : message.toolCalls) {
+			calls.append(QJsonObject{
+				{ u"id"_s, call.id },
+				{ u"name"_s, call.name },
+				{ u"arguments"_s, call.arguments },
+			});
+		}
+		auto images = QJsonArray();
+		for (const auto &image : message.images) {
+			images.append(QJsonObject{
+				{ u"mediaType"_s, image.mediaType },
+				{ u"base64"_s, image.base64 },
+			});
+		}
+		auto object = QJsonObject{
+			{ u"id"_s, message.id },
+			{ u"role"_s, RoleId(message.role) },
+			{ u"text"_s, message.text },
+			{ u"date"_s, double(message.date) },
+		};
+		if (!calls.isEmpty()) {
+			object.insert(u"toolCalls"_s, calls);
+		}
+		if (!message.toolCallId.isEmpty()) {
+			object.insert(u"toolCallId"_s, message.toolCallId);
+		}
+		if (!message.toolTitle.isEmpty()) {
+			object.insert(u"toolTitle"_s, message.toolTitle);
+		}
+		if (message.isError) {
+			object.insert(u"isError"_s, true);
+		}
+		if (!message.anthropicBlocks.isEmpty()) {
+			object.insert(
+				u"anthropicBlocks"_s,
+				QString::fromUtf8(message.anthropicBlocks));
+			object.insert(u"anthropicModel"_s, message.anthropicModel);
+		}
+		if (!message.contextPrefix.isEmpty()) {
+			object.insert(u"contextPrefix"_s, message.contextPrefix);
+		}
+		if (!images.isEmpty()) {
+			object.insert(u"images"_s, images);
+		}
+		result.append(object);
+	}
+	return result;
+}
+
+std::vector<Message> ParseMessages(const QJsonArray &list) {
+	auto result = std::vector<Message>();
+	for (const auto &entry : list) {
+		const auto object = entry.toObject();
+		if (object.isEmpty()) {
+			continue;
+		}
+		auto message = Message();
+		message.id = object.value(u"id"_s).toString();
+		if (message.id.isEmpty()) {
+			message.id = NewId();
+		}
+		message.role = RoleFromId(object.value(u"role"_s).toString());
+		message.text = object.value(u"text"_s).toString();
+		message.date = qint64(object.value(u"date"_s).toDouble());
+		for (const auto &value : object.value(u"toolCalls"_s).toArray()) {
+			const auto call = value.toObject();
+			message.toolCalls.push_back({
+				call.value(u"id"_s).toString(),
+				call.value(u"name"_s).toString(),
+				call.value(u"arguments"_s).toString(),
+			});
+		}
+		message.toolCallId = object.value(u"toolCallId"_s).toString();
+		message.toolTitle = object.value(u"toolTitle"_s).toString();
+		message.isError = object.value(u"isError"_s).toBool();
+		message.anthropicBlocks = object.value(
+			u"anthropicBlocks"_s).toString().toUtf8();
+		message.anthropicModel = object.value(u"anthropicModel"_s).toString();
+		message.contextPrefix = object.value(u"contextPrefix"_s).toString();
+		for (const auto &value : object.value(u"images"_s).toArray()) {
+			const auto image = value.toObject();
+			message.images.push_back({
+				image.value(u"mediaType"_s).toString(),
+				image.value(u"base64"_s).toString(),
+			});
+		}
+		result.push_back(std::move(message));
+	}
+	return result;
+}
+
+void RepairDanglingToolCalls(
+		std::vector<Message> &messages,
+		const QString &cancelled) {
+	auto index = int(messages.size()) - 1;
+	while (index >= 0
+		&& !(messages[index].role == Role::Assistant
+			&& !messages[index].toolCalls.empty())) {
+		--index;
+	}
+	if (index < 0) {
+		return;
+	}
+	auto answered = QSet<QString>();
+	auto insertion = int(messages.size());
+	for (auto i = index + 1; i != int(messages.size()); ++i) {
+		if (messages[i].role == Role::Tool) {
+			answered.insert(messages[i].toolCallId);
+		} else if (insertion == int(messages.size())) {
+			insertion = i;
+		}
+	}
+	auto missing = std::vector<Message>();
+	for (const auto &call : messages[index].toolCalls) {
+		if (!answered.contains(call.id)) {
+			auto message = MakeMessage(Role::Tool, cancelled);
+			message.toolCallId = call.id;
+			message.isError = true;
+			missing.push_back(std::move(message));
+		}
+	}
+	messages.insert(
+		begin(messages) + insertion,
+		begin(missing),
+		end(missing));
+}
+
+} // namespace Tele::Agent
