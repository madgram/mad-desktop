index 0000000000000000000000000000000000000000..4ad30581335de5a5bc9d6b161c8f8599c93de23b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/agent/agent_runner.cpp
@@ -0,0 +1,470 @@
+#include "tele/agent/agent_runner.h"
+
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "tele/agent/agent_store.h"
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_lowercase.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele::Agent {
+namespace {
+
+constexpr auto kMaxIterations = 16;
+constexpr auto kMaxTokens = 8192;
+constexpr auto kMaxErrorBody = 16 * 1024;
+
+[[nodiscard]] base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Runner>> &Runners() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Runner>>();
+	return result;
+}
+
+[[nodiscard]] QString Cancelled() {
+	return Tr(u"Cancelled by the user."_q);
+}
+
+[[nodiscard]] QNetworkRequest MakeRequest(
+		Provider provider,
+		const QString &url,
+		const QString &key) {
+	auto result = QNetworkRequest(QUrl(url));
+	result.setHeader(QNetworkRequest::ContentTypeHeader, u"application/json"_q);
+	result.setRawHeader("Accept", "text/event-stream");
+	result.setTransferTimeout(120000);
+	if (UsesAnthropic(provider)) {
+		result.setRawHeader("x-api-key", key.toUtf8());
+		result.setRawHeader(
+			"anthropic-version",
+			AnthropicVersion(provider).toUtf8());
+		if (provider != Provider::Anthropic) {
+			result.setRawHeader("Authorization", "Bearer " + key.toUtf8());
+		}
+	} else {
+		result.setRawHeader("Authorization", "Bearer " + key.toUtf8());
+	}
+	return result;
+}
+
+[[nodiscard]] QString ToolStatus(const QString &name) {
+	if (name == u"web_search"_q) {
+		return Tr(u"Searching the web…"_q);
+	} else if (name == u"web_fetch"_q) {
+		return Tr(u"Reading a page…"_q);
+	} else if (name == u"read_chat"_q) {
+		return Tr(u"Reading the chat…"_q);
+	} else if (name == u"list_chats"_q || name == u"search_chats"_q) {
+		return Tr(u"Looking through the chats…"_q);
+	} else if (name == u"search_messages"_q) {
+		return Tr(u"Searching messages…"_q);
+	}
+	return Tr(u"Working…"_q);
+}
+
+} // namespace
+
+Runner::Runner(not_null<Main::Session*> session)
+: _session(session)
+, _store(std::make_unique<Store>(session))
+, _tools(std::make_unique<Tools>(session))
+, _network(std::make_unique<QNetworkAccessManager>()) {
+	_messages = _store->messages();
+	RepairDanglingToolCalls(_messages, Cancelled());
+}
+
+Runner::~Runner() {
+	++_generation;
+	if (_reply) {
+		_reply->abort();
+	}
+}
+
+Runner &Runner::For(not_null<Main::Session*> session) {
+	auto &runners = Runners();
+	const auto i = runners.find(session);
+	if (i != end(runners)) {
+		return *i->second;
+	}
+	const auto result = runners.emplace(
+		session,
+		std::make_unique<Runner>(session)).first->second.get();
+	session->lifetime().add([=] {
+		Runners().remove(session);
+	});
+	return *result;
+}
+
+void Runner::send(const QString &text) {
+	const auto trimmed = text.trimmed();
+	if (trimmed.isEmpty() || _running) {
+		return;
+	}
+	_lastError = QString();
+	auto message = MakeMessage(Role::User, trimmed);
+	message.contextPrefix = TimeContext();
+	_messages.push_back(std::move(message));
+	persist();
+	_iterations = 0;
+	_dropThinking = false;
+	start();
+}
+
+void Runner::stop() {
+	if (!_running) {
+		return;
+	}
+	++_generation;
+	if (const auto reply = _reply.data()) {
+		_reply = nullptr;
+		reply->abort();
+	}
+	finish(QString());
+}
+
+void Runner::clear() {
+	stop();
+	_messages.clear();
+	_lastError = QString();
+	persist();
+	notify();
+}
+
+void Runner::retry() {
+	if (!canRetry()) {
+		return;
+	}
+	_lastError = QString();
+	_iterations = 0;
+	start();
+}
+
+const std::vector<Message> &Runner::messages() const {
+	return _messages;
+}
+
+QString Runner::streaming() const {
+	return _streaming;
+}
+
+bool Runner::running() const {
+	return _running;
+}
+
+QString Runner::status() const {
+	return _status;
+}
+
+QString Runner::lastError() const {
+	return _lastError;
+}
+
+bool Runner::canRetry() const {
+	return !_running
+		&& !_lastError.isEmpty()
+		&& !_messages.empty()
+		&& (_messages.back().role != Role::Assistant
+			|| !_messages.back().toolCalls.empty());
+}
+
+rpl::producer<> Runner::updates() const {
+	return _updates.events();
+}
+
+QString Runner::key(Provider provider) const {
+	return _store->key(provider);
+}
+
+void Runner::setKey(Provider provider, const QString &value) {
+	_store->setKey(provider, value);
+	notify();
+}
+
+void Runner::checkKey(Fn<void(QString)> done) {
+	if (OfflineForLaunch()) {
+		done(Tr(u"The agent is off: mad was started with -teleoffline."_q));
+		return;
+	}
+	const auto provider = CurrentProvider();
+	const auto key = _store->key(provider);
+	const auto base = CurrentBaseUrl();
+	if (key.isEmpty()) {
+		done(Tr(u"Add an API key first."_q));
+		return;
+	} else if (base.isEmpty()) {
+		done(Tr(u"Set the API address first."_q));
+		return;
+	}
+	auto request = MakeRequest(provider, base + u"/models"_q, key);
+	request.setRawHeader("Accept", "application/json");
+	const auto reply = _network->get(request);
+	QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		const auto body = reply->read(kMaxErrorBody);
+		reply->deleteLater();
+		done((status >= 200 && status < 300)
+			? QString()
+			: ErrorMessage(status, body));
+	});
+}
+
+void Runner::setConfirm(Confirm confirm) {
+	_confirm = std::move(confirm);
+}
+
+void Runner::start() {
+	_running = true;
+	_streaming = QString();
+	_status = Tr(u"Thinking…"_q);
+	notify();
+	step();
+}
+
+void Runner::step() {
+	if (!_running) {
+		return;
+	}
+	if (++_iterations > kMaxIterations) {
+		finish(Tr(u"The agent made too many steps in a row and stopped."_q));
+		return;
+	} else if (OfflineForLaunch()) {
+		finish(Tr(u"The agent is off: mad was started with -teleoffline."_q));
+		return;
+	}
+	const auto provider = CurrentProvider();
+	if (_store->key(provider).isEmpty()) {
+		finish(Tr(u"Add an API key in the agent settings."_q));
+		return;
+	} else if (CurrentModel().isEmpty()) {
+		finish(Tr(u"Choose a model in the agent settings."_q));
+		return;
+	} else if (CurrentBaseUrl().isEmpty()) {
+		finish(Tr(u"Set the API address in the agent settings."_q));
+		return;
+	}
+	request();
+}
+
+void Runner::request() {
+	const auto provider = CurrentProvider();
+	const auto model = CurrentModel();
+	const auto tools = ToolSpecs();
+	const auto system = SystemPrompt(_session->user()->name());
+	auto body = QJsonObject();
+	auto path = QString();
+	_anthropic = nullptr;
+	_openai = nullptr;
+	if (UsesAnthropic(provider)) {
+		body = AnthropicBody(
+			model,
+			kMaxTokens,
+			system,
+			_messages,
+			tools,
+			(provider == Provider::Anthropic) && AllowWebSearch(),
+			_dropThinking);
+		path = u"/messages"_q;
+		_anthropic = std::make_unique<AnthropicStream>(model);
+	} else {
+		body = OpenAIBody(model, system, _messages, tools);
+		path = u"/chat/completions"_q;
+		_openai = std::make_unique<OpenAIStream>();
+	}
+	_sse = SseParser();
+	_httpStatus = 0;
+	_errorBody = QByteArray();
+	_streaming = QString();
+	const auto generation = ++_generation;
+	const auto reply = _network->post(
+		MakeRequest(provider, CurrentBaseUrl() + path, _store->key(provider)),
+		QJsonDocument(body).toJson(QJsonDocument::Compact));
+	_reply = reply;
+	QObject::connect(reply, &QNetworkReply::readyRead, this, [=] {
+		if (generation == _generation) {
+			readAvailable();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+		if (generation == _generation) {
+			finished();
+		}
+		reply->deleteLater();
+	});
+}
+
+void Runner::readAvailable() {
+	const auto reply = _reply.data();
+	if (!reply) {
+		return;
+	}
+	if (!_httpStatus) {
+		_httpStatus = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+	}
+	const auto bytes = reply->readAll();
+	if (_httpStatus < 200 || _httpStatus >= 300) {
+		_errorBody.append(bytes.left(kMaxErrorBody - _errorBody.size()));
+		return;
+	}
+	auto changed = false;
+	for (const auto &payload : _sse.feed(bytes)) {
+		const auto events = _anthropic
+			? _anthropic->apply(payload)
+			: _openai->apply(payload);
+		for (const auto &event : events) {
+			changed = true;
+			switch (event.type) {
+			case StreamEvent::Type::TextDelta:
+				_streaming += event.text;
+				_status = QString();
+				break;
+			case StreamEvent::Type::Thinking:
+				_status = Tr(u"Thinking…"_q);
+				break;
+			case StreamEvent::Type::ToolStarted:
+			case StreamEvent::Type::ServerTool:
+				_status = ToolStatus(event.text);
+				break;
+			}
+		}
+	}
+	if (changed) {
+		notify();
+	}
+}
+
+void Runner::finished() {
+	const auto reply = _reply.data();
+	if (!reply) {
+		return;
+	}
+	readAvailable();
+	for (const auto &payload : _sse.finish()) {
+		if (_anthropic) {
+			(void)_anthropic->apply(payload);
+		} else {
+			(void)_openai->apply(payload);
+		}
+	}
+	_reply = nullptr;
+	const auto networkError = (reply->error() != QNetworkReply::NoError)
+		&& (_httpStatus == 0);
+	auto error = networkError
+		? reply->errorString()
+		: (_httpStatus < 200 || _httpStatus >= 300)
+		? ErrorMessage(_httpStatus, _errorBody)
+		: _anthropic
+		? _anthropic->error()
+		: _openai->error();
+	if (!error.isEmpty()) {
+		if (!_dropThinking
+			&& _streaming.isEmpty()
+			&& error.contains(u"thinking"_q, Qt::CaseInsensitive)) {
+			_dropThinking = true;
+			request();
+			return;
+		}
+		finish(error);
+		return;
+	}
+	auto reason = StopReason::EndTurn;
+	auto message = _anthropic
+		? _anthropic->finish(&reason)
+		: _openai->finish(&reason);
+	completed(std::move(message), reason);
+}
+
+void Runner::completed(Message message, StopReason reason) {
+	_streaming = QString();
+	const auto calls = message.toolCalls;
+	if (!message.text.isEmpty()
+		|| !message.toolCalls.empty()
+		|| !message.anthropicBlocks.isEmpty()) {
+		_messages.push_back(std::move(message));
+	}
+	persist();
+	notify();
+	switch (reason) {
+	case StopReason::ToolUse:
+		if (calls.empty()) {
+			finish(QString());
+		} else {
+			runTools(calls, 0);
+		}
+		break;
+	case StopReason::Pause:
+		step();
+		break;
+	case StopReason::MaxTokens:
+		finish(Tr(u"The answer hit the length limit."_q));
+		break;
+	case StopReason::Refusal:
+		finish(Tr(u"The model refused to answer this."_q));
+		break;
+	case StopReason::EndTurn:
+	case StopReason::Other:
+		finish(QString());
+		break;
+	}
+}
+
+void Runner::runTools(std::vector<ToolCall> calls, int index) {
+	if (!_running) {
+		return;
+	} else if (index >= int(calls.size())) {
+		step();
+		return;
+	}
+	const auto call = calls[index];
+	_status = ToolStatus(call.name);
+	notify();
+	const auto generation = _generation;
+	const auto weak = base::make_weak(this);
+	_tools->execute(call, _confirm, [=](ToolOutcome outcome) {
+		const auto strong = weak.get();
+		if (!strong || generation != _generation || !_running) {
+			return;
+		}
+		auto message = MakeMessage(Role::Tool, outcome.content);
+		message.toolCallId = call.id;
+		message.toolTitle = outcome.title;
+		message.isError = outcome.isError;
+		_messages.push_back(std::move(message));
+		persist();
+		notify();
+		runTools(calls, index + 1);
+	});
+}
+
+void Runner::finish(const QString &error) {
+	if (!_streaming.isEmpty()) {
+		_messages.push_back(MakeMessage(Role::Assistant, _streaming));
+	}
+	_streaming = QString();
+	_running = false;
+	_status = QString();
+	_lastError = error;
+	RepairDanglingToolCalls(_messages, Cancelled());
+	persist();
+	notify();
+}
+
+void Runner::persist() {
+	_store->setMessages(_messages);
+	if (_store->messages().size() != _messages.size()) {
+		_messages = _store->messages();
+	}
+}
+
+void Runner::notify() {
+	_updates.fire({});
+}
+
+} // namespace Tele::Agent
