+void ShowAgent(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	auto &panels = Panels();
+	if (const auto i = panels.find(session); i != end(panels)) {
+		const auto panel = i->second.panel.get();
+		const auto state = panel->windowState();
+		if (state & Qt::WindowMinimized) {
+			panel->setWindowState(state & ~Qt::WindowMinimized);
+		}
+		panel->showAndActivate();
+		return;
+	}
+	auto owned = std::make_unique<Ui::SeparatePanel>();
+	const auto panel = owned.get();
+	panel->setWindowFlag(Qt::WindowStaysOnTopHint, false);
+	panel->setInnerSize(
+		QSize(style::ConvertScale(420), style::ConvertScale(560)),
+		true);
+	panel->setTitle(rpl::single(Tr(u"AI agent"_q)));
+	panels.emplace(session, Opened{ .panel = std::move(owned) });
+	session->lifetime().add([=] {
+		Panels().remove(session);
+	});
+	SetupConfirm(session);
+	panel->closeRequests(
+	) | rpl::on_next([=] {
+		panel->hideGetDuration();
+	}, panel->lifetime());
+	panel->closeEvents(
+	) | rpl::on_next([=] {
+		crl::on_main([=] {
+			const auto i = Panels().find(session);
+			if (i == end(Panels())) {
+				return;
+			}
+			if (const auto pending = i->second.pending) {
+				if (const auto callback = base::take(*pending)) {
+					callback(false);
+				}
+			}
+			Runner::For(session).setConfirm(nullptr);
+			Panels().remove(session);
+		});
+	}, panel->lifetime());
+	panel->setMenuAllowed([=](const Ui::Menu::MenuCallback &add) {
+		add(Tr(u"Clear the conversation"_q), [=] {
+			Runner::For(session).clear();
+		}, &st::menuIconClear);
+		add(Tr(u"Agent settings"_q), [=] {
+			Core::App().openLocalUrl(
+				LocalMadLink(u"mad://settings/agent"_q),
+				QVariant());
+		}, &st::menuIconSettings);
+	});
+	panel->showInner(MakeChat(panel, session));
+	panel->showAndActivate();
+}
+
+void AddAgentMenuEntry(
+		not_null<Ui::VerticalLayout*> menu,
+		not_null<Window::SessionController*> controller) {
+	auto &option = base::options::lookup<bool>(kOptionAgentMenu);
+	const auto wrap = menu->add(object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+		menu,
+		object_ptr<Ui::VerticalLayout>(menu)));
+	const auto button = Settings::AddButtonWithIcon(
+		wrap->entity(),
+		rpl::single(Tr(u"AI agent"_q)),
+		st::mainMenuButton,
+		{ &st::menuIconBotCommands });
+	button->setClickedCallback([=] {
+		ShowAgent(controller);
+	});
+	wrap->toggleOn(rpl::single(
+		rpl::empty
+	) | rpl::then(
+		option.changes()
+	) | rpl::map([&option] {
+		return option.value();
+	}));
+	wrap->finishAnimating();
+}
+
+void ShowKeyBox(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto provider = CurrentProvider();
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Tr(u"API key"_q)));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Tr(u"The key is kept encrypted with this account's data on "
+				"this computer and is not exported with the settings."_q),
+			st::boxLabel));
+		auto container = object_ptr<Ui::RpWidget>(box);
+		const auto raw = container.data();
+		const auto field = Ui::CreateChild<Ui::PasswordInput>(
+			raw,
+			st::defaultInputField,
+			rpl::single(Tr(u"Key"_q)));
+		raw->resize(raw->width(), field->height());
+		raw->widthValue() | rpl::on_next([=](int width) {
+			field->resize(width, field->height());
+			field->moveToLeft(0, 0);
+		}, raw->lifetime());
+		box->addRow(std::move(container));
+		const auto save = [=] {
+			Runner::For(session).setKey(provider, field->getLastText());
+			box->closeBox();
+		};
+		QObject::connect(field, &Ui::MaskedInputField::submitted, save);
+		box->setFocusCallback([=] { field->setFocusFast(); });
+		box->addButton(rpl::single(Tr(u"Save"_q)), save);
+		box->addButton(rpl::single(Tr(u"Cancel"_q)), [=] {
+			box->closeBox();
+		});
+		if (!Runner::For(session).key(provider).isEmpty()) {
+			box->addLeftButton(rpl::single(Tr(u"Remove"_q)), [=] {
+				Runner::For(session).setKey(provider, QString());
+				box->closeBox();
+			});
+		}
+	}));
+}
+
+void ShowTextBox(
+		not_null<Window::SessionController*> controller,
+		const char id[],
+		const QString &title,
+		bool multiline) {
+	auto &option = base::options::lookup<QString>(id);
+	controller->show(Box([=, &option](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(title));
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			(multiline
+				? Ui::InputField::Mode::MultiLine
+				: Ui::InputField::Mode::SingleLine),
+			rpl::single(title),
+			option.value()));
+		const auto save = [=, &option] {
+			option.set(field->getLastText().trimmed());
+			box->closeBox();
+		};
+		if (!multiline) {
+			field->submits() | rpl::on_next(save, field->lifetime());
+		}
+		box->setFocusCallback([=] { field->setFocusFast(); });
+		box->addButton(rpl::single(Tr(u"Save"_q)), save);
+		box->addButton(rpl::single(Tr(u"Cancel"_q)), [=] {
+			box->closeBox();
+		});
+		box->addLeftButton(rpl::single(Tr(u"Reset"_q)), [=, &option] {
+			option.set(QString());
+			box->closeBox();
+		});
+	}));
+}
+
+void CheckKey(not_null<Window::SessionController*> controller) {
+	const auto weak = base::make_weak(controller);
+	Runner::For(&controller->session()).checkKey([=](QString error) {
+		if (const auto strong = weak.get()) {
+			strong->showToast(error.isEmpty()
+				? Tr(u"The key works."_q)
+				: error);
+		}
+	});
+}
+
+rpl::producer<QString> KeyStatusValue(
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(rpl::merge(
+		Runner::For(session).updates(),
+		base::options::lookup<QString>(kOptionAgentProvider).changes()
+	)) | rpl::map([=] {
+		return Runner::For(session).key(CurrentProvider()).isEmpty()
+			? Tr(u"not set"_q)
+			: Tr(u"saved"_q);
+	});
+}
