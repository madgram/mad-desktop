+#include <QtCore/QDateTime>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonValue>
+#include <QtCore/QSet>
+#include <QtCore/QUrl>
+#include <QtCore/QUuid>
+
+#include <utility>
+
+using namespace Qt::StringLiterals;
+
+namespace Tele::Agent {
+namespace {
+
+[[nodiscard]] QString NewId() {
+	return QUuid::createUuid().toString(QUuid::WithoutBraces);
+}
+
+[[nodiscard]] QJsonObject ParseObject(const QByteArray &data) {
+	const auto document = QJsonDocument::fromJson(data);
+	return document.isObject() ? document.object() : QJsonObject();
+}
+
+[[nodiscard]] QString Compact(const QJsonObject &object) {
+	return QString::fromUtf8(
+		QJsonDocument(object).toJson(QJsonDocument::Compact));
+}
+
+[[nodiscard]] QJsonObject AnthropicImage(const Image &image) {
+	return QJsonObject{
+		{ u"type"_s, u"image"_s },
+		{ u"source"_s, QJsonObject{
+			{ u"type"_s, u"base64"_s },
+			{ u"media_type"_s, image.mediaType },
+			{ u"data"_s, image.base64 },
+		} },
+	};
+}
+
+[[nodiscard]] QJsonObject OpenAIImage(const Image &image) {
+	return QJsonObject{
+		{ u"type"_s, u"image_url"_s },
+		{ u"image_url"_s, QJsonObject{
+			{ u"url"_s, u"data:"_s + image.mediaType + u";base64,"_s
+				+ image.base64 },
+		} },
+	};
+}
+
+[[nodiscard]] QString RoleId(Role role) {
+	switch (role) {
+	case Role::User: return u"user"_s;
+	case Role::Assistant: return u"assistant"_s;
+	case Role::Tool: return u"tool"_s;
+	}
+	return u"user"_s;
+}
+
+[[nodiscard]] Role RoleFromId(const QString &id) {
+	return (id == u"assistant"_s)
+		? Role::Assistant
+		: (id == u"tool"_s)
+		? Role::Tool
+		: Role::User;
+}
+
+} // namespace
+
+Provider ProviderFromId(const QString &id) {
+	return (id == u"openai"_s)
+		? Provider::OpenAI
+		: (id == u"anthropic-compatible"_s)
+		? Provider::AnthropicCompatible
+		: (id == u"openai-compatible"_s)
+		? Provider::OpenAICompatible
+		: Provider::Anthropic;
+}
+
+QString ProviderId(Provider provider) {
+	switch (provider) {
+	case Provider::Anthropic: return u"anthropic"_s;
+	case Provider::OpenAI: return u"openai"_s;
+	case Provider::AnthropicCompatible: return u"anthropic-compatible"_s;
+	case Provider::OpenAICompatible: return u"openai-compatible"_s;
+	}
+	return u"anthropic"_s;
+}
+
+bool UsesAnthropic(Provider provider) {
+	return (provider == Provider::Anthropic)
+		|| (provider == Provider::AnthropicCompatible);
+}
+
+bool IsCustom(Provider provider) {
+	return (provider == Provider::AnthropicCompatible)
+		|| (provider == Provider::OpenAICompatible);
+}
+
+QString OfficialBaseUrl(Provider provider) {
+	switch (provider) {
+	case Provider::Anthropic: return u"https://api.anthropic.com/v1"_s;
+	case Provider::OpenAI: return u"https://api.openai.com/v1"_s;
+	default: return QString();
+	}
+}
+
+QString DefaultModel(Provider provider) {
+	return UsesAnthropic(provider) ? u"claude-sonnet-5-5"_s : QString();
+}
+
+QString AnthropicVersion(Provider provider) {
+	return (provider == Provider::Anthropic)
+		? u"2026-10-21"_s
+		: u"2023-06-01"_s;
+}
+
+QJsonObject ToolCall::argumentsObject() const {
+	return ParseObject(arguments.toUtf8());
+}
+
+QString Message::requestText() const {
+	return contextPrefix.isEmpty()
+		? text
+		: (contextPrefix + u"\n\n"_s + text);
+}
+
+Message MakeMessage(Role role, const QString &text) {
+	auto result = Message();
+	result.id = NewId();
+	result.role = role;
+	result.text = text;
+	result.date = QDateTime::currentSecsSinceEpoch();
+	return result;
+}
+
+QString NormalizedBaseUrl(const QString &value) {
+	auto trimmed = value.trimmed();
+	if (trimmed.isEmpty()) {
+		return QString();
+	}
+	const auto lower = trimmed.toLower();
+	if (!lower.startsWith(u"http://"_s) && !lower.startsWith(u"https://"_s)) {
+		trimmed = u"https://"_s + trimmed;
+	}
+	while (trimmed.endsWith('/')) {
+		trimmed.chop(1);
+	}
+	const auto url = QUrl(trimmed, QUrl::StrictMode);
+	if (!url.isValid() || url.host().isEmpty()) {
+		return QString();
+	}
+	if (url.path().isEmpty()) {
+		trimmed += u"/v1"_s;
+	}
+	return trimmed;
+}
+
+QString ErrorMessage(int status, const QByteArray &body) {
+	const auto object = ParseObject(body);
+	const auto prefix = u"HTTP %1: "_s.arg(status);
+	const auto error = object.value(u"error"_s);
+	if (error.isObject()) {
+		const auto message = error.toObject().value(u"message"_s).toString();
+		if (!message.isEmpty()) {
+			return prefix + message;
+		}
+	} else if (error.isString() && !error.toString().isEmpty()) {
+		return prefix + error.toString();
+	}
+	const auto message = object.value(u"message"_s).toString();
+	if (!message.isEmpty()) {
+		return prefix + message;
+	}
+	switch (status) {
+	case 0: return u"No connection to the API."_s;
+	case 401:
+	case 403: return prefix + u"the key doesn't fit."_s;
+	case 404: return prefix + u"the address or the model is not found."_s;
+	case 429: return prefix + u"too many requests or the limit is over."_s;
+	}
+	const auto text = QString::fromUtf8(body.left(400)).trimmed();
+	return text.isEmpty() ? u"HTTP %1"_s.arg(status) : (prefix + text);
+}
+
+std::vector<QByteArray> SseParser::feed(const QByteArray &chunk) {
+	auto result = std::vector<QByteArray>();
+	_buffer.append(chunk);
+	while (true) {
+		const auto index = _buffer.indexOf('\n');
+		if (index < 0) {
+			break;
+		}
+		auto line = _buffer.left(index);
+		_buffer.remove(0, index + 1);
+		take(std::move(line), result);
+	}
+	return result;
+}
+
+std::vector<QByteArray> SseParser::finish() {
+	auto result = std::vector<QByteArray>();
+	if (!_buffer.isEmpty()) {
+		take(std::exchange(_buffer, QByteArray()), result);
+	}
+	return result;
+}
+
+void SseParser::take(QByteArray line, std::vector<QByteArray> &result) {
+	if (line.endsWith('\r')) {
+		line.chop(1);
+	}
+	if (!line.startsWith("data:")) {
+		return;
+	}
+	line.remove(0, 5);
+	if (line.startsWith(' ')) {
+		line.remove(0, 1);
+	}
+	result.push_back(std::move(line));
+}
+
+QJsonObject AnthropicBody(
+		const QString &model,
+		int maxTokens,
+		const QString &system,
+		const std::vector<Message> &messages,
+		const std::vector<ToolSpec> &tools,
+		bool webTools,
+		bool dropThinking) {
+	auto list = QJsonArray();
+	const auto append = [&](const QString &role, const QJsonArray &content) {
+		if (content.isEmpty()) {
+			return;
+		}
+		if (!list.isEmpty()) {
+			auto last = list.last().toObject();
+			if (last.value(u"role"_s).toString() == role) {
+				auto merged = last.value(u"content"_s).toArray();
+				for (const auto &entry : content) {
+					merged.append(entry);
+				}
+				last.insert(u"content"_s, merged);
+				list.replace(list.size() - 1, last);
+				return;
+			}
+		}
+		list.append(QJsonObject{
+			{ u"role"_s, role },
+			{ u"content"_s, content },
+		});
+	};
+	for (const auto &message : messages) {
+		switch (message.role) {
+		case Role::User: {
+			auto content = QJsonArray();
+			for (const auto &image : message.images) {
+				content.append(AnthropicImage(image));
+			}
+			if (!message.text.isEmpty()) {
+				content.append(QJsonObject{
+					{ u"type"_s, u"text"_s },
+					{ u"text"_s, message.requestText() },
+				});
+			}
+			append(u"user"_s, content);
+		} break;
+		case Role::Assistant: {
+			const auto stored = QJsonDocument::fromJson(
+				message.anthropicBlocks);
+			if (!dropThinking
+				&& message.anthropicModel == model
+				&& stored.isArray()
+				&& !stored.array().isEmpty()) {
+				append(u"assistant"_s, stored.array());
+			} else {
+				auto content = QJsonArray();
+				if (!message.text.isEmpty()) {
+					content.append(QJsonObject{
+						{ u"type"_s, u"text"_s },
+						{ u"text"_s, message.text },
+					});
+				}
+				for (const auto &call : message.toolCalls) {
+					content.append(QJsonObject{
+						{ u"type"_s, u"tool_use"_s },
+						{ u"id"_s, call.id },
+						{ u"name"_s, call.name },
+						{ u"input"_s, call.argumentsObject() },
+					});
+				}
+				append(u"assistant"_s, content);
+			}
+		} break;
+		case Role::Tool: {
+			if (message.toolCallId.isEmpty()) {
+				break;
+			}
+			auto block = QJsonObject{
+				{ u"type"_s, u"tool_result"_s },
+				{ u"tool_use_id"_s, message.toolCallId },
+				{ u"content"_s, message.text.isEmpty()
+					? u"(empty)"_s
+					: message.text },
+			};
+			if (!message.images.empty()) {
+				auto parts = QJsonArray{ QJsonObject{
+					{ u"type"_s, u"text"_s },
+					{ u"text"_s, message.text.isEmpty()
+						? u"(image)"_s
+						: message.text },
+				} };
+				for (const auto &image : message.images) {
+					parts.append(AnthropicImage(image));
+				}
+				block.insert(u"content"_s, parts);
+			}
+			if (message.isError) {
+				block.insert(u"is_error"_s, true);
+			}
+			append(u"user"_s, QJsonArray{ block });
+		} break;
+		}
+	}
+	while (!list.isEmpty()
+		&& list.first().toObject().value(u"role"_s).toString() != u"user"_s) {
+		list.removeFirst();
+	}
+	auto body = QJsonObject{
+		{ u"model"_s, model },
+		{ u"max_tokens"_s, maxTokens },
+		{ u"stream"_s, true },
+		{ u"messages"_s, list },
+	};
+	if (!system.isEmpty()) {
+		body.insert(u"system"_s, system);
+	}
+	auto toolList = QJsonArray();
+	for (const auto &tool : tools) {
+		toolList.append(QJsonObject{
+			{ u"name"_s, tool.name },
+			{ u"description"_s, tool.description },
+			{ u"input_schema"_s, tool.schema },
+		});
+	}
+	if (webTools) {
+		toolList.append(QJsonObject{
+			{ u"type"_s, u"web_search_20260209"_s },
+			{ u"name"_s, u"web_search"_s },
+		});
+		toolList.append(QJsonObject{
+			{ u"type"_s, u"web_fetch_20260209"_s },
+			{ u"name"_s, u"web_fetch"_s },
+		});
+	}
+	if (!toolList.isEmpty()) {
+		body.insert(u"tools"_s, toolList);
+	}
+	return body;
+}
+
+QJsonObject OpenAIBody(
+		const QString &model,
+		const QString &system,
+		const std::vector<Message> &messages,
+		const std::vector<ToolSpec> &tools) {
+	auto list = QJsonArray();
+	if (!system.isEmpty()) {
+		list.append(QJsonObject{
+			{ u"role"_s, u"system"_s },
+			{ u"content"_s, system },
+		});
+	}
+	auto pending = std::vector<Image>();
+	const auto flush = [&] {
+		if (pending.empty()) {
+			return;
+		}
+		auto parts = QJsonArray{ QJsonObject{
+			{ u"type"_s, u"text"_s },
+			{ u"text"_s, u"Images from the tool results above:"_s },
+		} };
+		for (const auto &image : pending) {
+			parts.append(OpenAIImage(image));
+		}
+		list.append(QJsonObject{
+			{ u"role"_s, u"user"_s },
+			{ u"content"_s, parts },
+		});
+		pending.clear();
+	};
+	for (const auto &message : messages) {
+		if (message.role != Role::Tool) {
+			flush();
+		}
+		switch (message.role) {
+		case Role::User:
+			if (!message.images.empty()) {
+				auto parts = QJsonArray();
+				for (const auto &image : message.images) {
+					parts.append(OpenAIImage(image));
+				}
+				parts.append(QJsonObject{
+					{ u"type"_s, u"text"_s },
+					{ u"text"_s, message.requestText().isEmpty()
+						? u"(image)"_s
+						: message.requestText() },
+				});
+				list.append(QJsonObject{
+					{ u"role"_s, u"user"_s },
+					{ u"content"_s, parts },
+				});
+			} else if (!message.text.isEmpty()) {
+				list.append(QJsonObject{
+					{ u"role"_s, u"user"_s },
+					{ u"content"_s, message.requestText() },
+				});
+			}
+			break;
+		case Role::Assistant: {
+			if (message.text.isEmpty() && message.toolCalls.empty()) {
+				break;
+			}
+			auto item = QJsonObject{
+				{ u"role"_s, u"assistant"_s },
+				{ u"content"_s, message.text.isEmpty()
+					? QJsonValue(QJsonValue::Null)
+					: QJsonValue(message.text) },
+			};
+			if (!message.toolCalls.empty()) {
+				auto calls = QJsonArray();
+				for (const auto &call : message.toolCalls) {
+					calls.append(QJsonObject{
+						{ u"id"_s, call.id },
+						{ u"type"_s, u"function"_s },
+						{ u"function"_s, QJsonObject{
+							{ u"name"_s, call.name },
+							{ u"arguments"_s, call.arguments },
+						} },
+					});
+				}
+				item.insert(u"tool_calls"_s, calls);
+			}
+			list.append(item);
+		} break;
+		case Role::Tool:
+			if (message.toolCallId.isEmpty()) {
+				break;
+			}
+			list.append(QJsonObject{
+				{ u"role"_s, u"tool"_s },
+				{ u"tool_call_id"_s, message.toolCallId },
+				{ u"content"_s, message.text.isEmpty()
+					? u"(empty)"_s
+					: message.text },
+			});
+			pending.insert(
+				end(pending),
+				begin(message.images),
+				end(message.images));
+			break;
+		}
+	}
+	flush();
+	auto body = QJsonObject{
+		{ u"model"_s, model },
+		{ u"stream"_s, true },
+		{ u"messages"_s, list },
+	};
+	if (!tools.empty()) {
+		auto toolList = QJsonArray();
+		for (const auto &tool : tools) {
+			toolList.append(QJsonObject{
+				{ u"type"_s, u"function"_s },
+				{ u"function"_s, QJsonObject{
+					{ u"name"_s, tool.name },
+					{ u"description"_s, tool.description },
+					{ u"parameters"_s, tool.schema },
+				} },
+			});
+		}
+		body.insert(u"tools"_s, toolList);
+	}
+	return body;
+}
