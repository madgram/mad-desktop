+[[nodiscard]] TextWithEntities Markdown(const QString &text) {
+	constexpr auto kMaxCached = 512;
+	static auto cache = base::flat_map<QString, TextWithEntities>();
+	if (const auto i = cache.find(text); i != end(cache)) {
+		return i->second;
+	}
+	auto result = MarkdownToEntities(text);
+	const auto links = TextUtilities::ParseEntities(
+		result.text,
+		TextParseLinks).entities;
+	for (const auto &link : links) {
+		const auto from = link.offset();
+		const auto till = from + link.length();
+		const auto blocked = ranges::any_of(result.entities, [&](
+				const EntityInText &entity) {
+			const auto type = entity.type();
+			return (entity.offset() < till)
+				&& (entity.offset() + entity.length() > from)
+				&& (type == EntityType::CustomUrl
+					|| type == EntityType::Code
+					|| type == EntityType::Pre);
+		});
+		if (!blocked) {
+			result.entities.push_back(link);
+		}
+	}
+	ranges::stable_sort(
+		result.entities,
+		ranges::less(),
+		&EntityInText::offset);
+	if (int(cache.size()) >= kMaxCached) {
+		cache.clear();
+	}
+	cache.emplace(text, result);
+	return result;
+}
