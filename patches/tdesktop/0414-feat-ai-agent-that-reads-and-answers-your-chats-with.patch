+}
+
+Message AnthropicStream::finish(StopReason *reason) const {
+	auto blocks = QJsonArray();
+	auto text = QString();
+	auto calls = std::vector<ToolCall>();
+	for (const auto &[index, block] : _blocks) {
+		const auto kind = block.value(u"type"_s).toString();
+		if (kind == u"text"_s) {
+			const auto value = block.value(u"text"_s).toString();
+			if (value.isEmpty()) {
+				continue;
+			}
+			text += value;
+			blocks.append(QJsonObject{
+				{ u"type"_s, u"text"_s },
+				{ u"text"_s, value },
+			});
+		} else if (kind == u"tool_use"_s) {
+			const auto input = block.value(u"input"_s).toObject();
+			auto id = block.value(u"id"_s).toString();
+			if (id.isEmpty()) {
+				id = NewId();
+			}
+			const auto name = block.value(u"name"_s).toString();
+			calls.push_back({ id, name, Compact(input) });
+			blocks.append(QJsonObject{
+				{ u"type"_s, u"tool_use"_s },
+				{ u"id"_s, id },
+				{ u"name"_s, name },
+				{ u"input"_s, input },
+			});
+		} else {
+			blocks.append(block);
+		}
+	}
+	auto message = MakeMessage(Role::Assistant, text);
+	message.toolCalls = std::move(calls);
+	message.anthropicBlocks = QJsonDocument(blocks).toJson(
+		QJsonDocument::Compact);
+	message.anthropicModel = _model;
+	if (reason) {
+		if (_stopReason.isEmpty()
+			|| _stopReason == u"end_turn"_s
+			|| _stopReason == u"stop_sequence"_s) {
+			*reason = message.toolCalls.empty()
+				? StopReason::EndTurn
+				: StopReason::ToolUse;
+		} else if (_stopReason == u"tool_use"_s) {
+			*reason = StopReason::ToolUse;
+		} else if (_stopReason == u"max_tokens"_s
+			|| _stopReason == u"model_context_window_exceeded"_s) {
+			*reason = StopReason::MaxTokens;
+		} else if (_stopReason == u"refusal"_s) {
+			*reason = StopReason::Refusal;
+		} else if (_stopReason == u"pause_turn"_s) {
+			*reason = StopReason::Pause;
+		} else {
+			*reason = StopReason::Other;
+		}
+	}
+	return message;
+}
+
+std::vector<StreamEvent> OpenAIStream::apply(const QByteArray &payload) {
+	auto result = std::vector<StreamEvent>();
+	if (payload.trimmed() == "[DONE]") {
+		_done = true;
+		return result;
+	}
+	const auto event = ParseObject(payload);
+	const auto error = event.value(u"error"_s);
+	if (error.isObject()) {
+		_error = error.toObject().value(u"message"_s).toString();
+		if (_error.isEmpty()) {
+			_error = u"API error."_s;
+		}
+		return result;
+	}
+	const auto choices = event.value(u"choices"_s).toArray();
+	if (choices.isEmpty()) {
+		return result;
+	}
+	const auto choice = choices.first().toObject();
+	const auto finish = choice.value(u"finish_reason"_s).toString();
+	if (!finish.isEmpty()) {
+		_finishReason = finish;
+	}
+	const auto delta = choice.value(u"delta"_s).toObject();
+	if (delta.isEmpty()) {
+		return result;
+	}
+	auto reasoning = delta.value(u"reasoning_content"_s).toString();
+	if (reasoning.isEmpty()) {
+		reasoning = delta.value(u"reasoning"_s).toString();
+	}
+	if (!_reportedThinking && !reasoning.isEmpty()) {
+		_reportedThinking = true;
+		result.push_back({ StreamEvent::Type::Thinking });
+	}
+	const auto content = delta.value(u"content"_s).toString();
+	if (!content.isEmpty()) {
+		_text += content;
+		result.push_back({ StreamEvent::Type::TextDelta, content });
+	}
+	for (const auto &entry : delta.value(u"tool_calls"_s).toArray()) {
+		const auto call = entry.toObject();
+		const auto index = call.value(u"index"_s).toInt(int(_calls.size()));
+		auto &current = _calls[index];
+		const auto id = call.value(u"id"_s).toString();
+		if (!id.isEmpty()) {
+			current.id = id;
+		}
+		const auto function = call.value(u"function"_s).toObject();
+		const auto name = function.value(u"name"_s).toString();
+		if (!name.isEmpty()) {
+			if (current.name.isEmpty()) {
+				result.push_back({ StreamEvent::Type::ToolStarted, name });
+			}
+			current.name += name;
+		}
+		current.arguments += function.value(u"arguments"_s).toString();
+	}
+	return result;
+}
