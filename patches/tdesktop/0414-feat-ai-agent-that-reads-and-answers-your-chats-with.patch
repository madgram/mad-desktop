+[[nodiscard]] QJsonObject Property(
+		const QString &type,
+		const QString &description = QString()) {
+	auto result = QJsonObject{ { u"type"_q, type } };
+	if (!description.isEmpty()) {
+		result.insert(u"description"_q, description);
+	}
+	return result;
+}
+
+[[nodiscard]] QJsonObject Schema(
+		QJsonObject properties,
+		QStringList required = {}) {
+	auto result = QJsonObject{
+		{ u"type"_q, u"object"_q },
+		{ u"properties"_q, properties },
+		{ u"additionalProperties"_q, false },
+	};
+	if (!required.isEmpty()) {
+		result.insert(u"required"_q, QJsonArray::fromStringList(required));
+	}
+	return result;
+}
+
+[[nodiscard]] QString ChatId(not_null<PeerData*> peer) {
+	return QString::number(peer->id.value);
+}
+
+[[nodiscard]] PeerData *PeerFromArgs(
+		not_null<Main::Session*> session,
+		const QJsonObject &args,
+		const QString &key = u"chat_id"_q) {
+	const auto value = args.value(key);
+	const auto text = value.isString()
+		? value.toString().trimmed()
+		: QString::number(qint64(value.toDouble()));
+	auto ok = false;
+	const auto bare = text.toULongLong(&ok);
+	if (!ok || !bare) {
+		return nullptr;
+	}
+	return session->data().peerLoaded(PeerId(PeerIdHelper(bare)));
+}
+
+[[nodiscard]] QString Title(not_null<PeerData*> peer) {
+	return peer->isSelf() ? Tr(u"Saved Messages"_q) : peer->name();
+}
+
+[[nodiscard]] QString Type(not_null<PeerData*> peer) {
+	if (peer->isSelf()) {
+		return u"saved"_q;
+	} else if (const auto user = peer->asUser()) {
+		return user->isBot() ? u"bot"_q : u"private"_q;
+	} else if (peer->isBroadcast()) {
+		return u"channel"_q;
+	}
+	return u"group"_q;
+}
+
+[[nodiscard]] QString DateText(TimeId date) {
+	return base::unixtime::parse(date).toString(u"yyyy-MM-dd HH:mm"_q);
+}
+
+[[nodiscard]] QString ItemText(not_null<HistoryItem*> item) {
+	auto text = item->notificationText().text.trimmed();
+	if (text.size() > kMaxItemText) {
+		text = text.left(kMaxItemText) + QChar(0x2026);
+	}
+	return text.isEmpty() ? u"[media]"_q : text;
+}
+
+[[nodiscard]] QString ItemLine(not_null<HistoryItem*> item) {
+	const auto from = item->from();
+	const auto author = item->out()
+		? u"me"_q
+		: from->isSelf()
+		? u"me"_q
+		: from->name();
+	return u"#%1 [%2] %3: %4"_q.arg(
+		QString::number(item->id.bare),
+		DateText(item->date()),
+		author,
+		ItemText(item));
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> Items(
+		not_null<Main::Session*> session,
+		const MTPmessages_Messages &result) {
+	auto items = std::vector<not_null<HistoryItem*>>();
+	auto &owner = session->data();
+	result.match([](const MTPDmessages_messagesNotModified &) {
+	}, [&](const auto &data) {
+		owner.processUsers(data.vusers());
+		owner.processChats(data.vchats());
+		for (const auto &message : data.vmessages().v) {
+			if (!owner.peerLoaded(PeerFromMessage(message))
+				|| !DateFromMessage(message)) {
+				continue;
+			}
+			if (const auto item = owner.addNewMessage(
+					message,
+					MessageFlags(),
+					NewMessageType::Existing)) {
+				items.push_back(item);
+			}
+		}
+	});
+	return items;
+}
+
+[[nodiscard]] TimeId ParseWhen(const QJsonObject &args, const QString &key) {
+	const auto minutes = args.value(u"in_minutes"_q).toInt();
+	if (minutes > 0) {
+		return base::unixtime::now() + minutes * 60;
+	}
+	const auto text = args.value(key).toString().trimmed();
+	if (text.isEmpty()) {
+		return 0;
+	}
+	const auto parsed = QDateTime::fromString(text, u"yyyy-MM-dd HH:mm"_q);
+	return parsed.isValid() ? TimeId(parsed.toSecsSinceEpoch()) : 0;
+}
+
+[[nodiscard]] TextWithTags MessageText(const QString &text) {
+	return MarkdownToTags(text);
+}
+
+[[nodiscard]] ToolOutcome Error(const QString &text) {
+	return { .content = text, .isError = true };
+}
