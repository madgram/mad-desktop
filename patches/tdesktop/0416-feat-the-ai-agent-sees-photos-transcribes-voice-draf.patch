+void Tools::forwardMessages(
+		const QJsonObject &args,
+		Fn<void(ToolOutcome)> done) {
+	const auto from = PeerFromArgs(_session, args, u"from_chat_id"_q);
+	const auto to = PeerFromArgs(_session, args, u"to_chat_id"_q);
+	auto ids = std::vector<MsgId>();
+	for (const auto &value : args.value(u"message_ids"_q).toArray()) {
+		const auto id = MsgId(qint64(value.toDouble()));
+		if (value.isDouble() && (id > 0) && !ranges::contains(ids, id)) {
+			ids.push_back(id);
+		}
+		if (int(ids.size()) >= kMaxForward) {
+			break;
+		}
+	}
+	if (!from || !to) {
+		done(Error(u"from_chat_id and to_chat_id are required."_q));
+		return;
+	} else if (ids.empty()) {
+		done(Error(u"No message_ids."_q));
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	const auto session = _session;
+	const auto finish = [=] {
+		if (!weak) {
+			return;
+		}
+		auto items = HistoryItemsList();
+		for (const auto &id : ids) {
+			const auto item = session->data().message(from->id, id);
+			if (item && item->allowsForward()) {
+				items.push_back(item);
+			}
+		}
+		if (items.empty()) {
+			done(Error(u"These messages were not found or can't be "
+				"forwarded."_q));
+			return;
+		}
+		ranges::sort(items, [](auto a, auto b) {
+			return a->id < b->id;
+		});
+		const auto count = int(items.size());
+		const auto title = Title(to);
+		session->api().forwardMessages(
+			Data::ResolvedForwardDraft{ .items = std::move(items) },
+			Api::SendAction(session->data().history(to)));
+		done({
+			.content = u"Forwarded %1 to \"%2\"."_q.arg(
+				QString::number(count),
+				title),
+			.title = Tr(u"Forwarded to %1"_q).arg(title),
+		});
+	};
+	auto missing = std::vector<MsgId>();
+	for (const auto &id : ids) {
+		if (!session->data().message(from->id, id)) {
+			missing.push_back(id);
+		}
+	}
+	if (missing.empty()) {
+		finish();
+		return;
+	}
+	const auto left = std::make_shared<int>(int(missing.size()));
+	for (const auto &id : missing) {
+		session->api().requestMessageData(from, id, [=] {
+			if (!--*left) {
+				finish();
+			}
+		});
+	}
+}
