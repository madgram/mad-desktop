+[[nodiscard]] QString MediaTag(not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	if (!media || media->webpage()) {
+		return QString();
+	} else if (media->photo()) {
+		return u"[photo]"_q;
+	}
+	const auto document = media->document();
+	if (!document) {
+		return QString();
+	} else if (document->isVoiceMessage()) {
+		return u"[voice message]"_q;
+	} else if (document->isVideoMessage()) {
+		return u"[round video message]"_q;
+	} else if (const auto sticker = document->sticker()) {
+		return sticker->alt.isEmpty()
+			? u"[sticker]"_q
+			: (u"[sticker "_q + sticker->alt + u"]"_q);
+	} else if (document->isAnimation()) {
+		return u"[GIF]"_q;
+	} else if (document->isVideoFile()) {
+		return u"[video]"_q;
+	}
+	const auto kind = document->isAudioFile() ? u"audio"_q : u"file"_q;
+	const auto name = document->filename();
+	return name.isEmpty()
+		? (u"["_q + kind + u"]"_q)
+		: (u"["_q + kind + u" "_q + name + u"]"_q);
+}
