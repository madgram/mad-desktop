+void Tools::viewPhoto(const QJsonObject &args, Fn<void(ToolOutcome)> done) {
+	const auto peer = PeerFromArgs(_session, args);
+	const auto id = MessageIdFromArgs(args);
+	if (!peer || !id) {
+		done(Error(u"chat_id and message_id are required."_q));
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	WithItem(_session, peer, id, [=](HistoryItem *item) {
+		if (!weak) {
+			return;
+		} else if (!item) {
+			done(Error(u"Message not found."_q));
+			return;
+		}
+		const auto media = item->media();
+		const auto photo = (media && !media->webpage())
+			? media->photo()
+			: nullptr;
+		if (!photo) {
+			done(Error(u"This message has no photo."_q));
+			return;
+		}
+		auto content = u"Photo from message #%1."_q.arg(id.bare);
+		const auto caption = item->originalText().text.trimmed();
+		if (!caption.isEmpty()) {
+			content += u" Caption: "_q + caption;
+		}
+		const auto wait = _lifetime.make_state<PhotoWait>();
+		wait->view = photo->createMediaView();
+		wait->view->wanted(Data::PhotoSize::Large, item->fullId());
+		const auto check = [=](bool timeout) {
+			const auto large = wait->view
+				? wait->view->image(Data::PhotoSize::Large)
+				: nullptr;
+			if (!large && !timeout) {
+				return;
+			}
+			auto encoded = large ? EncodePhoto(large->original()) : Image();
+			wait->view = nullptr;
+			wait->lifetime.destroy();
+			if (encoded.base64.isEmpty()) {
+				done(Error(u"The photo did not load."_q));
+				return;
+			}
+			auto outcome = ToolOutcome{
+				.content = content,
+				.title = Tr(u"Looked at the photo"_q),
+			};
+			outcome.images.push_back(std::move(encoded));
+			done(std::move(outcome));
+		};
+		if (wait->view->image(Data::PhotoSize::Large)) {
+			check(false);
+			return;
+		}
+		rpl::merge(
+			_session->downloaderTaskFinished() | rpl::map_to(false),
+			base::timer_once(kPhotoTimeout) | rpl::map_to(true)
+		) | rpl::on_next(check, wait->lifetime);
+	});
+}
