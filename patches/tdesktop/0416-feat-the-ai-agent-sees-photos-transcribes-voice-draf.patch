+void Tools::webSearch(const QJsonObject &args, Fn<void(ToolOutcome)> done) {
+	const auto query = args.value(u"query"_q).toString().trimmed();
+	if (query.isEmpty()) {
+		done(Error(u"Empty query."_q));
+		return;
+	}
+	const auto title = Tr(u"Searched the web for \"%1\""_q).arg(query);
+	const auto url = QUrl(u"https://html.duckduckgo.com/html/?q="_q
+		+ QString::fromLatin1(QUrl::toPercentEncoding(query))
+		+ u"&kl=ru-ru"_q);
+	fetch(url, kMaxSearchBytes, [=](Fetched fetched) {
+		if (!fetched.error.isEmpty()) {
+			done({
+				.content = u"Search failed: "_q + fetched.error,
+				.title = title,
+				.isError = true,
+			});
+			return;
+		}
+		static const auto links = QRegularExpression(
+			u"<a[^>]*class=\"result__a\"[^>]*href=\"([^\"]+)\"[^>]*>"
+			"(.*?)</a>"_q,
+			QRegularExpression::DotMatchesEverythingOption);
+		static const auto snippets = QRegularExpression(
+			u"class=\"result__snippet\"[^>]*>(.*?)</a>"_q,
+			QRegularExpression::DotMatchesEverythingOption);
+		const auto html = QString::fromUtf8(fetched.body);
+		auto texts = QStringList();
+		auto snippetMatches = snippets.globalMatch(html);
+		while (snippetMatches.hasNext()) {
+			texts.push_back(PlainText(snippetMatches.next().captured(1)));
+		}
+		auto entries = QStringList();
+		auto index = 0;
+		auto linkMatches = links.globalMatch(html);
+		while (linkMatches.hasNext() && (index < kSearchResults)) {
+			const auto match = linkMatches.next();
+			const auto snippet = (index < texts.size())
+				? texts[index]
+				: QString();
+			++index;
+			auto href = DecodeEntities(match.captured(1));
+			if (href.startsWith(u"//"_q)) {
+				href = u"https:"_q + href;
+			}
+			const auto target = QUrlQuery(QUrl(href)).queryItemValue(
+				u"uddg"_q,
+				QUrl::FullyDecoded);
+			if (!target.isEmpty()) {
+				href = target;
+			}
+			if (href.contains(u"duckduckgo.com/y.js"_q)) {
+				continue;
+			}
+			auto entry = u"%1. %2\n%3"_q.arg(
+				QString::number(entries.size() + 1),
+				PlainText(match.captured(2)),
+				href);
+			if (!snippet.isEmpty()) {
+				entry += u"\n"_q + snippet;
+			}
+			entries.push_back(entry);
+		}
+		done({
+			.content = entries.isEmpty()
+				? u"Nothing found for \"%1\"."_q.arg(query)
+				: entries.join(u"\n\n"_q),
+			.title = title,
+		});
+	});
+}
+
+void Tools::webFetch(const QJsonObject &args, Fn<void(ToolOutcome)> done) {
+	const auto url = QUrl(args.value(u"url"_q).toString().trimmed());
+	const auto scheme = url.scheme().toLower();
+	const auto host = url.host();
+	if (!url.isValid()
+		|| host.isEmpty()
+		|| ((scheme != u"http"_q) && (scheme != u"https"_q))) {
+		done(Error(u"An http(s) link is required."_q));
+		return;
+	} else if (IsLocalHost(host)) {
+		done(Error(u"Local addresses can't be opened."_q));
+		return;
+	}
+	const auto title = Tr(u"Read %1"_q).arg(host);
+	fetch(url, kMaxPageBytes, [=](Fetched fetched) {
+		if (!fetched.error.isEmpty()) {
+			done({
+				.content = u"Could not open: "_q + fetched.error,
+				.title = title,
+				.isError = true,
+			});
+			return;
+		}
+		const auto type = fetched.contentType.toLower();
+		auto text = QString();
+		if (type.contains(u"html"_q)
+			|| fetched.body.left(4096).toLower().contains("<html")) {
+			text = HtmlToText(QString::fromUtf8(fetched.body));
+		} else if (type.isEmpty()
+			|| type.startsWith(u"text/"_q)
+			|| type.contains(u"json"_q)
+			|| type.contains(u"xml"_q)) {
+			text = QString::fromUtf8(fetched.body).trimmed();
+		} else {
+			done({
+				.content = u"This is not a text page (%1)."_q.arg(type),
+				.title = title,
+				.isError = true,
+			});
+			return;
+		}
+		if (text.size() > kMaxPageText) {
+			text = text.left(kMaxPageText)
+				+ u"\n"_q
+				+ QChar(0x2026)
+				+ u"truncated."_q;
+		}
+		done({
+			.content = text.isEmpty() ? u"The page is empty."_q : text,
+			.title = title,
+		});
+	});
+}
+
+void Tools::fetch(const QUrl &url, int limit, Fn<void(Fetched)> done) {
+	if (OfflineForLaunch()) {
+		done({ .error = u"mad was started offline."_q });
+		return;
+	}
+	if (!_network) {
+		_network = std::make_unique<QNetworkAccessManager>();
+	}
+	auto request = QNetworkRequest(url);
+	request.setRawHeader(
+		"User-Agent",
+		"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+		"(KHTML, like Gecko) Chrome/131.0 Safari/537.36");
+	request.setRawHeader("Accept-Language", "ru,en;q=0.8");
+	request.setTransferTimeout(kWebTimeout);
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::UserVerifiedRedirectPolicy);
+	struct State {
+		QByteArray body;
+		bool truncated = false;
+		bool blocked = false;
+	};
+	const auto state = std::make_shared<State>();
+	const auto reply = _network->get(request);
+	const auto weak = base::make_weak(this);
+	QObject::connect(reply, &QNetworkReply::redirected, reply, [=](
+			const QUrl &target) {
+		const auto scheme = target.scheme().toLower();
+		if (((scheme == u"http"_q) || (scheme == u"https"_q))
+			&& !IsLocalHost(target.host())) {
+			Q_EMIT reply->redirectAllowed();
+		} else {
+			state->blocked = true;
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::readyRead, reply, [=] {
+		if (state->truncated) {
+			return;
+		}
+		state->body.append(reply->readAll());
+		if (state->body.size() > limit) {
+			state->body.truncate(limit);
+			state->truncated = true;
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		if (!weak) {
+			return;
+		}
+		if (!state->truncated) {
+			state->body.append(reply->readAll());
+		}
+		auto result = Fetched{
+			.body = state->body.left(limit),
+			.contentType = reply->header(
+				QNetworkRequest::ContentTypeHeader).toString(),
+		};
+		if (state->blocked) {
+			result.error = u"It redirects to a local address."_q;
+		} else if (!state->truncated
+			&& (reply->error() != QNetworkReply::NoError)) {
+			result.error = reply->errorString();
+		}
+		done(std::move(result));
+	});
+}
