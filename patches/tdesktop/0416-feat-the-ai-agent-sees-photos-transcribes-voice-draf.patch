+void Tools::draftReply(const QJsonObject &args, Fn<void(ToolOutcome)> done) {
+	const auto peer = PeerFromArgs(_session, args);
+	if (!peer) {
+		done(Error(u"Unknown chat_id."_q));
+		return;
+	}
+	const auto text = args.value(u"text"_q).toString();
+	Core::App().materializeLocalDrafts();
+	Data::SetChatLinkDraft(
+		peer,
+		TextUtilities::ParseEntities(text, TextParseMarkdown));
+	const auto title = Title(peer);
+	done({
+		.content = u"The draft is in the input field of \"%1\". The user "
+			"will send it."_q.arg(title),
+		.title = Tr(u"Drafted a reply in %1"_q).arg(title),
+	});
+}
