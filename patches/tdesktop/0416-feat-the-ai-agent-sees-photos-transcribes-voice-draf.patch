+[[nodiscard]] QString DecodeEntities(const QString &text) {
+	if (!text.contains(QChar('&'))) {
+		return text;
+	}
+	static const auto entity = QRegularExpression(
+		u"&(#[0-9]{1,7}|#[xX][0-9a-fA-F]{1,6}|[a-zA-Z]{2,8});"_q);
+	static const auto named = base::flat_map<QString, QString>{
+		{ u"amp"_q, u"&"_q },
+		{ u"lt"_q, u"<"_q },
+		{ u"gt"_q, u">"_q },
+		{ u"quot"_q, u"\""_q },
+		{ u"apos"_q, u"'"_q },
+		{ u"nbsp"_q, u" "_q },
+		{ u"mdash"_q, QString(QChar(0x2014)) },
+		{ u"ndash"_q, QString(QChar(0x2013)) },
+		{ u"hellip"_q, QString(QChar(0x2026)) },
+		{ u"laquo"_q, QString(QChar(0x00AB)) },
+		{ u"raquo"_q, QString(QChar(0x00BB)) },
+		{ u"copy"_q, QString(QChar(0x00A9)) },
+	};
+	auto result = QString();
+	result.reserve(text.size());
+	auto position = qsizetype(0);
+	auto matches = entity.globalMatch(text);
+	while (matches.hasNext()) {
+		const auto match = matches.next();
+		result.append(text.mid(position, match.capturedStart() - position));
+		const auto name = match.captured(1);
+		auto replacement = QString();
+		if (name.startsWith(QChar('#'))) {
+			const auto hex = (name.size() > 1)
+				&& (name[1] == QChar('x') || name[1] == QChar('X'));
+			auto ok = false;
+			const auto code = hex
+				? name.mid(2).toUInt(&ok, 16)
+				: name.mid(1).toUInt(&ok, 10);
+			if (ok && code > 0 && code <= 0x10FFFF) {
+				if (QChar::requiresSurrogates(code)) {
+					const QChar pair[] = {
+						QChar(QChar::highSurrogate(code)),
+						QChar(QChar::lowSurrogate(code)),
+					};
+					replacement = QString(pair, 2);
+				} else {
+					replacement = QString(QChar(char16_t(code)));
+				}
+			}
+		} else {
+			const auto i = named.find(name.toLower());
+			if (i != end(named)) {
+				replacement = i->second;
+			}
+		}
+		result.append(replacement.isEmpty()
+			? match.captured(0)
+			: replacement);
+		position = match.capturedEnd();
+	}
+	result.append(text.mid(position));
+	return result;
+}
+
+[[nodiscard]] QString PlainText(QString html) {
+	static const auto tags = QRegularExpression(u"<[^>]*>"_q);
+	static const auto spaces = QRegularExpression(u"\\s+"_q);
+	html.replace(tags, u" "_q);
+	auto result = DecodeEntities(html);
+	result.replace(QChar(0x00A0), QChar(' '));
+	result.replace(spaces, u" "_q);
+	return result.trimmed();
+}
+
+[[nodiscard]] QString HtmlToText(QString html) {
+	const auto options = QRegularExpression::CaseInsensitiveOption
+		| QRegularExpression::DotMatchesEverythingOption;
+	static const auto title = QRegularExpression(
+		u"<title[^>]*>(.*?)</title>"_q,
+		options);
+	static const auto hidden = QRegularExpression(
+		u"<(script|style|noscript|svg|head|template)\\b[^>]*>.*?"
+		"</\\1\\s*>"_q,
+		options);
+	static const auto comments = QRegularExpression(
+		u"<!--.*?-->"_q,
+		QRegularExpression::DotMatchesEverythingOption);
+	static const auto breaks = QRegularExpression(
+		u"<br\\s*/?>|</(p|div|li|h[1-6]|tr|ul|ol|table|section|article|"
+		"header|footer|blockquote|pre)\\s*>"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	static const auto tags = QRegularExpression(u"<[^>]*>"_q);
+	static const auto spaces = QRegularExpression(u"[ \\t\\r\\f\\v]+"_q);
+	static const auto edges = QRegularExpression(u" ?\\n ?"_q);
+	static const auto blank = QRegularExpression(u"\\n{3,}"_q);
+	const auto heading = title.match(html);
+	const auto name = heading.hasMatch()
+		? PlainText(heading.captured(1))
+		: QString();
+	html.remove(hidden);
+	html.remove(comments);
+	html.replace(breaks, u"\n"_q);
+	html.replace(tags, u" "_q);
+	html = DecodeEntities(html);
+	html.replace(QChar(0x00A0), QChar(' '));
+	html.replace(spaces, u" "_q);
+	html.replace(edges, u"\n"_q);
+	html.replace(blank, u"\n\n"_q);
+	html = html.trimmed();
+	return name.isEmpty() ? html : (name + u"\n\n"_q + html);
+}
+
+[[nodiscard]] bool IsLocalHost(const QString &host) {
+	const auto lower = host.toLower();
+	if (lower.isEmpty()
+		|| (lower == u"localhost"_q)
+		|| lower.endsWith(u".localhost"_q)
+		|| lower.endsWith(u".local"_q)
+		|| lower.endsWith(u".internal"_q)) {
+		return true;
+	}
+	auto address = QHostAddress();
+	if (!address.setAddress(lower)) {
+		return false;
+	} else if (address.isNull()
+		|| address.isLoopback()
+		|| address.isLinkLocal()) {
+		return true;
+	}
+	for (const auto &subnet : {
+		u"0.0.0.0/8"_q,
+		u"10.0.0.0/8"_q,
+		u"100.64.0.0/10"_q,
+		u"172.16.0.0/12"_q,
+		u"192.168.0.0/16"_q,
+		u"fc00::/7"_q,
+	}) {
+		if (address.isInSubnet(QHostAddress::parseSubnet(subnet))) {
+			return true;
+		}
+	}
+	return false;
+}
