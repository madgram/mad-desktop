+void Tools::transcribeVoice(
+		const QJsonObject &args,
+		Fn<void(ToolOutcome)> done) {
+	const auto peer = PeerFromArgs(_session, args);
+	const auto id = MessageIdFromArgs(args);
+	if (!peer || !id) {
+		done(Error(u"chat_id and message_id are required."_q));
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	const auto session = _session;
+	WithItem(_session, peer, id, [=](HistoryItem *item) {
+		if (!weak) {
+			return;
+		} else if (!item) {
+			done(Error(u"Message not found."_q));
+			return;
+		}
+		const auto media = item->media();
+		const auto document = media ? media->document() : nullptr;
+		if (!document
+			|| !(document->isVoiceMessage() || document->isVideoMessage())) {
+			done(Error(u"This is not a voice or round video message."_q));
+			return;
+		}
+		const auto result = [=](not_null<HistoryItem*> target)
+		-> std::optional<ToolOutcome> {
+			const auto &entry = session->api().transcribes().entry(target);
+			if (entry.failed) {
+				return Error(entry.toolong
+					? u"The message is too long to transcribe."_q
+					: u"Telegram could not transcribe it. Speech recognition "
+						"needs Telegram Premium or a free trial."_q);
+			} else if (entry.requestId || entry.pending) {
+				return std::nullopt;
+			} else if (!entry.result.isEmpty()) {
+				return ToolOutcome{
+					.content = entry.result,
+					.title = Tr(u"Transcribed a voice message"_q),
+				};
+			} else if (entry.shown) {
+				return Error(u"Nothing was recognized in this message."_q);
+			}
+			return std::nullopt;
+		};
+		if (auto ready = result(item)) {
+			done(std::move(*ready));
+			return;
+		}
+		auto &transcribes = session->api().transcribes();
+		const auto &entry = transcribes.entry(item);
+		if (!entry.requestId && !entry.pending) {
+			transcribes.toggle(item);
+			if (!transcribes.entry(item).requestId) {
+				done(Error(u"Telegram can't transcribe this message."_q));
+				return;
+			}
+		}
+		const auto fullId = item->fullId();
+		const auto started = crl::now();
+		const auto wait = _lifetime.make_state<rpl::lifetime>();
+		base::timer_each(kTranscribePoll) | rpl::on_next([=] {
+			const auto current = session->data().message(fullId);
+			auto ready = current
+				? result(current)
+				: std::make_optional(Error(u"Message not found."_q));
+			if (!ready && (crl::now() - started > kTranscribeTimeout)) {
+				ready = Error(u"Telegram did not transcribe it in time."_q);
+			}
+			if (ready) {
+				wait->destroy();
+				done(std::move(*ready));
+			}
+		}, *wait);
+	});
+}
