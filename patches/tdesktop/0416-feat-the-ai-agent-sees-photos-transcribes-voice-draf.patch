+[[nodiscard]] Image EncodePhoto(QImage image) {
+	if (image.isNull()) {
+		return {};
+	}
+	image.setDevicePixelRatio(1.);
+	if (std::max(image.width(), image.height()) > kPhotoSide) {
+		image = image.scaled(
+			kPhotoSide,
+			kPhotoSide,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation);
+	}
+	auto canvas = QImage(image.size(), QImage::Format_RGB32);
+	canvas.fill(Qt::white);
+	{
+		auto p = QPainter(&canvas);
+		p.drawImage(0, 0, image);
+	}
+	auto bytes = QByteArray();
+	auto buffer = QBuffer(&bytes);
+	if (!buffer.open(QIODevice::WriteOnly)
+		|| !canvas.save(&buffer, "JPG", kPhotoQuality)) {
+		return {};
+	}
+	return { u"image/jpeg"_q, QString::fromLatin1(bytes.toBase64()) };
+}
